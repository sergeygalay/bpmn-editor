<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-project-selection-approval-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-project-selection-approval-v083">
  <bpmn:collaboration id="Collab_kgmk-project-selection-approval-v083"><bpmn:participant id="Part_kgmk-project-selection-approval-v083" name="Формирование, согласование и доработка заявки на проекты" processRef="Proc_kgmk-project-selection-approval-v083"/></bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-project-selection-approval-v083" name="Формирование, согласование и доработка заявки на проекты" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-project-selection-approval-v083"><bpmn:lane id="L_Customer" name="Заказчик БЕ (Заказчик подразделения)"><bpmn:flowNodeRef>Browse</bpmn:flowNodeRef><bpmn:flowNodeRef>Add</bpmn:flowNodeRef><bpmn:flowNodeRef>MoreGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Check</bpmn:flowNodeRef><bpmn:flowNodeRef>Submit</bpmn:flowNodeRef><bpmn:flowNodeRef>Discuss</bpmn:flowNodeRef><bpmn:flowNodeRef>CustomerDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>Revise</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_Admin" name="Администратор программы (ГО)"><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>RejectComment</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Магазин проектов / система"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>Access</bpmn:flowNodeRef><bpmn:flowNodeRef>AccessGate</bpmn:flowNodeRef><bpmn:flowNodeRef>ViewEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef><bpmn:flowNodeRef>SelectionMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>ReviewMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>ValidGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Pending</bpmn:flowNodeRef><bpmn:flowNodeRef>Approve</bpmn:flowNodeRef><bpmn:flowNodeRef>Approved</bpmn:flowNodeRef><bpmn:flowNodeRef>SetRework</bpmn:flowNodeRef><bpmn:flowNodeRef>Timeout</bpmn:flowNodeRef><bpmn:flowNodeRef>Close</bpmn:flowNodeRef><bpmn:flowNodeRef>Closed</bpmn:flowNodeRef><bpmn:flowNodeRef>TimeoutRecord</bpmn:flowNodeRef><bpmn:flowNodeRef>TimeoutEnd</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="S" name="Открыт этап «Магазин проектов»"/><bpmn:businessRuleTask id="Access" name="Проверить роль, БЕ и доступность этапа"/><bpmn:exclusiveGateway id="AccessGate" name="Выбор разрешён?"/><bpmn:endEvent id="ViewEnd" name="Только просмотр: выбор недоступен"/><bpmn:serviceTask id="Allowed" name="Сформировать допустимый каталог по уровню БЕ"/><bpmn:exclusiveGateway id="SelectionMerge" name="Продолжить формирование заявки"/><bpmn:userTask id="Browse" name="Просмотреть проекты и карточки"/><bpmn:userTask id="Add" name="Добавить разрешённый проект в заявку"/><bpmn:exclusiveGateway id="MoreGate" name="Добавить ещё проект?"/><bpmn:exclusiveGateway id="ReviewMerge" name="Перейти к проверке заявки"/><bpmn:userTask id="Check" name="Проверить состав заявки"/><bpmn:userTask id="Submit" name="Отправить заявку администратору"/><bpmn:businessRuleTask id="Validate" name="Повторно проверить права, состав и допустимость проектов"/><bpmn:exclusiveGateway id="ValidGate" name="Заявка допустима?"/><bpmn:serviceTask id="Pending" name="Создать заявку со статусом «На одобрении»"/><bpmn:userTask id="Review" name="Рассмотреть проекты заявки"/><bpmn:exclusiveGateway id="Decision" name="Одобрить заявку?"/><bpmn:serviceTask id="Approve" name="Зафиксировать статус «Одобрено»"/><bpmn:endEvent id="Approved" name="Проекты доступны для реализации"/><bpmn:userTask id="RejectComment" name="Отклонить заявку и указать обязательный комментарий"/><bpmn:serviceTask id="SetRework" name="Перевести в «На доработке», запустить тайм-аут и открыть чат/комментарии"/><bpmn:userTask id="Discuss" name="Изучить комментарий, обсудить замечания и принять решение"/><bpmn:boundaryEvent id="Timeout" name="Истёк тайм-аут доработки" attachedToRef="Discuss"><bpmn:timerEventDefinition/></bpmn:boundaryEvent><bpmn:exclusiveGateway id="CustomerDecision" name="Решение Заказчика БЕ?"/><bpmn:userTask id="Revise" name="Доработать заявку"/><bpmn:serviceTask id="Close" name="Закрыть заявку по решению Заказчика БЕ"/><bpmn:endEvent id="Closed" name="Заявка закрыта инициатором"/><bpmn:serviceTask id="TimeoutRecord" name="Зафиксировать истечение тайм-аута доработки"/><bpmn:endEvent id="TimeoutEnd" name="Действие после тайм-аута — определить"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Access"/><bpmn:sequenceFlow id="F2" sourceRef="Access" targetRef="AccessGate"/><bpmn:sequenceFlow id="F3" sourceRef="AccessGate" targetRef="Allowed" name="Да"/><bpmn:sequenceFlow id="F4" sourceRef="AccessGate" targetRef="ViewEnd" name="Нет"/><bpmn:sequenceFlow id="F5" sourceRef="Allowed" targetRef="SelectionMerge"/><bpmn:sequenceFlow id="F6" sourceRef="SelectionMerge" targetRef="Browse"/><bpmn:sequenceFlow id="F7" sourceRef="Browse" targetRef="Add"/><bpmn:sequenceFlow id="F8" sourceRef="Add" targetRef="MoreGate"/><bpmn:sequenceFlow id="F9" sourceRef="MoreGate" targetRef="SelectionMerge" name="Да"/><bpmn:sequenceFlow id="F10" sourceRef="MoreGate" targetRef="ReviewMerge" name="Нет"/><bpmn:sequenceFlow id="F11" sourceRef="ReviewMerge" targetRef="Check"/><bpmn:sequenceFlow id="F12" sourceRef="Check" targetRef="Submit"/><bpmn:sequenceFlow id="F13" sourceRef="Submit" targetRef="Validate"/><bpmn:sequenceFlow id="F14" sourceRef="Validate" targetRef="ValidGate"/><bpmn:sequenceFlow id="F15" sourceRef="ValidGate" targetRef="Pending" name="Да"/><bpmn:sequenceFlow id="F16" sourceRef="ValidGate" targetRef="ReviewMerge" name="Нет — скорректировать"/><bpmn:sequenceFlow id="F17" sourceRef="Pending" targetRef="Review"/><bpmn:sequenceFlow id="F18" sourceRef="Review" targetRef="Decision"/><bpmn:sequenceFlow id="F19" sourceRef="Decision" targetRef="Approve" name="Да"/><bpmn:sequenceFlow id="F20" sourceRef="Approve" targetRef="Approved"/><bpmn:sequenceFlow id="F21" sourceRef="Decision" targetRef="RejectComment" name="Нет"/><bpmn:sequenceFlow id="F22" sourceRef="RejectComment" targetRef="SetRework"/><bpmn:sequenceFlow id="F23" sourceRef="SetRework" targetRef="Discuss"/><bpmn:sequenceFlow id="F24" sourceRef="Discuss" targetRef="CustomerDecision"/><bpmn:sequenceFlow id="F25" sourceRef="CustomerDecision" targetRef="Revise" name="Доработать"/><bpmn:sequenceFlow id="F26" sourceRef="CustomerDecision" targetRef="Close" name="Закрыть"/><bpmn:sequenceFlow id="F27" sourceRef="Revise" targetRef="SelectionMerge" name="Повторная подача"/><bpmn:sequenceFlow id="F28" sourceRef="Close" targetRef="Closed"/><bpmn:sequenceFlow id="F29" sourceRef="Timeout" targetRef="TimeoutRecord"/><bpmn:sequenceFlow id="F30" sourceRef="TimeoutRecord" targetRef="TimeoutEnd"/>
    <bpmn:textAnnotation id="AnnRework"><bpmn:text>Подтверждено заказчиком: комментарий Администратора программы (ГО) при отклонении обязателен. После отклонения заявка находится в статусе «На доработке»; решение о доработке или закрытии принимает Заказчик БЕ. Чат/комментарии используется для обсуждения замечаний. Значение тайм-аута и действие после его истечения — определить.</bpmn:text></bpmn:textAnnotation><bpmn:association id="AssocRework" sourceRef="SetRework" targetRef="AnnRework"/>
  </bpmn:process>
