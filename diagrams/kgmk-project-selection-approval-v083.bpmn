<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_sel083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-project-selection-approval-v083">
<bpmn:collaboration id="Collab_sel083"><bpmn:participant id="Part_sel083" name="Выбор и одобрение проектов подразделения 0.8.3" processRef="Proc_sel083"/></bpmn:collaboration>
<bpmn:process id="Proc_sel083" name="Выбор и одобрение проектов подразделения 0.8.3" isExecutable="false">
<bpmn:laneSet id="LS"><bpmn:lane id="L_ZGD" name="ЗГД ПБиОТ подразделения"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>Browse</bpmn:flowNodeRef><bpmn:flowNodeRef>Add</bpmn:flowNodeRef><bpmn:flowNodeRef>Check</bpmn:flowNodeRef><bpmn:flowNodeRef>Submit</bpmn:flowNodeRef><bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_Admin" name="Администратор программы"><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Approved</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Магазин проектов"><bpmn:flowNodeRef>Access</bpmn:flowNodeRef><bpmn:flowNodeRef>AccessGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>ValidGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Pending</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S" name="Открыт этап магазина проектов"/><bpmn:businessRuleTask id="Access" name="Проверить роль, предприятие и период"/><bpmn:exclusiveGateway id="AccessGate" name="Выбор разрешён?"/><bpmn:serviceTask id="Allowed" name="Сформировать допустимый каталог по уровню"/><bpmn:userTask id="Browse" name="Просмотреть проекты и карточки"/><bpmn:userTask id="Add" name="Добавить разрешённые проекты в заявку"/><bpmn:userTask id="Check" name="Проверить состав заявки"/><bpmn:userTask id="Submit" name="Отправить заявку администратору"/><bpmn:businessRuleTask id="Validate" name="Повторно проверить заявку"/><bpmn:exclusiveGateway id="ValidGate" name="Заявка валидна?"/><bpmn:serviceTask id="Pending" name="Создать заявку со статусом «На одобрении»"/><bpmn:userTask id="Review" name="Рассмотреть выбранные проекты"/><bpmn:exclusiveGateway id="Decision" name="Одобрить заявку?"/><bpmn:endEvent id="Approved" name="Заявка одобрена и доступна для реализации"/><bpmn:endEvent id="Rejected" name="Выбор недоступен / заявка отклонена"/>
<bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Access"/><bpmn:sequenceFlow id="F2" sourceRef="Access" targetRef="AccessGate"/><bpmn:sequenceFlow id="F3" sourceRef="AccessGate" targetRef="Allowed" name="Да"/><bpmn:sequenceFlow id="F4" sourceRef="AccessGate" targetRef="Rejected" name="Нет — только просмотр"/><bpmn:sequenceFlow id="F5" sourceRef="Allowed" targetRef="Browse"/><bpmn:sequenceFlow id="F6" sourceRef="Browse" targetRef="Add"/><bpmn:sequenceFlow id="F7" sourceRef="Add" targetRef="Check"/><bpmn:sequenceFlow id="F8" sourceRef="Check" targetRef="Submit"/><bpmn:sequenceFlow id="F9" sourceRef="Submit" targetRef="Validate"/><bpmn:sequenceFlow id="F10" sourceRef="Validate" targetRef="ValidGate"/><bpmn:sequenceFlow id="F11" sourceRef="ValidGate" targetRef="Pending" name="Да"/><bpmn:sequenceFlow id="F12" sourceRef="ValidGate" targetRef="Check" name="Нет"/><bpmn:sequenceFlow id="F13" sourceRef="Pending" targetRef="Review"/><bpmn:sequenceFlow id="F14" sourceRef="Review" targetRef="Decision"/><bpmn:sequenceFlow id="F15" sourceRef="Decision" targetRef="Approved" name="Да"/><bpmn:sequenceFlow id="F16" sourceRef="Decision" targetRef="Rejected" name="Нет"/>
<bpmn:textAnnotation id="Ann"><bpmn:text>Причина отклонения заявки в версии 0.8.3 не запрашивается и не хранится как обязательное бизнес-поле.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc" sourceRef="Decision" targetRef="Ann"/>
</bpmn:process>
