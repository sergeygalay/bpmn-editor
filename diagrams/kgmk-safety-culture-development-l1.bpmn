<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L1" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-safety-culture-development-l1">
  <bpmn:collaboration id="Collab_L1"><bpmn:participant id="Part_L1" name="Управление развитием культуры безопасности БЕ" processRef="Proc_L1"/></bpmn:collaboration>
  <bpmn:process id="Proc_L1" name="Управление развитием культуры безопасности БЕ — бизнес-процесс L1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_L1">
      <bpmn:lane id="L_Assess" name="Функция оценки культуры"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>Assess</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Business" name="Представитель БЕ / владелец программы развития"><bpmn:flowNodeRef>Analyze</bpmn:flowNodeRef><bpmn:flowNodeRef>Form</bpmn:flowNodeRef><bpmn:flowNodeRef>Revise</bpmn:flowNodeRef><bpmn:flowNodeRef>Evaluate</bpmn:flowNodeRef><bpmn:flowNodeRef>Target</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_System" name="Магазин проектов / система"><bpmn:flowNodeRef>FixLevel</bpmn:flowNodeRef><bpmn:flowNodeRef>LevelOK</bpmn:flowNodeRef><bpmn:flowNodeRef>Scope</bpmn:flowNodeRef><bpmn:flowNodeRef>Fit</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Approve" name="Согласующая функция (роль требует подтверждения)"><bpmn:flowNodeRef>Approve</bpmn:flowNodeRef><bpmn:flowNodeRef>Approved</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Owners" name="Владельцы инициатив"><bpmn:flowNodeRef>Plan</bpmn:flowNodeRef><bpmn:flowNodeRef>Implement</bpmn:flowNodeRef><bpmn:flowNodeRef>Success</bpmn:flowNodeRef><bpmn:flowNodeRef>Adjust</bpmn:flowNodeRef><bpmn:flowNodeRef>NoLevel</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Наступил очередной цикл развития культуры безопасности"/>
    <bpmn:userTask id="Assess" name="Провести оценку культуры безопасности БЕ"/>
    <bpmn:userTask id="Confirm" name="Подтвердить результат оценки"/>
    <bpmn:serviceTask id="FixLevel" name="Зафиксировать официальный уровень культуры БЕ"/>
    <bpmn:exclusiveGateway id="LevelOK" name="Уровень культуры зафиксирован?"/>
    <bpmn:serviceTask id="Scope" name="Определить следующий уровень и допустимые инициативы"/>
    <bpmn:userTask id="Analyze" name="Оценить потребности БЕ и выбрать инициативы развития"/>
    <bpmn:exclusiveGateway id="Fit" name="Выбранные инициативы соответствуют уровню БЕ?"/>
    <bpmn:userTask id="Form" name="Сформировать программу развития БЕ"/>
    <bpmn:userTask id="Approve" name="Рассмотреть программу развития"/>
    <bpmn:exclusiveGateway id="Approved" name="Программа согласована?"/>
    <bpmn:userTask id="Revise" name="Доработать состав программы"/>
    <bpmn:userTask id="Plan" name="Спланировать реализацию утверждённых инициатив"/>
    <bpmn:userTask id="Implement" name="Реализовать инициативы"/>
    <bpmn:userTask id="Evaluate" name="Оценить результат реализации и изменение культуры"/>
    <bpmn:exclusiveGateway id="Target" name="Цель цикла достигнута?"/>
    <bpmn:endEvent id="Success" name="Программа реализована; результат принят"/>
    <bpmn:endEvent id="Adjust" name="Требуется корректировка программы / следующий цикл"/>
    <bpmn:endEvent id="NoLevel" name="Программа не формируется: нет подтверждённого уровня"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="Assess"/><bpmn:sequenceFlow id="F2" sourceRef="Assess" targetRef="Confirm"/><bpmn:sequenceFlow id="F3" sourceRef="Confirm" targetRef="FixLevel"/><bpmn:sequenceFlow id="F4" sourceRef="FixLevel" targetRef="LevelOK"/><bpmn:sequenceFlow id="F5" sourceRef="LevelOK" targetRef="Scope" name="Да"/><bpmn:sequenceFlow id="F6" sourceRef="LevelOK" targetRef="NoLevel" name="Нет"/><bpmn:sequenceFlow id="F7" sourceRef="Scope" targetRef="Analyze"/><bpmn:sequenceFlow id="F8" sourceRef="Analyze" targetRef="Fit"/><bpmn:sequenceFlow id="F9" sourceRef="Fit" targetRef="Form" name="Да"/><bpmn:sequenceFlow id="F10" sourceRef="Fit" targetRef="Analyze" name="Нет — пересмотреть выбор"/><bpmn:sequenceFlow id="F11" sourceRef="Form" targetRef="Approve"/><bpmn:sequenceFlow id="F12" sourceRef="Approve" targetRef="Approved"/><bpmn:sequenceFlow id="F13" sourceRef="Approved" targetRef="Plan" name="Да"/><bpmn:sequenceFlow id="F14" sourceRef="Approved" targetRef="Revise" name="Нет"/><bpmn:sequenceFlow id="F15" sourceRef="Revise" targetRef="Form"/><bpmn:sequenceFlow id="F16" sourceRef="Plan" targetRef="Implement"/><bpmn:sequenceFlow id="F17" sourceRef="Implement" targetRef="Evaluate"/><bpmn:sequenceFlow id="F18" sourceRef="Evaluate" targetRef="Target"/><bpmn:sequenceFlow id="F19" sourceRef="Target" targetRef="Success" name="Да"/><bpmn:sequenceFlow id="F20" sourceRef="Target" targetRef="Adjust" name="Нет"/>
    <bpmn:textAnnotation id="AnnHyp"><bpmn:text>Согласование программы, роли владельцев инициатив и контроль реализации — аналитическая гипотеза верхнего уровня. Прототип подтверждает связь уровня культуры с доступным набором инициатив и выбор инициатив ответственным БЕ.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_AnnHyp" sourceRef="Approve" targetRef="AnnHyp"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L1"><bpmndi:BPMNPlane id="Plane_L1" bpmnElement="Collab_L1">
    <bpmndi:BPMNShape id="Part_L1_di" bpmnElement="Part_L1" isHorizontal="true"><dc:Bounds x="30" y="40" width="3660" height="920"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Assess_di" bpmnElement="L_Assess" isHorizontal="true"><dc:Bounds x="60" y="40" width="3500" height="150"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_Business_di" bpmnElement="L_Business" isHorizontal="true"><dc:Bounds x="60" y="190" width="3500" height="170"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_System_di" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="60" y="360" width="3500" height="160"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_Approve_di" bpmnElement="L_Approve" isHorizontal="true"><dc:Bounds x="60" y="520" width="3500" height="150"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_Owners_di" bpmnElement="L_Owners" isHorizontal="true"><dc:Bounds x="60" y="670" width="3500" height="170"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="100" y="95" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Assess_di" bpmnElement="Assess"><dc:Bounds x="190" y="75" width="180" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Confirm_di" bpmnElement="Confirm"><dc:Bounds x="420" y="75" width="190" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="FixLevel_di" bpmnElement="FixLevel"><dc:Bounds x="670" y="400" width="200" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LevelOK_di" bpmnElement="LevelOK" isMarkerVisible="true"><dc:Bounds x="920" y="415" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="NoLevel_di" bpmnElement="NoLevel"><dc:Bounds x="1030" y="725" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Scope_di" bpmnElement="Scope"><dc:Bounds x="1030" y="390" width="230" height="100"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Analyze_di" bpmnElement="Analyze"><dc:Bounds x="1320" y="235" width="220" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Fit_di" bpmnElement="Fit" isMarkerVisible="true"><dc:Bounds x="1590" y="415" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Form_di" bpmnElement="Form"><dc:Bounds x="1710" y="230" width="220" height="100"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Approve_di" bpmnElement="Approve"><dc:Bounds x="2000" y="555" width="210" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Approved_di" bpmnElement="Approved" isMarkerVisible="true"><dc:Bounds x="2260" y="575" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Revise_di" bpmnElement="Revise"><dc:Bounds x="2370" y="235" width="190" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Plan_di" bpmnElement="Plan"><dc:Bounds x="2370" y="710" width="220" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Implement_di" bpmnElement="Implement"><dc:Bounds x="2640" y="710" width="190" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Evaluate_di" bpmnElement="Evaluate"><dc:Bounds x="2890" y="235" width="220" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Target_di" bpmnElement="Target" isMarkerVisible="true"><dc:Bounds x="3170" y="255" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Success_di" bpmnElement="Success"><dc:Bounds x="3330" y="732" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Adjust_di" bpmnElement="Adjust"><dc:Bounds x="3330" y="265" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AnnHyp_di" bpmnElement="AnnHyp"><dc:Bounds x="1940" y="675" width="360" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="113"/><di:waypoint x="190" y="115"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="370" y="115"/><di:waypoint x="420" y="115"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="610" y="115"/><di:waypoint x="770" y="400"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="870" y="440"/><di:waypoint x="920" y="440"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="970" y="440"/><di:waypoint x="1030" y="440"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="945" y="465"/><di:waypoint x="1048" y="725"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1260" y="440"/><di:waypoint x="1320" y="280"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1540" y="280"/><di:waypoint x="1590" y="440"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1640" y="440"/><di:waypoint x="1710" y="280"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1615" y="415"/><di:waypoint x="1430" y="325"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1930" y="280"/><di:waypoint x="2000" y="600"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="2210" y="600"/><di:waypoint x="2260" y="600"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="2310" y="600"/><di:waypoint x="2370" y="750"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F14_di" bpmnElement="F14"><di:waypoint x="2285" y="575"/><di:waypoint x="2370" y="280"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F15_di" bpmnElement="F15"><di:waypoint x="2370" y="280"/><di:waypoint x="1930" y="280"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F16_di" bpmnElement="F16"><di:waypoint x="2590" y="750"/><di:waypoint x="2640" y="750"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F17_di" bpmnElement="F17"><di:waypoint x="2830" y="750"/><di:waypoint x="2890" y="280"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F18_di" bpmnElement="F18"><di:waypoint x="3110" y="280"/><di:waypoint x="3170" y="280"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F19_di" bpmnElement="F19"><di:waypoint x="3220" y="280"/><di:waypoint x="3330" y="750"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F20_di" bpmnElement="F20"><di:waypoint x="3220" y="280"/><di:waypoint x="3330" y="283"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Assoc_AnnHyp_di" bpmnElement="Assoc_AnnHyp"><di:waypoint x="2105" y="645"/><di:waypoint x="2120" y="675"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>