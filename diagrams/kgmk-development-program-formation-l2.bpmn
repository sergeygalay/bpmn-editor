<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_L2" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-development-program-formation-l2">
  <bpmn:collaboration id="Collab_L2"><bpmn:participant id="Part_L2" name="Формирование программы развития культуры безопасности БЕ" processRef="Proc_L2"/></bpmn:collaboration>
  <bpmn:process id="Proc_L2" name="Формирование программы развития культуры безопасности БЕ — бизнес-процесс L2" isExecutable="false">
    <bpmn:laneSet id="LaneSet_L2">
      <bpmn:lane id="L_Biz2" name="Представитель БЕ / ответственный за формирование программы"><bpmn:flowNodeRef>Start2</bpmn:flowNodeRef><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Select</bpmn:flowNodeRef><bpmn:flowNodeRef>AdjustSel</bpmn:flowNodeRef><bpmn:flowNodeRef>Submit</bpmn:flowNodeRef><bpmn:flowNodeRef>Rework</bpmn:flowNodeRef><bpmn:flowNodeRef>NoWindow</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Sys2" name="Магазин проектов / система"><bpmn:flowNodeRef>Load</bpmn:flowNodeRef><bpmn:flowNodeRef>Level2</bpmn:flowNodeRef><bpmn:flowNodeRef>Window</bpmn:flowNodeRef><bpmn:flowNodeRef>Offer</bpmn:flowNodeRef><bpmn:flowNodeRef>Allowed</bpmn:flowNodeRef><bpmn:flowNodeRef>Valid</bpmn:flowNodeRef><bpmn:flowNodeRef>Register</bpmn:flowNodeRef><bpmn:flowNodeRef>NoLevel2</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_App2" name="Согласующая функция (роль требует подтверждения)"><bpmn:flowNodeRef>BizReview</bpmn:flowNodeRef><bpmn:flowNodeRef>BizOK</bpmn:flowNodeRef><bpmn:flowNodeRef>EndOK</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start2" name="Необходимо сформировать программу развития БЕ"/>
    <bpmn:serviceTask id="Load" name="Получить официальный уровень БЕ и параметры кампании"/>
    <bpmn:exclusiveGateway id="Level2" name="Официальный уровень БЕ определён?"/>
    <bpmn:exclusiveGateway id="Window" name="Период формирования программы открыт?"/>
    <bpmn:serviceTask id="Offer" name="Сформировать допустимый набор инициатив для текущего и следующего уровня"/>
    <bpmn:userTask id="Review" name="Оценить ситуацию БЕ и приоритетные направления развития"/>
    <bpmn:userTask id="Select" name="Выбрать инициативы для программы развития"/>
    <bpmn:exclusiveGateway id="Allowed" name="Все выбранные инициативы допустимы для уровня БЕ?"/>
    <bpmn:userTask id="AdjustSel" name="Скорректировать набор инициатив"/>
    <bpmn:userTask id="Submit" name="Зафиксировать предлагаемый состав программы"/>
    <bpmn:exclusiveGateway id="Valid" name="Программа непустая и соответствует правилам?"/>
    <bpmn:serviceTask id="Register" name="Зарегистрировать программу / заявку на инициативы"/>
    <bpmn:userTask id="BizReview" name="Проверить состав программы с точки зрения бизнеса"/>
    <bpmn:exclusiveGateway id="BizOK" name="Программа принята?"/>
    <bpmn:userTask id="Rework" name="Доработать программу по замечаниям"/>
    <bpmn:endEvent id="EndOK" name="Программа сформирована и готова к реализации"/>
    <bpmn:endEvent id="NoLevel2" name="Формирование невозможно: нет официального уровня"/>
    <bpmn:endEvent id="NoWindow" name="Формирование не выполняется: период закрыт"/>
    <bpmn:sequenceFlow id="G1" sourceRef="Start2" targetRef="Load"/><bpmn:sequenceFlow id="G2" sourceRef="Load" targetRef="Level2"/><bpmn:sequenceFlow id="G3" sourceRef="Level2" targetRef="Window" name="Да"/><bpmn:sequenceFlow id="G4" sourceRef="Level2" targetRef="NoLevel2" name="Нет"/><bpmn:sequenceFlow id="G5" sourceRef="Window" targetRef="Offer" name="Да"/><bpmn:sequenceFlow id="G6" sourceRef="Window" targetRef="NoWindow" name="Нет"/><bpmn:sequenceFlow id="G7" sourceRef="Offer" targetRef="Review"/><bpmn:sequenceFlow id="G8" sourceRef="Review" targetRef="Select"/><bpmn:sequenceFlow id="G9" sourceRef="Select" targetRef="Allowed"/><bpmn:sequenceFlow id="G10" sourceRef="Allowed" targetRef="Submit" name="Да"/><bpmn:sequenceFlow id="G11" sourceRef="Allowed" targetRef="AdjustSel" name="Нет"/><bpmn:sequenceFlow id="G12" sourceRef="AdjustSel" targetRef="Select"/><bpmn:sequenceFlow id="G13" sourceRef="Submit" targetRef="Valid"/><bpmn:sequenceFlow id="G14" sourceRef="Valid" targetRef="Register" name="Да"/><bpmn:sequenceFlow id="G15" sourceRef="Valid" targetRef="AdjustSel" name="Нет"/><bpmn:sequenceFlow id="G16" sourceRef="Register" targetRef="BizReview"/><bpmn:sequenceFlow id="G17" sourceRef="BizReview" targetRef="BizOK"/><bpmn:sequenceFlow id="G18" sourceRef="BizOK" targetRef="EndOK" name="Да"/><bpmn:sequenceFlow id="G19" sourceRef="BizOK" targetRef="Rework" name="Нет"/><bpmn:sequenceFlow id="G20" sourceRef="Rework" targetRef="Select"/>
    <bpmn:textAnnotation id="AnnConfirmed"><bpmn:text>Подтверждено прототипом: допустимый набор зависит от зафиксированного уровня культуры БЕ и включает инициативы текущего уровня и перехода на следующий.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_AnnConfirmed" sourceRef="Offer" targetRef="AnnConfirmed"/>
    <bpmn:textAnnotation id="AnnHyp2"><bpmn:text>Этап бизнес-согласования и конкретный согласующий не описаны прототипом. Добавлены как аналитическая гипотеза и требуют подтверждения заказчиком.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc_AnnHyp2" sourceRef="BizReview" targetRef="AnnHyp2"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_L2"><bpmndi:BPMNPlane id="Plane_L2" bpmnElement="Collab_L2">
    <bpmndi:BPMNShape id="Part_L2_di" bpmnElement="Part_L2" isHorizontal="true"><dc:Bounds x="30" y="40" width="3560" height="670"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="L_Biz2_di" bpmnElement="L_Biz2" isHorizontal="true"><dc:Bounds x="60" y="40" width="3400" height="180"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_Sys2_di" bpmnElement="L_Sys2" isHorizontal="true"><dc:Bounds x="60" y="220" width="3400" height="190"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_App2_di" bpmnElement="L_App2" isHorizontal="true"><dc:Bounds x="60" y="410" width="3400" height="180"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Start2_di" bpmnElement="Start2"><dc:Bounds x="100" y="110" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Load_di" bpmnElement="Load"><dc:Bounds x="190" y="270" width="220" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Level2_di" bpmnElement="Level2" isMarkerVisible="true"><dc:Bounds x="460" y="290" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Window_di" bpmnElement="Window" isMarkerVisible="true"><dc:Bounds x="570" y="290" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="NoLevel2_di" bpmnElement="NoLevel2"><dc:Bounds x="570" y="345" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="NoWindow_di" bpmnElement="NoWindow"><dc:Bounds x="700" y="145" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Offer_di" bpmnElement="Offer"><dc:Bounds x="700" y="255" width="250" height="100"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Review_di" bpmnElement="Review"><dc:Bounds x="1010" y="80" width="230" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Select_di" bpmnElement="Select"><dc:Bounds x="1300" y="80" width="230" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Allowed_di" bpmnElement="Allowed" isMarkerVisible="true"><dc:Bounds x="1580" y="290" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AdjustSel_di" bpmnElement="AdjustSel"><dc:Bounds x="1690" y="80" width="210" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Submit_di" bpmnElement="Submit"><dc:Bounds x="1960" y="80" width="230" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Valid_di" bpmnElement="Valid" isMarkerVisible="true"><dc:Bounds x="2240" y="290" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Register_di" bpmnElement="Register"><dc:Bounds x="2350" y="260" width="220" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BizReview_di" bpmnElement="BizReview"><dc:Bounds x="2630" y="455" width="220" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="BizOK_di" bpmnElement="BizOK" isMarkerVisible="true"><dc:Bounds x="2900" y="475" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Rework_di" bpmnElement="Rework"><dc:Bounds x="3020" y="80" width="190" height="90"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="EndOK_di" bpmnElement="EndOK"><dc:Bounds x="3260" y="482" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AnnConfirmed_di" bpmnElement="AnnConfirmed"><dc:Bounds x="930" y="250" width="310" height="95"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AnnHyp2_di" bpmnElement="AnnHyp2"><dc:Bounds x="2520" y="500" width="340" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="G1_di" bpmnElement="G1"><di:waypoint x="136" y="128"/><di:waypoint x="190" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G2_di" bpmnElement="G2"><di:waypoint x="410" y="315"/><di:waypoint x="460" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G3_di" bpmnElement="G3"><di:waypoint x="510" y="315"/><di:waypoint x="570" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G4_di" bpmnElement="G4"><di:waypoint x="485" y="340"/><di:waypoint x="588" y="345"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G5_di" bpmnElement="G5"><di:waypoint x="620" y="315"/><di:waypoint x="700" y="305"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G6_di" bpmnElement="G6"><di:waypoint x="595" y="290"/><di:waypoint x="718" y="181"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G7_di" bpmnElement="G7"><di:waypoint x="950" y="305"/><di:waypoint x="1010" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G8_di" bpmnElement="G8"><di:waypoint x="1240" y="125"/><di:waypoint x="1300" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G9_di" bpmnElement="G9"><di:waypoint x="1530" y="125"/><di:waypoint x="1580" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G10_di" bpmnElement="G10"><di:waypoint x="1630" y="315"/><di:waypoint x="1960" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G11_di" bpmnElement="G11"><di:waypoint x="1605" y="290"/><di:waypoint x="1690" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G12_di" bpmnElement="G12"><di:waypoint x="1690" y="125"/><di:waypoint x="1530" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G13_di" bpmnElement="G13"><di:waypoint x="2190" y="125"/><di:waypoint x="2240" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G14_di" bpmnElement="G14"><di:waypoint x="2290" y="315"/><di:waypoint x="2350" y="305"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G15_di" bpmnElement="G15"><di:waypoint x="2265" y="290"/><di:waypoint x="1900" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G16_di" bpmnElement="G16"><di:waypoint x="2570" y="305"/><di:waypoint x="2630" y="500"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G17_di" bpmnElement="G17"><di:waypoint x="2850" y="500"/><di:waypoint x="2900" y="500"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G18_di" bpmnElement="G18"><di:waypoint x="2950" y="500"/><di:waypoint x="3260" y="500"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G19_di" bpmnElement="G19"><di:waypoint x="2925" y="475"/><di:waypoint x="3020" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="G20_di" bpmnElement="G20"><di:waypoint x="3020" y="125"/><di:waypoint x="1530" y="125"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Assoc_AnnConfirmed_di" bpmnElement="Assoc_AnnConfirmed"><di:waypoint x="825" y="305"/><di:waypoint x="930" y="297"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Assoc_AnnHyp2_di" bpmnElement="Assoc_AnnHyp2"><di:waypoint x="2740" y="545"/><di:waypoint x="2690" y="500"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>