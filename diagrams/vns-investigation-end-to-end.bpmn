<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EndToEnd" targetNamespace="https://sergeygalay.github.io/bpmn-editor/vns-investigation-end-to-end">
  <bpmn:collaboration id="Collaboration_EndToEnd">
    <bpmn:participant id="Participant_EndToEnd" name="ИИ-помощник расследования — сквозной TO-BE" processRef="Process_EndToEnd"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_EndToEnd" name="Сквозной процесс расследования с ИИ-помощником" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EndToEnd">
      <bpmn:lane id="Lane_Inspector" name="Инспектор"><bpmn:flowNodeRef>StartEvent_Case</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CreateCase</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmPlan</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Upload</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_FactsMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidateFacts</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InitialHyp</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CollectMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CollectMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ResultDraftMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ReworkMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReworkReport</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AI" name="ИИ-помощник"><bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Facts</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AI_Hyp</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProcessMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RCA</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Actions</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DraftReport</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RecordMetrics</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Commission" name="Комиссия по расследованию"><bpmn:flowNodeRef>Task_CommissionReviewHyp</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NeedMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmCauses</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CausesConfirmed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmActions</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CommissionReviewReport</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CommissionApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AdditionalInvestigation</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Утверждающая сторона"><bpmn:flowNodeRef>Task_AcceptReport</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ReportAccepted</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ReturnType</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Accepted</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Case" name="Решение о расследовании принято, комиссия сформирована"/>
    <bpmn:userTask id="Task_CreateCase" name="Создать дело / запустить M-01 и M-02"/>
    <bpmn:serviceTask id="Task_Plan" name="Предложить план и перечень материалов"/>
    <bpmn:userTask id="Task_ConfirmPlan" name="Уточнить и подтвердить план"/>
    <bpmn:userTask id="Task_Upload" name="Загрузить материалы"/>
    <bpmn:serviceTask id="Task_Facts" name="Извлечь факты и построить временную шкалу"/>
    <bpmn:exclusiveGateway id="Gateway_FactsMerge" gatewayDirection="Converging"/>
    <bpmn:userTask id="Task_ValidateFacts" name="Подтвердить / отклонить / уточнить факты"/>
    <bpmn:userTask id="Task_InitialHyp" name="Зафиксировать / уточнить гипотезы человека"/>
    <bpmn:serviceTask id="Task_AI_Hyp" name="Предложить дополнительные гипотезы ИИ"/>
    <bpmn:userTask id="Task_CommissionReviewHyp" name="Проверить гипотезы относительно фактов"/>
    <bpmn:exclusiveGateway id="Gateway_NeedMore" name="Доказательств достаточно?" gatewayDirection="Diverging"/>
    <bpmn:exclusiveGateway id="Gateway_CollectMerge" gatewayDirection="Converging"/>
    <bpmn:userTask id="Task_CollectMore" name="Дособрать / уточнить материалы"/>
    <bpmn:serviceTask id="Task_ProcessMore" name="Повторно проанализировать новые материалы"/>
    <bpmn:serviceTask id="Task_RCA" name="Предложить причинную цепочку RCA"/>
    <bpmn:userTask id="Task_ConfirmCauses" name="Подтвердить причины"/>
    <bpmn:exclusiveGateway id="Gateway_CausesConfirmed" name="Причины подтверждены?" gatewayDirection="Diverging"/>
    <bpmn:serviceTask id="Task_Actions" name="Предложить корректирующие мероприятия"/>
    <bpmn:userTask id="Task_ConfirmActions" name="Подтвердить мероприятия, ответственных и сроки"/>
    <bpmn:exclusiveGateway id="Gateway_ResultDraftMerge" gatewayDirection="Converging"/>
    <bpmn:serviceTask id="Task_DraftReport" name="Сформировать проект комплекта результатов"/>
    <bpmn:userTask id="Task_CommissionReviewReport" name="Рассмотреть и согласовать материалы"/>
    <bpmn:exclusiveGateway id="Gateway_CommissionApproved" name="Материалы готовы к утверждению?" gatewayDirection="Diverging"/>
    <bpmn:exclusiveGateway id="Gateway_ReworkMerge" gatewayDirection="Converging"/>
    <bpmn:userTask id="Task_ReworkReport" name="Доработать итоговые материалы"/>
    <bpmn:userTask id="Task_AcceptReport" name="Рассмотреть результаты расследования"/>
    <bpmn:exclusiveGateway id="Gateway_ReportAccepted" name="Результаты утверждены?" gatewayDirection="Diverging"/>
    <bpmn:exclusiveGateway id="Gateway_ReturnType" name="Требуется дополнительное расследование?" gatewayDirection="Diverging"/>
    <bpmn:userTask id="Task_AdditionalInvestigation" name="Инициировать дополнительное расследование по корпоративному процессу"/>
    <bpmn:serviceTask id="Task_RecordMetrics" name="Зафиксировать M-01, M-02 и рассчитать M-03"/>
    <bpmn:endEvent id="EndEvent_Accepted" name="Результаты расследования утверждены"/>
    <bpmn:textAnnotation id="Annotation_M03"><bpmn:text>Для измерения M-03 первоначальные гипотезы человека фиксируются до показа дополнительных гипотез ИИ.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_M03" sourceRef="Task_InitialHyp" targetRef="Annotation_M03"/>
    <bpmn:sequenceFlow id="F1" sourceRef="StartEvent_Case" targetRef="Task_CreateCase"/>
    <bpmn:sequenceFlow id="F2" sourceRef="Task_CreateCase" targetRef="Task_Plan"/>
    <bpmn:sequenceFlow id="F3" sourceRef="Task_Plan" targetRef="Task_ConfirmPlan"/>
    <bpmn:sequenceFlow id="F4" sourceRef="Task_ConfirmPlan" targetRef="Task_Upload"/>
    <bpmn:sequenceFlow id="F5" sourceRef="Task_Upload" targetRef="Task_Facts"/>
    <bpmn:sequenceFlow id="F6" sourceRef="Task_Facts" targetRef="Gateway_FactsMerge"/>
    <bpmn:sequenceFlow id="F7" sourceRef="Gateway_FactsMerge" targetRef="Task_ValidateFacts"/>
    <bpmn:sequenceFlow id="F8" sourceRef="Task_ValidateFacts" targetRef="Task_InitialHyp"/>
    <bpmn:sequenceFlow id="F9" sourceRef="Task_InitialHyp" targetRef="Task_AI_Hyp"/>
    <bpmn:sequenceFlow id="F10" sourceRef="Task_AI_Hyp" targetRef="Task_CommissionReviewHyp"/>
    <bpmn:sequenceFlow id="F11" sourceRef="Task_CommissionReviewHyp" targetRef="Gateway_NeedMore"/>
    <bpmn:sequenceFlow id="F12" sourceRef="Gateway_NeedMore" targetRef="Gateway_CollectMerge" name="Нет"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Gateway_CollectMerge" targetRef="Task_CollectMore"/>
    <bpmn:sequenceFlow id="F14" sourceRef="Task_CollectMore" targetRef="Task_ProcessMore"/>
    <bpmn:sequenceFlow id="F15" sourceRef="Task_ProcessMore" targetRef="Gateway_FactsMerge" name="Повторно"/>
    <bpmn:sequenceFlow id="F16" sourceRef="Gateway_NeedMore" targetRef="Task_RCA" name="Да"/>
    <bpmn:sequenceFlow id="F17" sourceRef="Task_RCA" targetRef="Task_ConfirmCauses"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Task_ConfirmCauses" targetRef="Gateway_CausesConfirmed"/>
    <bpmn:sequenceFlow id="F19" sourceRef="Gateway_CausesConfirmed" targetRef="Gateway_CollectMerge" name="Нет"/>
    <bpmn:sequenceFlow id="F20" sourceRef="Gateway_CausesConfirmed" targetRef="Task_Actions" name="Да"/>
    <bpmn:sequenceFlow id="F21" sourceRef="Task_Actions" targetRef="Task_ConfirmActions"/>
    <bpmn:sequenceFlow id="F22" sourceRef="Task_ConfirmActions" targetRef="Gateway_ResultDraftMerge"/>
    <bpmn:sequenceFlow id="F23" sourceRef="Gateway_ResultDraftMerge" targetRef="Task_DraftReport"/>
    <bpmn:sequenceFlow id="F24" sourceRef="Task_DraftReport" targetRef="Task_CommissionReviewReport"/>
    <bpmn:sequenceFlow id="F25" sourceRef="Task_CommissionReviewReport" targetRef="Gateway_CommissionApproved"/>
    <bpmn:sequenceFlow id="F26" sourceRef="Gateway_CommissionApproved" targetRef="Task_AcceptReport" name="Да"/>
    <bpmn:sequenceFlow id="F27" sourceRef="Gateway_CommissionApproved" targetRef="Gateway_ReworkMerge" name="Нет"/>
    <bpmn:sequenceFlow id="F28" sourceRef="Gateway_ReworkMerge" targetRef="Task_ReworkReport"/>
    <bpmn:sequenceFlow id="F29" sourceRef="Task_ReworkReport" targetRef="Gateway_ResultDraftMerge" name="Повторно"/>
    <bpmn:sequenceFlow id="F30" sourceRef="Task_AcceptReport" targetRef="Gateway_ReportAccepted"/>
    <bpmn:sequenceFlow id="F31" sourceRef="Gateway_ReportAccepted" targetRef="Task_RecordMetrics" name="Да"/>
    <bpmn:sequenceFlow id="F32" sourceRef="Task_RecordMetrics" targetRef="EndEvent_Accepted"/>
    <bpmn:sequenceFlow id="F33" sourceRef="Gateway_ReportAccepted" targetRef="Gateway_ReturnType" name="Нет"/>
    <bpmn:sequenceFlow id="F34" sourceRef="Gateway_ReturnType" targetRef="Task_AdditionalInvestigation" name="Да"/>
    <bpmn:sequenceFlow id="F35" sourceRef="Task_AdditionalInvestigation" targetRef="Gateway_CollectMerge"/>
    <bpmn:sequenceFlow id="F36" sourceRef="Gateway_ReturnType" targetRef="Gateway_ReworkMerge" name="Нет, только доработка"/>
  </bpmn:process>
