<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_EndToEnd" targetNamespace="https://sergeygalay.github.io/bpmn-editor/vns-investigation-end-to-end">
  <bpmn:collaboration id="Collaboration_EndToEnd"><bpmn:participant id="Participant_EndToEnd" name="ИИ-помощник расследования: от создания дела до принятия итогового отчета" processRef="Process_EndToEnd"/></bpmn:collaboration>
  <bpmn:process id="Process_EndToEnd" isExecutable="false">
    <bpmn:laneSet id="LaneSet_EndToEnd">
      <bpmn:lane id="Lane_Chair" name="Председатель комиссии"><bpmn:flowNodeRef>Task_ConfirmPlan</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NeedMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DecideMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmCauses</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_CausesConfirmed</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ConfirmActions</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ApproveReport</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Commission" name="Члены комиссии"><bpmn:flowNodeRef>StartEvent_Case</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CreateCase</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Upload</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidateFacts</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InitialHyp</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CollectMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidateNew</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ClarifyAnalysis</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RefineActions</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviewReport</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReworkReport</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_AI" name="ИИ-помощник"><bpmn:flowNodeRef>Task_Plan</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Facts</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_AI_Hyp</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeAnalysis</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CheckHyp</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProcessMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RCA</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Actions</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeReport</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_DraftReport</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="Lane_Approver" name="Уполномоченное лицо — роль TBD"><bpmn:flowNodeRef>Task_AcceptReport</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_ReportAccepted</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeRework</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Accepted</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Case" name="Дело создано / старт M-01, M-02"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_CreateCase" name="Создать дело и зафиксировать исходные данные"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Plan" name="Предложить план расследования и перечень материалов"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ConfirmPlan" name="Подтвердить / уточнить план"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_Upload" name="Загрузить материалы"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Facts" name="Извлечь кандидатные факты и построить временную шкалу"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ValidateFacts" name="Подтвердить / отклонить / уточнить факты"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_InitialHyp" name="Зафиксировать первоначальные гипотезы комиссии"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_AI_Hyp" name="Предложить дополнительные гипотезы ИИ"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeAnalysis" gatewayDirection="Converging"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:incoming>Flow_20</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_CheckHyp" name="Сопоставить гипотезы с фактами; выявить противоречия и пробелы"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_NeedMore" name="Нужен досбор?" gatewayDirection="Diverging"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DecideMore" name="Принять решение о досборе"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_CollectMore" name="Дособрать материалы"><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_ProcessMore" name="Обработать новые материалы и обновить факты / шкалу"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15a</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ValidateNew" name="Подтвердить новые / измененные факты"><bpmn:incoming>Flow_15a</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_RCA" name="Поддержать RCA и варианты причинной цепочки"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ConfirmCauses" name="Проверить и подтвердить / отклонить причины"><bpmn:incoming>Flow_17</bpmn:incoming><bpmn:outgoing>Flow_18</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_CausesConfirmed" name="Причины подтверждены?" gatewayDirection="Diverging"><bpmn:incoming>Flow_18</bpmn:incoming><bpmn:outgoing>Flow_19</bpmn:outgoing><bpmn:outgoing>Flow_21</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ClarifyAnalysis" name="Уточнить факты / гипотезы по замечаниям"><bpmn:incoming>Flow_19</bpmn:incoming><bpmn:outgoing>Flow_20</bpmn:outgoing></bpmn:userTask>
    <bpmn:serviceTask id="Task_Actions" name="Предложить корректирующие мероприятия"><bpmn:incoming>Flow_21</bpmn:incoming><bpmn:outgoing>Flow_22</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_RefineActions" name="Проверить / уточнить мероприятия"><bpmn:incoming>Flow_22</bpmn:incoming><bpmn:outgoing>Flow_23</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmActions" name="Подтвердить мероприятия"><bpmn:incoming>Flow_23</bpmn:incoming><bpmn:outgoing>Flow_24</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeReport" gatewayDirection="Converging"><bpmn:incoming>Flow_24</bpmn:incoming><bpmn:incoming>Flow_32</bpmn:incoming><bpmn:outgoing>Flow_25</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_DraftReport" name="Сформировать проект итогового отчета из подтвержденного состояния дела"><bpmn:incoming>Flow_25</bpmn:incoming><bpmn:outgoing>Flow_26</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:userTask id="Task_ReviewReport" name="Проверить и доработать проект отчета"><bpmn:incoming>Flow_26</bpmn:incoming><bpmn:outgoing>Flow_27</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ApproveReport" name="Согласовать итоговый отчет"><bpmn:incoming>Flow_27</bpmn:incoming><bpmn:outgoing>Flow_28</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_AcceptReport" name="Принять / утвердить итоговый отчет"><bpmn:incoming>Flow_28</bpmn:incoming><bpmn:outgoing>Flow_29</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReportAccepted" name="Отчет принят?" gatewayDirection="Diverging"><bpmn:incoming>Flow_29</bpmn:incoming><bpmn:outgoing>Flow_30</bpmn:outgoing><bpmn:outgoing>Flow_31</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="Gateway_MergeRework" gatewayDirection="Converging"><bpmn:incoming>Flow_31</bpmn:incoming><bpmn:outgoing>Flow_31a</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReworkReport" name="Доработать отчет / данные по замечаниям"><bpmn:incoming>Flow_31a</bpmn:incoming><bpmn:outgoing>Flow_32</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Accepted" name="Отчет принят / расчет M-03"><bpmn:incoming>Flow_30</bpmn:incoming></bpmn:endEvent>
    <bpmn:textAnnotation id="Annotation_Approver"><bpmn:text>Роль и полномочия принимающего / утверждающего итоговый отчет требуется определить.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Approver" sourceRef="Task_AcceptReport" targetRef="Annotation_Approver" associationDirection="None"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Case" targetRef="Task_CreateCase"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_CreateCase" targetRef="Task_Plan"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Plan" targetRef="Task_ConfirmPlan"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Task_ConfirmPlan" targetRef="Task_Upload"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Upload" targetRef="Task_Facts"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_Facts" targetRef="Task_ValidateFacts"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Task_ValidateFacts" targetRef="Task_InitialHyp"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Task_InitialHyp" targetRef="Task_AI_Hyp"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Task_AI_Hyp" targetRef="Gateway_MergeAnalysis"/><bpmn:sequenceFlow id="Flow_10" sourceRef="Gateway_MergeAnalysis" targetRef="Task_CheckHyp"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Task_CheckHyp" targetRef="Gateway_NeedMore"/><bpmn:sequenceFlow id="Flow_12" name="Да" sourceRef="Gateway_NeedMore" targetRef="Task_DecideMore"/><bpmn:sequenceFlow id="Flow_13" sourceRef="Task_DecideMore" targetRef="Task_CollectMore"/><bpmn:sequenceFlow id="Flow_14" sourceRef="Task_CollectMore" targetRef="Task_ProcessMore"/><bpmn:sequenceFlow id="Flow_15a" sourceRef="Task_ProcessMore" targetRef="Task_ValidateNew"/><bpmn:sequenceFlow id="Flow_15" name="Повторная проверка" sourceRef="Task_ValidateNew" targetRef="Gateway_MergeAnalysis"/><bpmn:sequenceFlow id="Flow_16" name="Нет" sourceRef="Gateway_NeedMore" targetRef="Task_RCA"/><bpmn:sequenceFlow id="Flow_17" sourceRef="Task_RCA" targetRef="Task_ConfirmCauses"/><bpmn:sequenceFlow id="Flow_18" sourceRef="Task_ConfirmCauses" targetRef="Gateway_CausesConfirmed"/><bpmn:sequenceFlow id="Flow_19" name="Нет" sourceRef="Gateway_CausesConfirmed" targetRef="Task_ClarifyAnalysis"/><bpmn:sequenceFlow id="Flow_20" sourceRef="Task_ClarifyAnalysis" targetRef="Gateway_MergeAnalysis"/><bpmn:sequenceFlow id="Flow_21" name="Да" sourceRef="Gateway_CausesConfirmed" targetRef="Task_Actions"/><bpmn:sequenceFlow id="Flow_22" sourceRef="Task_Actions" targetRef="Task_RefineActions"/><bpmn:sequenceFlow id="Flow_23" sourceRef="Task_RefineActions" targetRef="Task_ConfirmActions"/><bpmn:sequenceFlow id="Flow_24" sourceRef="Task_ConfirmActions" targetRef="Gateway_MergeReport"/><bpmn:sequenceFlow id="Flow_25" sourceRef="Gateway_MergeReport" targetRef="Task_DraftReport"/><bpmn:sequenceFlow id="Flow_26" sourceRef="Task_DraftReport" targetRef="Task_ReviewReport"/><bpmn:sequenceFlow id="Flow_27" sourceRef="Task_ReviewReport" targetRef="Task_ApproveReport"/><bpmn:sequenceFlow id="Flow_28" sourceRef="Task_ApproveReport" targetRef="Task_AcceptReport"/><bpmn:sequenceFlow id="Flow_29" sourceRef="Task_AcceptReport" targetRef="Gateway_ReportAccepted"/><bpmn:sequenceFlow id="Flow_30" name="Да" sourceRef="Gateway_ReportAccepted" targetRef="EndEvent_Accepted"/><bpmn:sequenceFlow id="Flow_31" name="Нет" sourceRef="Gateway_ReportAccepted" targetRef="Gateway_MergeRework"/><bpmn:sequenceFlow id="Flow_31a" sourceRef="Gateway_MergeRework" targetRef="Task_ReworkReport"/><bpmn:sequenceFlow id="Flow_32" name="Повторное формирование" sourceRef="Task_ReworkReport" targetRef="Gateway_MergeReport"/>
  </bpmn:process>
