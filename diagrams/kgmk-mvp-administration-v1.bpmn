<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Defs_kgmk-mvp-administration-v1"
 targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-mvp-administration-v1">
  <bpmn:collaboration id="Collab_kgmk-mvp-administration-v1">
    <bpmn:participant id="Part_kgmk-mvp-administration-v1" name="MVP — Администрирование приложения" processRef="Proc_kgmk-mvp-administration-v1"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-mvp-administration-v1" name="MVP — Администрирование приложения" isExecutable="false">
    <bpmn:laneSet id="LaneSet_admin">
      <bpmn:lane id="L_Admin" name="Администратор приложения">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenPanel</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UpdateContent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UpdateDicts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>UpdateLevels</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AssignAccess</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_System" name="Система">
        <bpmn:flowNodeRef>ApplySettings</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Требуется настройка или актуализация приложения"/>
    <bpmn:userTask id="OpenPanel" name="Открыть административную панель"/>
    <bpmn:userTask id="UpdateContent" name="Актуализировать контент"/>
    <bpmn:userTask id="UpdateDicts" name="Актуализировать необходимые справочники"/>
    <bpmn:userTask id="UpdateLevels" name="Загрузить / актуализировать уровни культуры БЕ"/>
    <bpmn:userTask id="AssignAccess" name="Назначить роли и закрепление пользователей за БЕ"/>
    <bpmn:serviceTask id="ApplySettings" name="Использовать сохранённые настройки для доступа и каталога"/>
    <bpmn:endEvent id="E" name="Данные и доступы приложения актуализированы"/>

    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="OpenPanel"/>
    <bpmn:sequenceFlow id="F2" sourceRef="OpenPanel" targetRef="UpdateContent"/>
    <bpmn:sequenceFlow id="F3" sourceRef="UpdateContent" targetRef="UpdateDicts"/>
    <bpmn:sequenceFlow id="F4" sourceRef="UpdateDicts" targetRef="UpdateLevels"/>
    <bpmn:sequenceFlow id="F5" sourceRef="UpdateLevels" targetRef="AssignAccess"/>
    <bpmn:sequenceFlow id="F6" sourceRef="AssignAccess" targetRef="ApplySettings"/>
    <bpmn:sequenceFlow id="F7" sourceRef="ApplySettings" targetRef="E"/>
  </bpmn:process>

  <bpmndi:BPMNDiagram id="Diagram_admin">
    <bpmndi:BPMNPlane id="Plane_admin" bpmnElement="Collab_kgmk-mvp-administration-v1">
      <bpmndi:BPMNShape id="Part_di" bpmnElement="Part_kgmk-mvp-administration-v1" isHorizontal="true"><dc:Bounds x="30" y="40" width="2380" height="500"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Admin_di" bpmnElement="L_Admin" isHorizontal="true"><dc:Bounds x="60" y="40" width="2290" height="240"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_System_di" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="60" y="280" width="2290" height="260"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="100" y="140" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OpenPanel_di" bpmnElement="OpenPanel"><dc:Bounds x="190" y="115" width="230" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateContent_di" bpmnElement="UpdateContent"><dc:Bounds x="480" y="115" width="230" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateDicts_di" bpmnElement="UpdateDicts"><dc:Bounds x="770" y="115" width="260" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateLevels_di" bpmnElement="UpdateLevels"><dc:Bounds x="1090" y="115" width="280" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AssignAccess_di" bpmnElement="AssignAccess"><dc:Bounds x="1430" y="115" width="300" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApplySettings_di" bpmnElement="ApplySettings"><dc:Bounds x="1800" y="355" width="300" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="2200" y="377" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="158"/><di:waypoint x="190" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="420" y="155"/><di:waypoint x="480" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="710" y="155"/><di:waypoint x="770" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="1030" y="155"/><di:waypoint x="1090" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="1370" y="155"/><di:waypoint x="1430" y="155"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1730" y="155"/><di:waypoint x="1760" y="155"/><di:waypoint x="1760" y="395"/><di:waypoint x="1800" y="395"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="2100" y="395"/><di:waypoint x="2200" y="395"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
