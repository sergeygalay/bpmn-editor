<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Chairperson" targetNamespace="https://sergeygalay.github.io/bpmn-editor/vns-investigation-chairperson">
  <bpmn:collaboration id="Collaboration_Chairperson">
    <bpmn:participant id="Participant_Chairperson" name="Процесс председателя комиссии" processRef="Process_Chairperson"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Chairperson" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Chairperson">
      <bpmn:lane id="Lane_Chairperson" name="Председатель комиссии">
        <bpmn:flowNodeRef>StartEvent_Chair</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmPlan</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Control</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NeedMore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DecideMore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Merge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmCauses</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ConfirmActions</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ApproveReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Chair</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Chair" name="План расследования подготовлен">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_ConfirmPlan" name="Проверить и подтвердить план расследования">
      <bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Control" name="Контролировать полноту и сроки расследования">
      <bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NeedMore" name="Нужен досбор?" gatewayDirection="Diverging">
      <bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing><bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_DecideMore" name="Принять решение о досборе материалов">
      <bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Merge" gatewayDirection="Converging">
      <bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ConfirmCauses" name="Подтвердить причины">
      <bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ConfirmActions" name="Подтвердить корректирующие мероприятия">
      <bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_ApproveReport" name="Согласовать итоговый отчет">
      <bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_SendReport" name="Передать отчет на принятие / утверждение">
      <bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Chair" name="Отчет передан на принятие / утверждение">
      <bpmn:incoming>Flow_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Chair" targetRef="Task_ConfirmPlan"/>
    <bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ConfirmPlan" targetRef="Task_Control"/>
    <bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Control" targetRef="Gateway_NeedMore"/>
    <bpmn:sequenceFlow id="Flow_4" name="Да" sourceRef="Gateway_NeedMore" targetRef="Task_DecideMore"/>
    <bpmn:sequenceFlow id="Flow_5" name="Нет" sourceRef="Gateway_NeedMore" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_6" sourceRef="Task_DecideMore" targetRef="Gateway_Merge"/>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_Merge" targetRef="Task_ConfirmCauses"/>
    <bpmn:sequenceFlow id="Flow_8" sourceRef="Task_ConfirmCauses" targetRef="Task_ConfirmActions"/>
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_ConfirmActions" targetRef="Task_ApproveReport"/>
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_ApproveReport" targetRef="Task_SendReport"/>
    <bpmn:sequenceFlow id="Flow_11" sourceRef="Task_SendReport" targetRef="EndEvent_Chair"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Chairperson">
    <bpmndi:BPMNPlane id="BPMNPlane_Chairperson" bpmnElement="Collaboration_Chairperson">
      <bpmndi:BPMNShape id="Shape_Participant_Chair" bpmnElement="Participant_Chairperson" isHorizontal="true"><dc:Bounds x="40" y="70" width="2100" height="330"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Chair" bpmnElement="Lane_Chairperson" isHorizontal="true"><dc:Bounds x="70" y="70" width="2070" height="330"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Chair" bpmnElement="StartEvent_Chair"><dc:Bounds x="110" y="190" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ConfirmPlan" bpmnElement="Task_ConfirmPlan"><dc:Bounds x="190" y="160" width="190" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Control" bpmnElement="Task_Control"><dc:Bounds x="430" y="160" width="190" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_NeedMore" bpmnElement="Gateway_NeedMore" isMarkerVisible="true"><dc:Bounds x="675" y="180" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_DecideMore" bpmnElement="Task_DecideMore"><dc:Bounds x="625" y="290" width="190" height="70"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Merge" bpmnElement="Gateway_Merge" isMarkerVisible="true"><dc:Bounds x="865" y="180" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ConfirmCauses" bpmnElement="Task_ConfirmCauses"><dc:Bounds x="965" y="160" width="160" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ConfirmActions" bpmnElement="Task_ConfirmActions"><dc:Bounds x="1175" y="160" width="200" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ApproveReport" bpmnElement="Task_ApproveReport"><dc:Bounds x="1425" y="160" width="180" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_SendReport" bpmnElement="Task_SendReport"><dc:Bounds x="1655" y="160" width="210" height="90"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_End_Chair" bpmnElement="EndEvent_Chair"><dc:Bounds x="1940" y="190" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="146" y="208"/><di:waypoint x="190" y="208"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="380" y="205"/><di:waypoint x="430" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="620" y="205"/><di:waypoint x="675" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="700" y="230"/><di:waypoint x="700" y="290"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="725" y="205"/><di:waypoint x="865" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="815" y="325"/><di:waypoint x="890" y="325"/><di:waypoint x="890" y="230"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7"><di:waypoint x="915" y="205"/><di:waypoint x="965" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8"><di:waypoint x="1125" y="205"/><di:waypoint x="1175" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9"><di:waypoint x="1375" y="205"/><di:waypoint x="1425" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10"><di:waypoint x="1605" y="205"/><di:waypoint x="1655" y="205"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11"><di:waypoint x="1865" y="205"/><di:waypoint x="1940" y="205"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
