<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_HSEExpert" targetNamespace="https://sergeygalay.github.io/bpmn-editor/vns-investigation-hse-expert">
  <bpmn:collaboration id="Collaboration_HSEExpert"><bpmn:participant id="Participant_HSEExpert" name="Процесс специалиста ПБиОТ / профильного эксперта" processRef="Process_HSEExpert"/></bpmn:collaboration>
  <bpmn:process id="Process_HSEExpert" isExecutable="false">
    <bpmn:laneSet id="LaneSet_HSEExpert"><bpmn:lane id="Lane_HSEExpert" name="Специалист ПБиОТ / профильный эксперт">
      <bpmn:flowNodeRef>StartEvent_Expert</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviewRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProvideConclusion</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeVerify</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Verify</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NeedClarify</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Clarify</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Record</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Expert</bpmn:flowNodeRef>
    </bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Expert" name="Получен запрос на экспертизу"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_ReviewRequest" name="Изучить запрос и доступные материалы"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ProvideConclusion" name="Предоставить материалы / заключение"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeVerify" gatewayDirection="Converging"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Verify" name="Проверить профильные факты, гипотезы и причинные связи"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NeedClarify" name="Нужны уточнения?" gatewayDirection="Diverging"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_Clarify" name="Запросить / получить дополнительные сведения"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_Record" name="Зафиксировать экспертные выводы"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Expert" name="Экспертиза завершена"><bpmn:incoming>Flow_9</bpmn:incoming></bpmn:endEvent>
    <bpmn:textAnnotation id="Annotation_Access"><bpmn:text>Канал прямой работы эксперта с ИИ-помощником — требуется определить.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Association_Access" sourceRef="Task_Verify" targetRef="Annotation_Access" associationDirection="None"/>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Expert" targetRef="Task_ReviewRequest"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_ReviewRequest" targetRef="Task_ProvideConclusion"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ProvideConclusion" targetRef="Gateway_MergeVerify"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Gateway_MergeVerify" targetRef="Task_Verify"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_Verify" targetRef="Gateway_NeedClarify"/><bpmn:sequenceFlow id="Flow_6" name="Да" sourceRef="Gateway_NeedClarify" targetRef="Task_Clarify"/><bpmn:sequenceFlow id="Flow_7" name="Повторная проверка" sourceRef="Task_Clarify" targetRef="Gateway_MergeVerify"/><bpmn:sequenceFlow id="Flow_8" name="Нет" sourceRef="Gateway_NeedClarify" targetRef="Task_Record"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Record" targetRef="EndEvent_Expert"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_HSEExpert"><bpmndi:BPMNPlane id="BPMNPlane_HSEExpert" bpmnElement="Collaboration_HSEExpert">
    <bpmndi:BPMNShape id="Shape_Participant_Expert" bpmnElement="Participant_HSEExpert" isHorizontal="true"><dc:Bounds x="40" y="70" width="1880" height="370"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_Expert" bpmnElement="Lane_HSEExpert" isHorizontal="true"><dc:Bounds x="70" y="70" width="1850" height="370"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Start_Expert" bpmnElement="StartEvent_Expert"><dc:Bounds x="110" y="190" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ReviewRequest" bpmnElement="Task_ReviewRequest"><dc:Bounds x="190" y="160" width="190" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ProvideConclusion" bpmnElement="Task_ProvideConclusion"><dc:Bounds x="430" y="160" width="190" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_MergeVerify" bpmnElement="Gateway_MergeVerify" isMarkerVisible="true"><dc:Bounds x="670" y="180" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Verify" bpmnElement="Task_Verify"><dc:Bounds x="770" y="155" width="240" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_NeedClarify" bpmnElement="Gateway_NeedClarify" isMarkerVisible="true"><dc:Bounds x="1060" y="175" width="60" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Clarify" bpmnElement="Task_Clarify"><dc:Bounds x="990" y="305" width="230" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Record" bpmnElement="Task_Record"><dc:Bounds x="1170" y="160" width="190" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Expert" bpmnElement="EndEvent_Expert"><dc:Bounds x="1420" y="190" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Annotation_Access" bpmnElement="Annotation_Access"><dc:Bounds x="770" y="300" width="190" height="65"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="146" y="208"/><di:waypoint x="190" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="380" y="205"/><di:waypoint x="430" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="620" y="205"/><di:waypoint x="670" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="720" y="205"/><di:waypoint x="770" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="1010" y="205"/><di:waypoint x="1060" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="1090" y="235"/><di:waypoint x="1090" y="305"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7"><di:waypoint x="990" y="342"/><di:waypoint x="695" y="342"/><di:waypoint x="695" y="230"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8"><di:waypoint x="1120" y="205"/><di:waypoint x="1170" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9"><di:waypoint x="1360" y="205"/><di:waypoint x="1420" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_Association" bpmnElement="Association_Access"><di:waypoint x="890" y="255"/><di:waypoint x="890" y="300"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
