<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
 xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
 xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
 xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
 id="Defs_kgmk-mvp-project-delivery-v1"
 targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-mvp-project-delivery-v1">
  <bpmn:collaboration id="Collab_kgmk-mvp-project-delivery-v1">
    <bpmn:participant id="Part_kgmk-mvp-project-delivery-v1" name="MVP — Реализация проекта" processRef="Proc_kgmk-mvp-project-delivery-v1"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-mvp-project-delivery-v1" name="MVP — Реализация проекта" isExecutable="false">
    <bpmn:laneSet id="LaneSet_delivery">
      <bpmn:lane id="L_Customer" name="Заказчик БЕ">
        <bpmn:flowNodeRef>StartWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MoveInProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FinishWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MoveReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Head" name="Руководитель ПМКБ">
        <bpmn:flowNodeRef>ReviewCompletion</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CompletionDecision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_System" name="Система">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordInProgress</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RecordDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>KeepReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DoneEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Согласованный проект находится в To Do"/>
    <bpmn:userTask id="StartWork" name="Начать реализацию проекта"/>
    <bpmn:userTask id="MoveInProgress" name="Перевести проект в In Progress"/>
    <bpmn:serviceTask id="RecordInProgress" name="Зафиксировать статус In Progress"/>
    <bpmn:userTask id="FinishWork" name="Завершить работы по проекту"/>
    <bpmn:userTask id="MoveReview" name="Перевести проект в Review"/>
    <bpmn:serviceTask id="RecordReview" name="Зафиксировать статус Review"/>
    <bpmn:userTask id="ReviewCompletion" name="Рассмотреть завершение проекта"/>
    <bpmn:exclusiveGateway id="CompletionDecision" name="Завершение проекта согласовано?"/>
    <bpmn:serviceTask id="RecordDone" name="Зафиксировать статус Done"/>
    <bpmn:serviceTask id="KeepReview" name="Сохранить статус Review"/>
    <bpmn:endEvent id="DoneEnd" name="Проект завершён"/>
    <bpmn:endEvent id="ReviewEnd" name="Проект остаётся в Review"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="StartWork"/>
    <bpmn:sequenceFlow id="F2" sourceRef="StartWork" targetRef="MoveInProgress"/>
    <bpmn:sequenceFlow id="F3" sourceRef="MoveInProgress" targetRef="RecordInProgress"/>
    <bpmn:sequenceFlow id="F4" sourceRef="RecordInProgress" targetRef="FinishWork"/>
    <bpmn:sequenceFlow id="F5" sourceRef="FinishWork" targetRef="MoveReview"/>
    <bpmn:sequenceFlow id="F6" sourceRef="MoveReview" targetRef="RecordReview"/>
    <bpmn:sequenceFlow id="F7" sourceRef="RecordReview" targetRef="ReviewCompletion"/>
    <bpmn:sequenceFlow id="F8" sourceRef="ReviewCompletion" targetRef="CompletionDecision"/>
    <bpmn:sequenceFlow id="F9" sourceRef="CompletionDecision" targetRef="RecordDone" name="Да"/>
    <bpmn:sequenceFlow id="F10" sourceRef="RecordDone" targetRef="DoneEnd"/>
    <bpmn:sequenceFlow id="F11" sourceRef="CompletionDecision" targetRef="KeepReview" name="Нет"/>
    <bpmn:sequenceFlow id="F12" sourceRef="KeepReview" targetRef="ReviewEnd"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_delivery">
    <bpmndi:BPMNPlane id="Plane_delivery" bpmnElement="Collab_kgmk-mvp-project-delivery-v1">
      <bpmndi:BPMNShape id="Part_di" bpmnElement="Part_kgmk-mvp-project-delivery-v1" isHorizontal="true"><dc:Bounds x="30" y="40" width="3500" height="720"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Customer_di" bpmnElement="L_Customer" isHorizontal="true"><dc:Bounds x="60" y="40" width="3410" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Head_di" bpmnElement="L_Head" isHorizontal="true"><dc:Bounds x="60" y="260" width="3410" height="220"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_System_di" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="60" y="480" width="3410" height="280"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="100" y="575" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartWork_di" bpmnElement="StartWork"><dc:Bounds x="200" y="105" width="230" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MoveInProgress_di" bpmnElement="MoveInProgress"><dc:Bounds x="500" y="105" width="260" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordInProgress_di" bpmnElement="RecordInProgress"><dc:Bounds x="830" y="555" width="270" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="FinishWork_di" bpmnElement="FinishWork"><dc:Bounds x="1170" y="105" width="250" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="MoveReview_di" bpmnElement="MoveReview"><dc:Bounds x="1490" y="105" width="240" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordReview_di" bpmnElement="RecordReview"><dc:Bounds x="1800" y="555" width="250" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewCompletion_di" bpmnElement="ReviewCompletion"><dc:Bounds x="2120" y="325" width="260" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompletionDecision_di" bpmnElement="CompletionDecision" isMarkerVisible="true"><dc:Bounds x="2450" y="340" width="50" height="50"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordDone_di" bpmnElement="RecordDone"><dc:Bounds x="2600" y="545" width="240" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DoneEnd_di" bpmnElement="DoneEnd"><dc:Bounds x="2930" y="567" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="KeepReview_di" bpmnElement="KeepReview"><dc:Bounds x="2600" y="655" width="240" height="80"/></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewEnd_di" bpmnElement="ReviewEnd"><dc:Bounds x="2930" y="677" width="36" height="36"/></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="593"/><di:waypoint x="165" y="593"/><di:waypoint x="165" y="145"/><di:waypoint x="200" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="430" y="145"/><di:waypoint x="500" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="760" y="145"/><di:waypoint x="795" y="145"/><di:waypoint x="795" y="595"/><di:waypoint x="830" y="595"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="1100" y="595"/><di:waypoint x="1135" y="595"/><di:waypoint x="1135" y="145"/><di:waypoint x="1170" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="1420" y="145"/><di:waypoint x="1490" y="145"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1730" y="145"/><di:waypoint x="1765" y="145"/><di:waypoint x="1765" y="595"/><di:waypoint x="1800" y="595"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="2050" y="595"/><di:waypoint x="2085" y="595"/><di:waypoint x="2085" y="365"/><di:waypoint x="2120" y="365"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="2380" y="365"/><di:waypoint x="2450" y="365"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="2500" y="365"/><di:waypoint x="2550" y="365"/><di:waypoint x="2550" y="585"/><di:waypoint x="2600" y="585"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="2840" y="585"/><di:waypoint x="2930" y="585"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="2475" y="390"/><di:waypoint x="2475" y="695"/><di:waypoint x="2600" y="695"/></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="2840" y="695"/><di:waypoint x="2930" y="695"/></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
