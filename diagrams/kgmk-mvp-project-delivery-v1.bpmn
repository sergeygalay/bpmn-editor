      <bpmndi:BPMNShape id="MoveInProgress_di" bpmnElement="MoveInProgress">
        <dc:Bounds x="330" y="105" width="260" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordInProgress_di" bpmnElement="RecordInProgress">
        <dc:Bounds x="775" y="555" width="270" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_04dktue_di" bpmnElement="Gateway_04dktue" isMarkerVisible="true">
        <dc:Bounds x="675" y="570" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F4_di" bpmnElement="F4">
        <di:waypoint x="1045" y="610" />
        <di:waypoint x="1100" y="610" />
        <di:waypoint x="1100" y="145" />
        <di:waypoint x="1170" y="145" />
      </bpmndi:BPMNEdge>
