      <bpmndi:BPMNShape id="MoveReview_di" bpmnElement="MoveReview">
        <dc:Bounds x="1490" y="105" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordReview_di" bpmnElement="RecordReview">
        <dc:Bounds x="1800" y="555" width="250" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ReviewCompletion_di" bpmnElement="ReviewCompletion">
        <dc:Bounds x="2120" y="325" width="260" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CompletionDecision_di" bpmnElement="CompletionDecision" isMarkerVisible="true">
        <dc:Bounds x="2450" y="340" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2440" y="290" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="RecordDone_di" bpmnElement="RecordDone">
