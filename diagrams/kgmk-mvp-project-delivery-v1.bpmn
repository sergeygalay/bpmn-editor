      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="2050" y="595" />
        <di:waypoint x="2085" y="595" />
        <di:waypoint x="2085" y="365" />
        <di:waypoint x="2120" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
