      <bpmndi:BPMNShape id="DoneEnd_di" bpmnElement="DoneEnd">
        <dc:Bounds x="2930" y="567" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="S_di" bpmnElement="S">
        <dc:Bounds x="-70" y="575" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="-97" y="611" width="90" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="StartWork_di" bpmnElement="StartWork">
        <dc:Bounds x="30" y="105" width="230" height="80" />
