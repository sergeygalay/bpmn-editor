<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-as-is" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-as-is">
<bpmn:collaboration id="Collaboration_contractor-opr-as-is">
<bpmn:participant id="Participant_Window" name="Единое окно" processRef="Process_Window"/>
<bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker"/>
<bpmn:participant id="Participant_Octant" name="Октант" processRef="Process_Octant"/>
<bpmn:messageFlow id="Message_2" name="Поручение на проверку" sourceRef="Schedule" targetRef="CheckerStart"/>
<bpmn:messageFlow id="Message_3" name="Заполненный чек-лист" sourceRef="Send" targetRef="ReceiveCheck"/>
<bpmn:messageFlow id="Message_1" name="Загрузка результата" sourceRef="Upload" targetRef="OctStart"/>
</bpmn:collaboration>
<bpmn:process id="Process_Window" name="Единое окно" isExecutable="false">
<bpmn:startEvent id="Start" name="Необходимость ОПР"/>
<bpmn:userTask id="Schedule" name="Назначить проверяющего и проверку"/>
<bpmn:receiveTask id="ReceiveCheck" name="Получить заполненный чек-лист"/>
<bpmn:userTask id="Upload" name="Разместить результат в «Октанте»"/>
<bpmn:endEvent id="End" name="Результат передан"/>
<bpmn:sequenceFlow id="Sequence_01" sourceRef="Start" targetRef="Schedule"/>
<bpmn:sequenceFlow id="Flow_Window_Wait" sourceRef="Schedule" targetRef="ReceiveCheck"/>
<bpmn:sequenceFlow id="Flow_Window_Upload" sourceRef="ReceiveCheck" targetRef="Upload"/>
<bpmn:sequenceFlow id="Sequence_16" sourceRef="Upload" targetRef="End"/>
</bpmn:process>
<bpmn:process id="Process_Checker" name="Проверяющий" isExecutable="false">
<bpmn:startEvent id="CheckerStart" name="Получено поручение"/>
<bpmn:manualTask id="Print" name="Распечатать чек-лист"/>
<bpmn:manualTask id="Inspect" name="Проверить работы и заполнить форму"/>
<bpmn:exclusiveGateway id="Critical" name="Нарушен блокирующий критерий?"/>
<bpmn:manualTask id="Unsat" name="Установить «неуд»"/>
<bpmn:manualTask id="Select" name="Определить «уд» / «неуд»"/>
<bpmn:exclusiveGateway id="MergeEval"/>
<bpmn:manualTask id="Sign" name="Подписать бумажный чек-лист"/>
<bpmn:exclusiveGateway id="Risk" name="Требуются акт и/или приостановка?"/>
<bpmn:manualTask id="Act" name="Оформить акт и/или приостановить работы"/>
<bpmn:exclusiveGateway id="MergeAct"/>
<bpmn:sendTask id="Send" name="Передать чек-лист в ПБиОТ"/>
<bpmn:endEvent id="CheckerEnd" name="Чек-лист передан"/>
<bpmn:sequenceFlow id="Flow_Checker_Start" sourceRef="CheckerStart" targetRef="Print"/>
<bpmn:sequenceFlow id="Sequence_03" sourceRef="Print" targetRef="Inspect"/>
<bpmn:sequenceFlow id="Sequence_04" sourceRef="Inspect" targetRef="Critical"/>
<bpmn:sequenceFlow id="Sequence_05" sourceRef="Critical" targetRef="Unsat" name="Да"/>
<bpmn:sequenceFlow id="Sequence_06" sourceRef="Critical" targetRef="Select" name="Нет"/>
<bpmn:sequenceFlow id="Sequence_07" sourceRef="Unsat" targetRef="MergeEval"/>
<bpmn:sequenceFlow id="Sequence_08" sourceRef="Select" targetRef="MergeEval"/>
<bpmn:sequenceFlow id="Sequence_09" sourceRef="MergeEval" targetRef="Sign"/>
<bpmn:sequenceFlow id="Sequence_10" sourceRef="Sign" targetRef="Risk"/>
<bpmn:sequenceFlow id="Sequence_11" sourceRef="Risk" targetRef="Act" name="Да"/>
<bpmn:sequenceFlow id="Sequence_12" sourceRef="Risk" targetRef="MergeAct" name="Нет"/>
<bpmn:sequenceFlow id="Sequence_13" sourceRef="Act" targetRef="MergeAct"/>
<bpmn:sequenceFlow id="Sequence_14" sourceRef="MergeAct" targetRef="Send"/>
<bpmn:sequenceFlow id="Flow_Checker_End" sourceRef="Send" targetRef="CheckerEnd"/>
</bpmn:process>
<bpmn:process id="Process_Octant" name="Октант" isExecutable="false">
<bpmn:startEvent id="OctStart" name="Получен результат"/>
<bpmn:task id="OctStore" name="Доступен файл проверки"/>
<bpmn:endEvent id="OctEnd" name="Учтён"/>
<bpmn:sequenceFlow id="Sequence_17" sourceRef="OctStart" targetRef="OctStore"/>
<bpmn:sequenceFlow id="Sequence_18" sourceRef="OctStore" targetRef="OctEnd"/>
</bpmn:process>
