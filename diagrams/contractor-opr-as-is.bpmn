<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-as-is" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-as-is">
  <bpmn:collaboration id="Collaboration_contractor-opr-as-is">
    <bpmn:participant id="Participant_Window" name="Аналитик / специалист «Единого окна» ПБиОТ" processRef="Process_Window" />
    <bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker" />
    <bpmn:participant id="Participant_Octant" name="Система «Октант» (локальные экземпляры в филиалах)" processRef="Process_Octant" />
    <bpmn:messageFlow id="Message_Plan" sourceRef="Schedule" targetRef="OctPlanStart" name="График и назначение" />
    <bpmn:messageFlow id="Message_2" sourceRef="Schedule" targetRef="CheckerStart" name="Поручение на плановую проверку" />
    <bpmn:messageFlow id="Message_3" sourceRef="Send" targetRef="ReceiveCheck" name="Сканы и файлы чек-листа / Акта" />
    <bpmn:messageFlow id="Message_1" sourceRef="Upload" targetRef="OctStart" name="Ручной ввод данных и загрузка файлов" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Window" name="Единое окно и аналитик — AS-IS" isExecutable="false">
    <bpmn:startEvent id="Start" name="Необходимость плановой проверки (ОПР / аудит)" />
    <bpmn:userTask id="Schedule" name="Запланировать проверку (ОПР / аудит) и назначить проверяющего в «Октанте»" />
    <bpmn:receiveTask id="ReceiveCheck" name="Получить сканы и файлы проверки (с задержкой 2–3 дня)" />
    <bpmn:userTask id="Upload" name="Вручную внести данные и прикрепить файлы в «Октанте»" />
    <bpmn:endEvent id="End" name="Данные и файлы внесены в «Октант»" />
    <bpmn:sequenceFlow id="Sequence_01" sourceRef="Start" targetRef="Schedule" />
    <bpmn:sequenceFlow id="Flow_Window_Wait" sourceRef="Schedule" targetRef="ReceiveCheck" />
    <bpmn:sequenceFlow id="Flow_Window_Upload" sourceRef="ReceiveCheck" targetRef="Upload" />
    <bpmn:sequenceFlow id="Sequence_16" sourceRef="Upload" targetRef="End" />
  </bpmn:process>
  <bpmn:process id="Process_Checker" name="Проверяющий — AS-IS" isExecutable="false">
    <bpmn:startEvent id="CheckerStart" name="Поручение по графику или внеплановый обход (КПР)" />
    <bpmn:exclusiveGateway id="Gateway_CheckType" name="Вид проверки?" />
    <bpmn:manualTask id="Print" name="Распечатать бумажный бланк чек-листа (ОПР / аудит)" />
    <bpmn:manualTask id="Inspect" name="Провести проверку на объекте и заполнить бумажный бланк" />
    <bpmn:manualTask id="InspectKpr" name="Провести внеплановый обход (КПР) и зафиксировать нарушения" />
    <bpmn:exclusiveGateway id="MergeInspect" />
    <bpmn:userTask id="PrepareWordExcel" name="Вручную оформить на рабочем месте в Word / Excel чек-лист и итог проверки" />
    <bpmn:exclusiveGateway id="Risk" name="Выявлены нарушения (нужен Акт проверки)?" />
    <bpmn:userTask id="Act" name="Вручную составить Акт проверки в Word (при необходимости — приостановка работ)" />
    <bpmn:exclusiveGateway id="MergeAct" />
    <bpmn:manualTask id="Sign" name="Распечатать и подписать документы на бумаге (при необходимости — у подрядчика)" />
    <bpmn:manualTask id="Scan" name="Отсканировать подписанные документы" />
    <bpmn:sendTask id="Send" name="Направить сканы и файлы специалисту «Единого окна» / аналитику" />
    <bpmn:endEvent id="CheckerEnd" name="Документы переданы" />
    <bpmn:sequenceFlow id="Flow_Checker_Start" sourceRef="CheckerStart" targetRef="Gateway_CheckType" />
    <bpmn:sequenceFlow id="Flow_Type_Planned" sourceRef="Gateway_CheckType" targetRef="Print" name="Плановая (ОПР / аудит)" />
    <bpmn:sequenceFlow id="Flow_Type_Kpr" sourceRef="Gateway_CheckType" targetRef="InspectKpr" name="Внеплановый обход (КПР)" />
    <bpmn:sequenceFlow id="Sequence_03" sourceRef="Print" targetRef="Inspect" />
    <bpmn:sequenceFlow id="Flow_Inspect_Merge" sourceRef="Inspect" targetRef="MergeInspect" />
    <bpmn:sequenceFlow id="Flow_Kpr_Merge" sourceRef="InspectKpr" targetRef="MergeInspect" />
    <bpmn:sequenceFlow id="Flow_To_WordExcel" sourceRef="MergeInspect" targetRef="PrepareWordExcel" />
    <bpmn:sequenceFlow id="Sequence_10" sourceRef="PrepareWordExcel" targetRef="Risk" />
    <bpmn:sequenceFlow id="Sequence_11" sourceRef="Risk" targetRef="Act" name="Да" />
    <bpmn:sequenceFlow id="Sequence_12" sourceRef="Risk" targetRef="MergeAct" name="Нет" />
    <bpmn:sequenceFlow id="Sequence_13" sourceRef="Act" targetRef="MergeAct" />
    <bpmn:sequenceFlow id="Sequence_14" sourceRef="MergeAct" targetRef="Sign" />
    <bpmn:sequenceFlow id="Flow_Sign_Scan" sourceRef="Sign" targetRef="Scan" />
    <bpmn:sequenceFlow id="Flow_Scan_Send" sourceRef="Scan" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_Checker_End" sourceRef="Send" targetRef="CheckerEnd" />
  </bpmn:process>
  <bpmn:process id="Process_Octant" name="Октант — AS-IS" isExecutable="false">
    <bpmn:startEvent id="OctPlanStart" name="Ввод плана проверки" />
    <bpmn:task id="OctPlanStore" name="Сохранить график проверок (ОПР, аудит)" />
    <bpmn:endEvent id="OctPlanEnd" name="График сохранён" />
    <bpmn:startEvent id="OctStart" name="Получены данные и файлы проверки" />
    <bpmn:task id="OctStore" name="Сохранить данные и файлы проверки в журнале «Октанта»" />
    <bpmn:endEvent id="OctEnd" name="Проверка учтена" />
    <bpmn:sequenceFlow id="Flow_OctPlan_1" sourceRef="OctPlanStart" targetRef="OctPlanStore" />
    <bpmn:sequenceFlow id="Flow_OctPlan_2" sourceRef="OctPlanStore" targetRef="OctPlanEnd" />
    <bpmn:sequenceFlow id="Sequence_17" sourceRef="OctStart" targetRef="OctStore" />
    <bpmn:sequenceFlow id="Sequence_18" sourceRef="OctStore" targetRef="OctEnd" />
  </bpmn:process>
