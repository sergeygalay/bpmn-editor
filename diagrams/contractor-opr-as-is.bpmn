<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-as-is" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-as-is">
  <bpmn:collaboration id="Collaboration_contractor-opr-as-is">
    <bpmn:participant id="Participant_Window" name="Аналитик «Октанта»" processRef="Process_Window" />
    <bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker" />
    <bpmn:participant id="Participant_Octant" name="Система «Октант»" processRef="Process_Octant" />
    <bpmn:messageFlow id="Message_Plan" name="График и назначение" sourceRef="Schedule" targetRef="OctPlanStart" />
    <bpmn:messageFlow id="Message_2" name="Поручение на плановую проверку" sourceRef="Schedule" targetRef="CheckerStart" />
    <bpmn:messageFlow id="Message_3" name="Сканы и файлы контрольного листа / Акта" sourceRef="Send" targetRef="WindowReceiveStart" />
    <bpmn:messageFlow id="Message_1" name="Ручной ввод данных и загрузка файлов" sourceRef="Upload" targetRef="OctStart" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Window" name="Аналитик «Октанта» — AS-IS" isExecutable="false">
    <bpmn:startEvent id="Start" name="Необходимость плановой проверки (ОПР / аудит)" />
    <bpmn:userTask id="Schedule" name="Запланировать проверку (ОПР / аудит) и назначить проверяющего в «Октанте»" />
    <bpmn:endEvent id="WindowPlanEnd" name="График сформирован и доведён" />
    <bpmn:startEvent id="WindowReceiveStart" name="Получены сканы и файлы проверки">
      <bpmn:messageEventDefinition id="MED_WindowReceiveStart" />
    </bpmn:startEvent>
    <bpmn:userTask id="Upload" name="Вручную внести данные и прикрепить файлы в «Октанте»" />
    <bpmn:endEvent id="End" name="Данные и файлы внесены в «Октант»" />
    <bpmn:sequenceFlow id="Sequence_01" sourceRef="Start" targetRef="Schedule" />
    <bpmn:sequenceFlow id="Flow_Window_PlanEnd" sourceRef="Schedule" targetRef="WindowPlanEnd" />
    <bpmn:sequenceFlow id="Flow_Window_Upload" sourceRef="WindowReceiveStart" targetRef="Upload" />
    <bpmn:sequenceFlow id="Sequence_16" sourceRef="Upload" targetRef="End" />
  </bpmn:process>
  <bpmn:process id="Process_Checker" name="Проверяющий — AS-IS" isExecutable="false">
    <bpmn:startEvent id="CheckerStart" name="Получено поручение по графику">
      <bpmn:messageEventDefinition id="MED_CheckerStart" />
    </bpmn:startEvent>
    <bpmn:startEvent id="CheckerStartUnplanned" name="Инициирована внеплановая проверка" />
    <bpmn:exclusiveGateway id="MergeStart" />
    <bpmn:exclusiveGateway id="Gateway_CheckType" name="Вид проверки?" />
    <bpmn:manualTask id="Print" name="Распечатать бумажный бланк контрольного листа (ОПР / аудит)" />
    <bpmn:manualTask id="Inspect" name="Провести проверку на объекте и заполнить бумажный бланк" />
    <bpmn:userTask id="PrepareWordExcel" name="Вручную оформить на рабочем месте в Word / Excel контрольный лист и итог проверки" />
    <bpmn:exclusiveGateway id="Risk" name="Выявлены нарушения (нужен Акт проверки)?" />
    <bpmn:manualTask id="InspectKpr" name="Провести проверку (КПР) на объекте и зафиксировать нарушения" />
    <bpmn:exclusiveGateway id="MergeBeforeAct" />
    <bpmn:userTask id="Act" name="Вручную составить Акт проверки в Word (при необходимости — приостановка работ)" />
    <bpmn:exclusiveGateway id="MergeAct" />
    <bpmn:manualTask id="Sign" name="Распечатать и подписать документы на бумаге (при необходимости — у подрядчика)" />
    <bpmn:manualTask id="Scan" name="Отсканировать подписанные документы" />
    <bpmn:sendTask id="Send" name="Направить сканы и файлы аналитику «Октанта» (напрямую или через «Единое окно»)" />
    <bpmn:endEvent id="CheckerEnd" name="Документы переданы" />
    <bpmn:sequenceFlow id="Flow_Checker_PlannedStart" sourceRef="CheckerStart" targetRef="MergeStart" />
    <bpmn:sequenceFlow id="Flow_Checker_UnplannedStart" sourceRef="CheckerStartUnplanned" targetRef="MergeStart" />
    <bpmn:sequenceFlow id="Flow_Checker_Start" sourceRef="MergeStart" targetRef="Gateway_CheckType" />
    <bpmn:sequenceFlow id="Flow_Type_Planned" name="ОПР / аудит" sourceRef="Gateway_CheckType" targetRef="Print" />
    <bpmn:sequenceFlow id="Flow_Type_Kpr" name="КПР" sourceRef="Gateway_CheckType" targetRef="InspectKpr" />
    <bpmn:sequenceFlow id="Sequence_03" sourceRef="Print" targetRef="Inspect" />
    <bpmn:sequenceFlow id="Flow_To_WordExcel" sourceRef="Inspect" targetRef="PrepareWordExcel" />
    <bpmn:sequenceFlow id="Sequence_10" sourceRef="PrepareWordExcel" targetRef="Risk" />
    <bpmn:sequenceFlow id="Sequence_11" name="Да" sourceRef="Risk" targetRef="MergeBeforeAct" />
    <bpmn:sequenceFlow id="Sequence_12" name="Нет" sourceRef="Risk" targetRef="MergeAct" />
    <bpmn:sequenceFlow id="Flow_Kpr_Merge" sourceRef="InspectKpr" targetRef="MergeBeforeAct" />
    <bpmn:sequenceFlow id="Flow_To_Act" sourceRef="MergeBeforeAct" targetRef="Act" />
    <bpmn:sequenceFlow id="Sequence_13" sourceRef="Act" targetRef="MergeAct" />
    <bpmn:sequenceFlow id="Sequence_14" sourceRef="MergeAct" targetRef="Sign" />
    <bpmn:sequenceFlow id="Flow_Sign_Scan" sourceRef="Sign" targetRef="Scan" />
    <bpmn:sequenceFlow id="Flow_Scan_Send" sourceRef="Scan" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_Checker_End" sourceRef="Send" targetRef="CheckerEnd" />
  </bpmn:process>
  <bpmn:process id="Process_Octant" name="Октант — AS-IS" isExecutable="false">
    <bpmn:startEvent id="OctPlanStart" name="Ввод плана проверки">
      <bpmn:messageEventDefinition id="MED_OctPlanStart" />
    </bpmn:startEvent>
    <bpmn:task id="OctPlanStore" name="Сохранить график проверок (ОПР, аудит)" />
    <bpmn:endEvent id="OctPlanEnd" name="График сохранён" />
    <bpmn:startEvent id="OctStart" name="Получены данные и файлы проверки">
      <bpmn:messageEventDefinition id="MED_OctStart" />
    </bpmn:startEvent>
    <bpmn:task id="OctStore" name="Сохранить данные и файлы проверки в журнале «Октанта»" />
    <bpmn:endEvent id="OctEnd" name="Проверка учтена" />
    <bpmn:sequenceFlow id="Flow_OctPlan_1" sourceRef="OctPlanStart" targetRef="OctPlanStore" />
    <bpmn:sequenceFlow id="Flow_OctPlan_2" sourceRef="OctPlanStore" targetRef="OctPlanEnd" />
    <bpmn:sequenceFlow id="Sequence_17" sourceRef="OctStart" targetRef="OctStore" />
    <bpmn:sequenceFlow id="Sequence_18" sourceRef="OctStore" targetRef="OctEnd" />
  </bpmn:process>
