<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-as-is" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-as-is">
  <bpmn:collaboration id="Collaboration_contractor-opr-as-is">
    <bpmn:participant id="Participant_Company" name="Предприятие / оценка производителя работ" processRef="Process_Company" />
    <bpmn:participant id="Participant_Octant" name="Система «Октант»" processRef="Process_Octant" />
    <bpmn:messageFlow id="Message_1" name="Загрузка подписанного файла" sourceRef="Upload" targetRef="OctStart" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Company" name="Оценка производителя работ — текущий процесс" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="Lane_Checker" name="Проверяющий (назначен по ОРД)">
        <bpmn:flowNodeRef>Print</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Critical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unsat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeEval</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sign</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Risk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Act</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeAct</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Send</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Window" name="Единое окно ПБиОТ">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Schedule</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Upload</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Необходимость проведения ОПР" />
    <bpmn:userTask id="Schedule" name="Сформировать график и назначить проверяющего" />
    <bpmn:manualTask id="Print" name="Распечатать утверждённый чек-лист" />
    <bpmn:manualTask id="Inspect" name="Проверить работы, заполнить пункты и примечания" />
    <bpmn:exclusiveGateway id="Critical" name="Нарушен блокирующий критерий?" />
    <bpmn:manualTask id="Unsat" name="Установить «неуд»" />
    <bpmn:manualTask id="Select" name="Определить «уд» / «неуд»" />
    <bpmn:exclusiveGateway id="MergeEval" />
    <bpmn:manualTask id="Sign" name="Подписать бумажный чек-лист" />
    <bpmn:exclusiveGateway id="Risk" name="Нужны акт и/или приостановка работ?" />
    <bpmn:manualTask id="Act" name="Оформить акт и/или приостановить работы" />
    <bpmn:exclusiveGateway id="MergeAct" />
    <bpmn:sendTask id="Send" name="Передать заполненный чек-лист в ПБиОТ" />
    <bpmn:userTask id="Upload" name="Разместить чек-лист в «Октанте» вручную" />
    <bpmn:endEvent id="End" name="Результат передан для учёта" />
    <bpmn:sequenceFlow id="Sequence_01" sourceRef="Start" targetRef="Schedule" />
    <bpmn:sequenceFlow id="Sequence_02" sourceRef="Schedule" targetRef="Print" />
    <bpmn:sequenceFlow id="Sequence_03" sourceRef="Print" targetRef="Inspect" />
    <bpmn:sequenceFlow id="Sequence_04" sourceRef="Inspect" targetRef="Critical" />
    <bpmn:sequenceFlow id="Sequence_05" name="Да" sourceRef="Critical" targetRef="Unsat" />
    <bpmn:sequenceFlow id="Sequence_06" name="Нет" sourceRef="Critical" targetRef="Select" />
    <bpmn:sequenceFlow id="Sequence_07" sourceRef="Unsat" targetRef="MergeEval" />
    <bpmn:sequenceFlow id="Sequence_08" sourceRef="Select" targetRef="MergeEval" />
    <bpmn:sequenceFlow id="Sequence_09" sourceRef="MergeEval" targetRef="Sign" />
    <bpmn:sequenceFlow id="Sequence_10" sourceRef="Sign" targetRef="Risk" />
    <bpmn:sequenceFlow id="Sequence_11" name="Да" sourceRef="Risk" targetRef="Act" />
    <bpmn:sequenceFlow id="Sequence_12" name="Нет" sourceRef="Risk" targetRef="MergeAct" />
    <bpmn:sequenceFlow id="Sequence_13" sourceRef="Act" targetRef="MergeAct" />
    <bpmn:sequenceFlow id="Sequence_14" sourceRef="MergeAct" targetRef="Send" />
    <bpmn:sequenceFlow id="Sequence_15" sourceRef="Send" targetRef="Upload" />
    <bpmn:sequenceFlow id="Sequence_16" sourceRef="Upload" targetRef="End" />
  </bpmn:process>
  <bpmn:process id="Process_Octant" name="Регистрация результата в Октант" isExecutable="false">
    <bpmn:startEvent id="OctStart" name="Получен чек-лист" />
    <bpmn:task id="OctStore" name="Доступен файл результата проверки" />
    <bpmn:sequenceFlow id="Sequence_17" sourceRef="OctStart" targetRef="OctStore" />
    <bpmn:sequenceFlow id="Sequence_18" sourceRef="OctStore" targetRef="OctEnd" />
    <bpmn:endEvent id="OctEnd" name="Результат сохранён" />
  </bpmn:process>
