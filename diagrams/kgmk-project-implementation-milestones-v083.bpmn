<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_impl083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-project-implementation-milestones-v083">
<bpmn:collaboration id="Collab_impl083"><bpmn:participant id="Part_impl083" name="Реализация проектов и подтверждение вех 0.8.3" processRef="Proc_impl083"/></bpmn:collaboration>
<bpmn:process id="Proc_impl083" name="Реализация проектов и подтверждение вех 0.8.3" isExecutable="false">
<bpmn:laneSet id="LS"><bpmn:lane id="L_ZGD" name="ЗГД ПБиОТ подразделения"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>DoStep</bpmn:flowNodeRef><bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>Rework</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_Admin" name="Администратор программы"><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>Load</bpmn:flowNodeRef><bpmn:flowNodeRef>Available</bpmn:flowNodeRef><bpmn:flowNodeRef>Evidence</bpmn:flowNodeRef><bpmn:flowNodeRef>Reported</bpmn:flowNodeRef><bpmn:flowNodeRef>Done</bpmn:flowNodeRef><bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>All</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S" name="Наступил этап реализации"/><bpmn:serviceTask id="Load" name="Показать одобренные проекты и план вех"/><bpmn:exclusiveGateway id="Available" name="Очередная веха доступна?"/><bpmn:userTask id="DoStep" name="Выполнить работы по вехе"/><bpmn:userTask id="Prepare" name="Добавить комментарий и подтверждающие файлы / фото"/><bpmn:exclusiveGateway id="Evidence" name="Комментарий и файл есть?"/><bpmn:serviceTask id="Reported" name="Передать веху на подтверждение"/><bpmn:userTask id="Review" name="Проверить отчёт по вехе"/><bpmn:exclusiveGateway id="Decision" name="Подтвердить веху?"/><bpmn:serviceTask id="Done" name="Зафиксировать веху как подтверждённую"/><bpmn:serviceTask id="Rejected" name="Зафиксировать отклонение и причину"/><bpmn:userTask id="Rework" name="Доработать веху и подготовить повторный отчёт"/><bpmn:exclusiveGateway id="All" name="Все вехи подтверждены?"/><bpmn:endEvent id="E" name="Проект реализован по подтверждённым вехам"/>
<bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Load"/><bpmn:sequenceFlow id="F2" sourceRef="Load" targetRef="Available"/><bpmn:sequenceFlow id="F3" sourceRef="Available" targetRef="DoStep" name="Да"/><bpmn:sequenceFlow id="F4" sourceRef="DoStep" targetRef="Prepare"/><bpmn:sequenceFlow id="F5" sourceRef="Prepare" targetRef="Evidence"/><bpmn:sequenceFlow id="F6" sourceRef="Evidence" targetRef="Prepare" name="Нет"/><bpmn:sequenceFlow id="F7" sourceRef="Evidence" targetRef="Reported" name="Да"/><bpmn:sequenceFlow id="F8" sourceRef="Reported" targetRef="Review"/><bpmn:sequenceFlow id="F9" sourceRef="Review" targetRef="Decision"/><bpmn:sequenceFlow id="F10" sourceRef="Decision" targetRef="Done" name="Да"/><bpmn:sequenceFlow id="F11" sourceRef="Decision" targetRef="Rejected" name="Нет"/><bpmn:sequenceFlow id="F12" sourceRef="Rejected" targetRef="Rework"/><bpmn:sequenceFlow id="F13" sourceRef="Rework" targetRef="Prepare" name="Повторный отчёт"/><bpmn:sequenceFlow id="F14" sourceRef="Done" targetRef="All"/><bpmn:sequenceFlow id="F15" sourceRef="All" targetRef="E" name="Да"/><bpmn:sequenceFlow id="F16" sourceRef="All" targetRef="Available" name="Нет — следующая веха"/>
<bpmn:textAnnotation id="Ann1"><bpmn:text>В прототипе следующая веха становится доступна, если предыдущая уже подтверждена ИЛИ только отправлена на подтверждение. Требуется бизнес-решение, должен ли запуск следующей вехи ждать одобрения администратора.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc1" sourceRef="Available" targetRef="Ann1"/><bpmn:textAnnotation id="Ann2"><bpmn:text>Плановые сроки вех считаются от даты одобрения заявки/проекта, при этом этап «Реализация» в интерфейсе начинается с декабря. Правило точки отсчёта требует подтверждения.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc2" sourceRef="Load" targetRef="Ann2"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="D"><bpmndi:BPMNPlane id="P" bpmnElement="Collab_impl083"><bpmndi:BPMNShape id="Part_di" bpmnElement="Part_impl083" isHorizontal="true"><dc:Bounds x="30" y="40" width="2700" height="540"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LZ_di" bpmnElement="L_ZGD" isHorizontal="true"><dc:Bounds x="60" y="40" width="2580" height="180"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LA_di" bpmnElement="L_Admin" isHorizontal="true"><dc:Bounds x="60" y="220" width="2580" height="180"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LS_di" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="60" y="400" width="2580" height="180"/></bpmndi:BPMNShape>
<bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="100" y="112" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Load_di" bpmnElement="Load"><dc:Bounds x="190" y="450" width="230" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Available_di" bpmnElement="Available" isMarkerVisible="true"><dc:Bounds x="470" y="465" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="DoStep_di" bpmnElement="DoStep"><dc:Bounds x="580" y="90" width="200" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Prepare_di" bpmnElement="Prepare"><dc:Bounds x="830" y="90" width="250" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Evidence_di" bpmnElement="Evidence" isMarkerVisible="true"><dc:Bounds x="1130" y="465" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Reported_di" bpmnElement="Reported"><dc:Bounds x="1240" y="450" width="220" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Review_di" bpmnElement="Review"><dc:Bounds x="1510" y="270" width="200" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Decision_di" bpmnElement="Decision" isMarkerVisible="true"><dc:Bounds x="1760" y="285" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Done_di" bpmnElement="Done"><dc:Bounds x="1870" y="430" width="230" height="70"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Rejected_di" bpmnElement="Rejected"><dc:Bounds x="1870" y="510" width="230" height="60"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Rework_di" bpmnElement="Rework"><dc:Bounds x="2150" y="90" width="240" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="All_di" bpmnElement="All" isMarkerVisible="true"><dc:Bounds x="2150" y="465" width="50" height="50"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="2440" y="472" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Ann1_di" bpmnElement="Ann1"><dc:Bounds x="400" y="610" width="500" height="110"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Ann2_di" bpmnElement="Ann2"><dc:Bounds x="950" y="610" width="480" height="100"/></bpmndi:BPMNShape>
<bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="130"/><di:waypoint x="163" y="130"/><di:waypoint x="163" y="490"/><di:waypoint x="190" y="490"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="420" y="490"/><di:waypoint x="470" y="490"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="520" y="490"/><di:waypoint x="550" y="490"/><di:waypoint x="550" y="130"/><di:waypoint x="580" y="130"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F4_di" bpmnElement="F4"><di:waypoint x="780" y="130"/><di:waypoint x="830" y="130"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F5_di" bpmnElement="F5"><di:waypoint x="1080" y="130"/><di:waypoint x="1105" y="130"/><di:waypoint x="1105" y="490"/><di:waypoint x="1130" y="490"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F6_di" bpmnElement="F6"><di:waypoint x="1155" y="465"/><di:waypoint x="1000" y="250"/><di:waypoint x="955" y="170"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F7_di" bpmnElement="F7"><di:waypoint x="1180" y="490"/><di:waypoint x="1240" y="490"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F8_di" bpmnElement="F8"><di:waypoint x="1460" y="490"/><di:waypoint x="1485" y="490"/><di:waypoint x="1485" y="310"/><di:waypoint x="1510" y="310"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F9_di" bpmnElement="F9"><di:waypoint x="1710" y="310"/><di:waypoint x="1760" y="310"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F10_di" bpmnElement="F10"><di:waypoint x="1810" y="310"/><di:waypoint x="1840" y="310"/><di:waypoint x="1840" y="465"/><di:waypoint x="1870" y="465"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F11_di" bpmnElement="F11"><di:waypoint x="1785" y="335"/><di:waypoint x="1827" y="530"/><di:waypoint x="1870" y="540"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F12_di" bpmnElement="F12"><di:waypoint x="2100" y="540"/><di:waypoint x="2125" y="540"/><di:waypoint x="2125" y="130"/><di:waypoint x="2150" y="130"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F13_di" bpmnElement="F13"><di:waypoint x="2390" y="1