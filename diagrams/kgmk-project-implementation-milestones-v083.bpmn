<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-project-implementation-milestones-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-project-implementation-milestones-v083">
  <bpmn:collaboration id="Collab_kgmk-project-implementation-milestones-v083"><bpmn:participant id="Part_kgmk-project-implementation-milestones-v083" name="Реализация проектов и подтверждение вех" processRef="Proc_kgmk-project-implementation-milestones-v083"/></bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-project-implementation-milestones-v083" name="Реализация проектов и подтверждение вех" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-project-implementation-milestones-v083"><bpmn:lane id="L_Customer" name="Заказчик БЕ (Заказчик подразделения)"><bpmn:flowNodeRef>DoStep</bpmn:flowNodeRef><bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>Rework</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_Admin" name="Администратор программы (ГО)"><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Reject</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>Load</bpmn:flowNodeRef><bpmn:flowNodeRef>MilestoneMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Determine</bpmn:flowNodeRef><bpmn:flowNodeRef>Available</bpmn:flowNodeRef><bpmn:flowNodeRef>NoAvailable</bpmn:flowNodeRef><bpmn:flowNodeRef>NeedDeadlineChange</bpmn:flowNodeRef><bpmn:flowNodeRef>ChangeDeadline</bpmn:flowNodeRef><bpmn:flowNodeRef>DeadlineMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>ReportMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Complete</bpmn:flowNodeRef><bpmn:flowNodeRef>Reported</bpmn:flowNodeRef><bpmn:flowNodeRef>Fork</bpmn:flowNodeRef><bpmn:flowNodeRef>Done</bpmn:flowNodeRef><bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckAll</bpmn:flowNodeRef><bpmn:flowNodeRef>All</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckNext</bpmn:flowNodeRef><bpmn:flowNodeRef>NextGate</bpmn:flowNodeRef><bpmn:flowNodeRef>OpenNext</bpmn:flowNodeRef><bpmn:flowNodeRef>NextOpenEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>NextClosedEnd</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="S" name="Одобренный проект доступен в реализации"/><bpmn:serviceTask id="Load" name="Показать план и состояния вех проекта"/><bpmn:exclusiveGateway id="MilestoneMerge" name="Перейти к очередной вехе"/><bpmn:businessRuleTask id="Determine" name="Определить доступность очередной вехи"/><bpmn:exclusiveGateway id="Available" name="Веха доступна?"/><bpmn:endEvent id="NoAvailable" name="Нет доступной вехи"/><bpmn:exclusiveGateway id="NeedDeadlineChange" name="Требуется изменить / перенести срок?"/><bpmn:callActivity id="ChangeDeadline" name="Изменить / перенести срок вехи" calledElement="Proc_kgmk-milestone-deadline-change-v083"/><bpmn:exclusiveGateway id="DeadlineMerge" name="Продолжить реализацию вехи"/><bpmn:userTask id="DoStep" name="Выполнить работы по вехе"/><bpmn:exclusiveGateway id="ReportMerge" name="Подготовить или доработать отчёт"/><bpmn:userTask id="Prepare" name="Добавить комментарий и подтверждающие материалы"/><bpmn:businessRuleTask id="Validate" name="Проверить комплектность отчёта"/><bpmn:exclusiveGateway id="Complete" name="Отчёт комплектен?"/><bpmn:serviceTask id="Reported" name="Зафиксировать «Ждёт подтверждения»"/><bpmn:parallelGateway id="Fork" name="После отправки отчёта"/><bpmn:userTask id="Review" name="Проверить отчёт по вехе"/><bpmn:exclusiveGateway id="Decision" name="Подтвердить веху?"/><bpmn:serviceTask id="Done" name="Зафиксировать «Подтверждено»"/><bpmn:userTask id="Reject" name="Отклонить веху и указать причину"/><bpmn:serviceTask id="Rejected" name="Зафиксировать «На доработку»"/><bpmn:userTask id="Rework" name="Доработать веху"/><bpmn:businessRuleTask id="CheckAll" name="Проверить, подтверждены ли все вехи"/><bpmn:exclusiveGateway id="All" name="Все вехи подтверждены?"/><bpmn:endEvent id="E" name="Проект выполнен по подтверждённым вехам"/><bpmn:businessRuleTask id="CheckNext" name="Проверить открытие следующей вехи при ожидании"/><bpmn:exclusiveGateway id="NextGate" name="Следующая веха открывается?"/><bpmn:serviceTask id="OpenNext" name="Открыть следующую веху до решения администратора"/><bpmn:endEvent id="NextOpenEnd" name="Следующая веха доступна"/><bpmn:endEvent id="NextClosedEnd" name="Следующая веха пока недоступна"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Load"/><bpmn:sequenceFlow id="F2" sourceRef="Load" targetRef="MilestoneMerge"/><bpmn:sequenceFlow id="F3" sourceRef="MilestoneMerge" targetRef="Determine"/><bpmn:sequenceFlow id="F4" sourceRef="Determine" targetRef="Available"/><bpmn:sequenceFlow id="F5" sourceRef="Available" targetRef="NeedDeadlineChange" name="Да"/><bpmn:sequenceFlow id="F6" sourceRef="Available" targetRef="NoAvailable" name="Нет"/><bpmn:sequenceFlow id="F7" sourceRef="NeedDeadlineChange" targetRef="ChangeDeadline" name="Да"/><bpmn:sequenceFlow id="F8" sourceRef="NeedDeadlineChange" targetRef="DeadlineMerge" name="Нет"/><bpmn:sequenceFlow id="F9" sourceRef="ChangeDeadline" targetRef="DeadlineMerge"/><bpmn:sequenceFlow id="F10" sourceRef="DeadlineMerge" targetRef="DoStep"/><bpmn:sequenceFlow id="F11" sourceRef="DoStep" targetRef="ReportMerge"/><bpmn:sequenceFlow id="F12" sourceRef="ReportMerge" targetRef="Prepare"/><bpmn:sequenceFlow id="F13" sourceRef="Prepare" targetRef="Validate"/><bpmn:sequenceFlow id="F14" sourceRef="Validate" targetRef="Complete"/><bpmn:sequenceFlow id="F15" sourceRef="Complete" targetRef="Reported" name="Да"/><bpmn:sequenceFlow id="F16" sourceRef="Complete" targetRef="ReportMerge" name="Нет"/><bpmn:sequenceFlow id="F17" sourceRef="Reported" targetRef="Fork"/><bpmn:sequenceFlow id="F18" sourceRef="Fork" targetRef="Review" name="Проверка администратором"/><bpmn:sequenceFlow id="F19" sourceRef="Fork" targetRef="CheckNext" name="Проверка следующей вехи"/><bpmn:sequenceFlow id="F20" sourceRef="Review" targetRef="Decision"/><bpmn:sequenceFlow id="F21" sourceRef="Decision" targetRef="Done" name="Да"/><bpmn:sequenceFlow id="F22" sourceRef="Decision" targetRef="Reject" name="Нет"/><bpmn:sequenceFlow id="F23" sourceRef="Reject" targetRef="Rejected"/><bpmn:sequenceFlow id="F24" sourceRef="Rejected" targetRef="Rework"/><bpmn:sequenceFlow id="F25" sourceRef="Rework" targetRef="ReportMerge"/><bpmn:sequenceFlow id="F26" sourceRef="Done" targetRef="CheckAll"/><bpmn:sequenceFlow id="F27" sourceRef="CheckAll" targetRef="All"/><bpmn:sequenceFlow id="F28" sourceRef="All" targetRef="E" name="Да"/><bpmn:sequenceFlow id="F29" sourceRef="All" targetRef="MilestoneMerge" name="Нет — следующая веха"/><bpmn:sequenceFlow id="F30" sourceRef="CheckNext" targetRef="NextGate"/><bpmn:sequenceFlow id="F31" sourceRef="NextGate" targetRef="OpenNext" name="Да"/><bpmn:sequenceFlow id="F32" sourceRef="NextGate" targetRef="NextClosedEnd" name="Нет"/><bpmn:sequenceFlow id="F33" sourceRef="OpenNext" targetRef="NextOpenEnd"/>
    <bpmn:textAnnotation id="AnnDeadline"><bpmn:text>Подтверждено заказчиком: в процессе реализации должен существовать механизм изменения / переноса плановых сроков вех. Кто инициирует изменение, требуется ли согласование, обязательна ли причина, как перенос влияет на последующие вехи и должна ли храниться история изменений — определить.</bpmn:text></bpmn:textAnnotation><bpmn:association id="AssocDeadline" sourceRef="ChangeDeadline" targetRef="AnnDeadline"/><bpmn:textAnnotation id="AnnSequence"><bpmn:text>Сохраняется наблюдаемое правило 0.8.3: следующая веха может открываться уже при статусе предыдущей «Ждёт подтверждения». Целевое правило последовательности остаётся открытым вопросом.</bpmn:text></bpmn:textAnnotation><bpmn:association id="AssocSequence" sourceRef="CheckNext" targetRef="AnnSequence"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_kgmk-project-implementation-milestones-v083"><bpmndi:BPMNPlane id="Plane_kgmk-project-implementation-milestones-v083" bpmnElement="Collab_kgmk-project-implementation-milestones-v083"><bpmndi:BPMNShape id="Part_kgmk-project-implementation-milestones-v083_di" bpmnElement="Part_kgmk-project-implementation-milestones-v083" isHorizontal="true"><dc:Bounds x="30" y="40" width="4800" height="800"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_Customer_di" bpmnElement="L_Customer" isHorizontal="true"><dc:Bounds x="60" y="40" width="4680" height="260"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_Admin_di" bpmnElement="L_Admin" isHorizontal="true"><dc:Bounds x="60" y="300" width="4680" height="240"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_System_di" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="60" y="540" width="4680" height="300"/></bpmndi:BPMNShape>
