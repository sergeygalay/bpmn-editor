<bpmn:collaboration id="Collab_kgmk-project-implementation-milestones-v083"><bpmn:participant id="Part_kgmk-project-implementation-milestones-v083" name="Реализация проектов и подтверждение вех 0.8.3" processRef="Proc_kgmk-project-implementation-milestones-v083"/></bpmn:collaboration>
<bpmn:process id="Proc_kgmk-project-implementation-milestones-v083" name="Реализация проектов и подтверждение вех 0.8.3" isExecutable="false"><bpmn:laneSet id="LaneSet_kgmk-project-implementation-milestones-v083"><bpmn:lane id="L_ZGD" name="ЗГД ПБиОТ подразделения"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>DoStep</bpmn:flowNodeRef><bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>Rework</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_Admin" name="Администратор программы"><bpmn:flowNodeRef>Review</bpmn:flowNodeRef><bpmn:flowNodeRef>Decision</bpmn:flowNodeRef><bpmn:flowNodeRef>Reject</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>Load</bpmn:flowNodeRef><bpmn:flowNodeRef>MilestoneMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Determine</bpmn:flowNodeRef><bpmn:flowNodeRef>Available</bpmn:flowNodeRef><bpmn:flowNodeRef>NoAvailable</bpmn:flowNodeRef><bpmn:flowNodeRef>ReportMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Validate</bpmn:flowNodeRef><bpmn:flowNodeRef>Complete</bpmn:flowNodeRef><bpmn:flowNodeRef>Reported</bpmn:flowNodeRef><bpmn:flowNodeRef>Fork</bpmn:flowNodeRef><bpmn:flowNodeRef>Done</bpmn:flowNodeRef><bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckAll</bpmn:flowNodeRef><bpmn:flowNodeRef>All</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef><bpmn:flowNodeRef>CheckNext</bpmn:flowNodeRef><bpmn:flowNodeRef>NextGate</bpmn:flowNodeRef><bpmn:flowNodeRef>OpenNext</bpmn:flowNodeRef><bpmn:flowNodeRef>NextOpenEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>NextClosedEnd</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S" name="Одобренный проект доступен в реализации"/><bpmn:serviceTask id="Load" name="Показать план и состояния вех проекта"/><bpmn:exclusiveGateway id="MilestoneMerge" name="Перейти к очередной вехе"/><bpmn:businessRuleTask id="Determine" name="Определить доступность очередной вехи"/><bpmn:exclusiveGateway id="Available" name="Веха доступна?"/><bpmn:endEvent id="NoAvailable" name="Нет доступной вехи"/><bpmn:userTask id="DoStep" name="Выполнить работы по вехе"/><bpmn:exclusiveGateway id="ReportMerge" name="Подготовить или доработать отчёт"/><bpmn:userTask id="Prepare" name="Добавить комментарий и подтверждающие материалы"/><bpmn:businessRuleTask id="Validate" name="Проверить комплектность отчёта"/><bpmn:exclusiveGateway id="Complete" name="Отчёт комплектен?"/><bpmn:serviceTask id="Reported" name="Зафиксировать «Ждёт подтверждения»"/><bpmn:parallelGateway id="Fork" name="После отправки отчёта"/><bpmn:userTask id="Review" name="Проверить отчёт по вехе"/><bpmn:exclusiveGateway id="Decision" name="Подтвердить веху?"/><bpmn:serviceTask id="Done" name="Зафиксировать «Подтверждено»"/><bpmn:userTask id="Reject" name="Отклонить веху и указать причину"/><bpmn:serviceTask id="Rejected" name="Зафиксировать «На доработку»"/><bpmn:userTask id="Rework" name="Доработать веху"/><bpmn:businessRuleTask id="CheckAll" name="Проверить, подтверждены ли все вехи"/><bpmn:exclusiveGateway id="All" name="Все вехи подтверждены?"/><bpmn:endEvent id="E" name="Проект выполнен по подтверждённым вехам"/><bpmn:businessRuleTask id="CheckNext" name="Проверить открытие следующей вехи при ожидании"/><bpmn:exclusiveGateway id="NextGate" name="Следующая веха открывается?"/><bpmn:serviceTask id="OpenNext" name="Открыть следующую веху до решения администратора"/><bpmn:endEvent id="NextOpenEnd" name="Следующая веха доступна"/><bpmn:endEvent id="NextClosedEnd" name="Следующая веха пока недоступна"/>
<bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Load"/><bpmn:sequenceFlow id="F2" sourceRef="Load" targetRef="MilestoneMerge"/><bpmn:sequenceFlow id="F3" sourceRef="MilestoneMerge" targetRef="Determine"/><bpmn:sequenceFlow id="F4" sourceRef="Determine" targetRef="Available"/><bpmn:sequenceFlow id="F5" sourceRef="Available" targetRef="DoStep" name="Да"/><bpmn:sequenceFlow id="F6" sourceRef="Available" targetRef="NoAvailable" name="Нет"/><bpmn:sequenceFlow id="F7" sourceRef="DoStep" targetRef="ReportMerge"/><bpmn:sequenceFlow id="F8" sourceRef="ReportMerge" targetRef="Prepare"/><bpmn:sequenceFlow id="F9" sourceRef="Prepare" targetRef="Validate"/><bpmn:sequenceFlow id="F10" sourceRef="Validate" targetRef="Complete"/><bpmn:sequenceFlow id="F11" sourceRef="Complete" targetRef="Reported" name="Да"/><bpmn:sequenceFlow id="F12" sourceRef="Complete" targetRef="ReportMerge" name="Нет"/><bpmn:sequenceFlow id="F13" sourceRef="Reported" targetRef="Fork"/><bpmn:sequenceFlow id="F14" sourceRef="Fork" targetRef="Review" name="Проверка администратором"/><bpmn:sequenceFlow id="F15" sourceRef="Fork" targetRef="CheckNext" name="Проверка следующей вехи"/><bpmn:sequenceFlow id="F16" sourceRef="Review" targetRef="Decision"/><bpmn:sequenceFlow id="F17" sourceRef="Decision" targetRef="Done" name="Да"/><bpmn:sequenceFlow id="F18" sourceRef="Decision" targetRef="Reject" name="Нет"/><bpmn:sequenceFlow id="F19" sourceRef="Reject" targetRef="Rejected"/><bpmn:sequenceFlow id="F20" sourceRef="Rejected" targetRef="Rework"/><bpmn:sequenceFlow id="F21" sourceRef="Rework" targetRef="ReportMerge"/><bpmn:sequenceFlow id="F22" sourceRef="Done" targetRef="CheckAll"/><bpmn:sequenceFlow id="F23" sourceRef="CheckAll" targetRef="All"/><bpmn:sequenceFlow id="F24" sourceRef="All" targetRef="E" name="Да"/><bpmn:sequenceFlow id="F25" sourceRef="All" targetRef="MilestoneMerge" name="Нет"/><bpmn:sequenceFlow id="F26" sourceRef="CheckNext" targetRef="NextGate"/><bpmn:sequenceFlow id="F27" sourceRef="NextGate" targetRef="OpenNext" name="Да"/><bpmn:sequenceFlow id="F28" sourceRef="NextGate" targetRef="NextClosedEnd" name="Нет"/><bpmn:sequenceFlow id="F29" sourceRef="OpenNext" targetRef="NextOpenEnd"/>
<bpmn:textAnnotation id="AnnI"><bpmn:text>Факт 0.8.3: следующая веха может открываться уже при статусе предыдущей «Ждёт подтверждения». Эта параллельная ветка показана отдельно; целевое бизнес-правило последовательности не определено.</bpmn:text></bpmn:textAnnotation><bpmn:association id="AssocI" sourceRef="CheckNext" targetRef="AnnI"/></bpmn:process>
