<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-project-implementation-milestones-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-project-implementation-milestones-v083">
  <bpmn:collaboration id="Collab_kgmk-project-implementation-milestones-v083">
    <bpmn:participant id="Part_kgmk-project-implementation-milestones-v083" name="Реализация проектов и подтверждение вех" processRef="Proc_kgmk-project-implementation-milestones-v083" />
    <bpmn:textAnnotation id="AnnDeadline">
      <bpmn:text>Подтверждено заказчиком: в процессе реализации должен существовать механизм изменения / переноса плановых сроков вех. Кто инициирует изменение, требуется ли согласование, обязательна ли причина, как перенос влияет на последующие вехи и должна ли храниться история изменений — определить.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AssocDeadline" sourceRef="ChangeDeadline" targetRef="AnnDeadline" />
    <bpmn:textAnnotation id="AnnSequence">
      <bpmn:text>Сохраняется наблюдаемое правило 0.8.3: следующая веха может открываться уже при статусе предыдущей «Ждёт подтверждения». Целевое правило последовательности остаётся открытым вопросом.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AssocSequence" sourceRef="CheckNext" targetRef="AnnSequence" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-project-implementation-milestones-v083" name="Реализация проектов и подтверждение вех" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-project-implementation-milestones-v083">
      <bpmn:lane id="L_Customer" name="Заказчик БЕ (Заказчик подразделения)">
        <bpmn:flowNodeRef>DoStep</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rework</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Admin" name="Администратор программы (ГО)">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reject</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_System" name="Программа «Культура безопасности»">
        <bpmn:flowNodeRef>Load</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MilestoneMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Determine</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Available</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NeedDeadlineChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ChangeDeadline</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>DeadlineMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReportMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Validate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reported</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckNext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NextGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoAvailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenNext</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NextOpenEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NextClosedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>All</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rejected</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Load" name="Показать план и состояния вех проекта" />
    <bpmn:exclusiveGateway id="MilestoneMerge" name="Перейти к очередной вехе" />
    <bpmn:businessRuleTask id="Determine" name="Определить доступность очередной вехи" />
    <bpmn:exclusiveGateway id="Available" name="Веха доступна?" />
    <bpmn:exclusiveGateway id="NeedDeadlineChange" name="Требуется изменить / перенести срок?" />
    <bpmn:callActivity id="ChangeDeadline" name="Изменить / перенести срок вехи" calledElement="Proc_kgmk-milestone-deadline-change-v083" />
    <bpmn:exclusiveGateway id="DeadlineMerge" name="Продолжить реализацию вехи" />
    <bpmn:userTask id="DoStep" name="Выполнить работы по вехе" />
    <bpmn:exclusiveGateway id="ReportMerge" name="Подготовить или доработать отчёт" />
    <bpmn:userTask id="Prepare" name="Добавить комментарий и подтверждающие материалы" />
    <bpmn:businessRuleTask id="Validate" name="Проверить комплектность отчёта" />
    <bpmn:exclusiveGateway id="Complete" name="Отчёт комплектен?" />
    <bpmn:serviceTask id="Reported" name="Зафиксировать «Ждёт подтверждения»" />
    <bpmn:parallelGateway id="Fork" name="После отправки отчёта" />
    <bpmn:userTask id="Review" name="Проверить отчёт по вехе" />
    <bpmn:exclusiveGateway id="Decision" name="Подтвердить веху?" />
    <bpmn:userTask id="Rework" name="Доработать веху" />
    <bpmn:businessRuleTask id="CheckNext" name="Проверить открытие следующей вехи при ожидании" />
    <bpmn:exclusiveGateway id="NextGate" name="Следующая веха открывается?" />
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Load" />
    <bpmn:sequenceFlow id="F2" sourceRef="Load" targetRef="MilestoneMerge" />
    <bpmn:sequenceFlow id="F3" sourceRef="MilestoneMerge" targetRef="Determine" />
    <bpmn:sequenceFlow id="F4" sourceRef="Determine" targetRef="Available" />
    <bpmn:sequenceFlow id="F5" name="Да" sourceRef="Available" targetRef="NeedDeadlineChange" />
    <bpmn:sequenceFlow id="F6" name="Нет" sourceRef="Available" targetRef="NoAvailable" />
    <bpmn:sequenceFlow id="F7" name="Да" sourceRef="NeedDeadlineChange" targetRef="ChangeDeadline" />
    <bpmn:sequenceFlow id="F8" name="Нет" sourceRef="NeedDeadlineChange" targetRef="DeadlineMerge" />
    <bpmn:sequenceFlow id="F9" sourceRef="ChangeDeadline" targetRef="DeadlineMerge" />
    <bpmn:sequenceFlow id="F10" sourceRef="DeadlineMerge" targetRef="DoStep" />
    <bpmn:sequenceFlow id="F11" sourceRef="DoStep" targetRef="ReportMerge" />
    <bpmn:sequenceFlow id="F12" sourceRef="ReportMerge" targetRef="Prepare" />
    <bpmn:sequenceFlow id="F13" sourceRef="Prepare" targetRef="Validate" />
    <bpmn:sequenceFlow id="F14" sourceRef="Validate" targetRef="Complete" />
    <bpmn:sequenceFlow id="F15" name="Да" sourceRef="Complete" targetRef="Reported" />
    <bpmn:sequenceFlow id="F16" name="Нет" sourceRef="Complete" targetRef="ReportMerge" />
    <bpmn:sequenceFlow id="F17" sourceRef="Reported" targetRef="Fork" />
    <bpmn:sequenceFlow id="F18" name="Проверка администратором" sourceRef="Fork" targetRef="Review" />
    <bpmn:sequenceFlow id="F19" name="Проверка следующей вехи" sourceRef="Fork" targetRef="CheckNext" />
    <bpmn:sequenceFlow id="F20" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="F21" name="Да" sourceRef="Decision" targetRef="Done" />
    <bpmn:sequenceFlow id="F22" name="Нет" sourceRef="Decision" targetRef="Reject" />
    <bpmn:sequenceFlow id="F23" sourceRef="Reject" targetRef="Rejected" />
    <bpmn:sequenceFlow id="F24" sourceRef="Rejected" targetRef="Rework" />
    <bpmn:sequenceFlow id="F25" sourceRef="Rework" targetRef="ReportMerge" />
    <bpmn:sequenceFlow id="F26" sourceRef="Done" targetRef="CheckAll" />
    <bpmn:sequenceFlow id="F27" sourceRef="CheckAll" targetRef="All" />
    <bpmn:sequenceFlow id="F28" name="Да" sourceRef="All" targetRef="E" />
    <bpmn:sequenceFlow id="F29" name="Нет — следующая веха" sourceRef="All" targetRef="MilestoneMerge" />
    <bpmn:sequenceFlow id="F30" sourceRef="CheckNext" targetRef="NextGate" />
    <bpmn:sequenceFlow id="F31" name="Да" sourceRef="NextGate" targetRef="OpenNext" />
    <bpmn:sequenceFlow id="F32" name="Нет" sourceRef="NextGate" targetRef="NextClosedEnd" />
    <bpmn:sequenceFlow id="F33" sourceRef="OpenNext" targetRef="NextOpenEnd" />
    <bpmn:startEvent id="S" name="Одобренный проект доступен в реализации" />
    <bpmn:endEvent id="NoAvailable" name="Нет доступной вехи" />
    <bpmn:userTask id="Reject" name="Отклонить веху и указать причину" />
    <bpmn:serviceTask id="OpenNext" name="Открыть следующую веху до решения администратора" />
    <bpmn:endEvent id="NextOpenEnd" name="Следующая веха доступна" />
    <bpmn:endEvent id="NextClosedEnd" name="Следующая веха пока недоступна" />
    <bpmn:serviceTask id="Done" name="Зафиксировать «Подтверждено»" />
    <bpmn:businessRuleTask id="CheckAll" name="Проверить, подтверждены ли все вехи" />
    <bpmn:exclusiveGateway id="All" name="Все вехи подтверждены?" />
    <bpmn:serviceTask id="Rejected" name="Зафиксировать «На доработку»" />
    <bpmn:endEvent id="E" name="Проект выполнен по подтверждённым вехам" />
  </bpmn:process>
