<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-milestone-deadline-change-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-milestone-deadline-change-v083">
  <bpmn:collaboration id="Collab_kgmk-milestone-deadline-change-v083"><bpmn:participant id="Part_kgmk-milestone-deadline-change-v083" name="Изменение / перенос срока вехи проекта" processRef="Proc_kgmk-milestone-deadline-change-v083"/></bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-milestone-deadline-change-v083" name="Изменение / перенос срока вехи проекта" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-milestone-deadline-change-v083"><bpmn:lane id="L_Actor" name="Уполномоченный участник — определить"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>Change</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>Apply</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="S" name="Возникла необходимость изменить / перенести срок вехи"/><bpmn:userTask id="Change" name="Задать изменение планового срока вехи"/><bpmn:serviceTask id="Apply" name="Зафиксировать изменённый плановый срок вехи"/><bpmn:endEvent id="E" name="Новый плановый срок зафиксирован"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Change"/><bpmn:sequenceFlow id="F2" sourceRef="Change" targetRef="Apply"/><bpmn:sequenceFlow id="F3" sourceRef="Apply" targetRef="E"/>
    <bpmn:textAnnotation id="AnnOpen"><bpmn:text>Подтверждено заказчиком только наличие механизма изменения / переноса срока вехи. Не определены: кто может инициировать изменение, требуется ли согласование, обязательна ли причина, допустимые пределы переноса, влияние на сроки последующих вех и необходимость хранения истории изменений.</bpmn:text></bpmn:textAnnotation><bpmn:association id="AssocOpen" sourceRef="Change" targetRef="AnnOpen"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_kgmk-milestone-deadline-change-v083"><bpmndi:BPMNPlane id="Plane_kgmk-milestone-deadline-change-v083" bpmnElement="Collab_kgmk-milestone-deadline-change-v083"><bpmndi:BPMNShape id="Part_di" bpmnElement="Part_kgmk-milestone-deadline-change-v083" isHorizontal="true"><dc:Bounds x="30" y="40" width="1150" height="420"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_Actor_di" bpmnElement="L_Actor" isHorizontal="true"><dc:Bounds x="60" y="40" width="1030" height="200"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="L_System_di" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="60" y="240" width="1030" height="220"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="S_di" bpmnElement="S"><dc:Bounds x="100" y="112" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Change_di" bpmnElement="Change"><dc:Bounds x="200" y="90" width="280" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="Apply_di" bpmnElement="Apply"><dc:Bounds x="550" y="300" width="300" height="80"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="E_di" bpmnElement="E"><dc:Bounds x="930" y="322" width="36" height="36"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="AnnOpen_di" bpmnElement="AnnOpen"><dc:Bounds x="250" y="490" width="700" height="100"/></bpmndi:BPMNShape><bpmndi:BPMNEdge id="F1_di" bpmnElement="F1"><di:waypoint x="136" y="130"/><di:waypoint x="200" y="130"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F2_di" bpmnElement="F2"><di:waypoint x="480" y="130"/><di:waypoint x="515" y="130"/><di:waypoint x="515" y="340"/><di:waypoint x="550" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="F3_di" bpmnElement="F3"><di:waypoint x="850" y="340"/><di:waypoint x="930" y="340"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="AssocOpen_di" bpmnElement="AssocOpen"><di:waypoint x="340" y="170"/><di:waypoint x="600" y="490"/></bpmndi:BPMNEdge></bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>