<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-safety-culture-program-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-safety-culture-program-v083">
  <bpmn:collaboration id="Collab_kgmk-safety-culture-program-v083">
    <bpmn:participant id="Part_kgmk-safety-culture-program-v083" name="Культура безопасности — сквозной бизнес-процесс 0.8.3" processRef="Proc_kgmk-safety-culture-program-v083" />
    <bpmn:textAnnotation id="AnnL1">
      <bpmn:text>Глобальный процесс начинается с наступления нового цикла программы, а не с действия отдельного сотрудника. Массовая оценка сотрудников и публикация официального замера — самостоятельные процессы. Прототип не определяет, должен ли этап «Магазин проектов» ожидать завершения массового опроса; подтверждена зависимость каталога от официального уровня БЕ.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AssocL1" sourceRef="AssessFork" targetRef="AnnL1" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-safety-culture-program-v083" name="Культура безопасности — сквозной бизнес-процесс 0.8.3" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-safety-culture-program-v083">
      <bpmn:lane id="L_System" name="Программа «Культура безопасности»">
        <bpmn:flowNodeRef>OpenStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectionMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ValidateSelection</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ApproveProjects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>OpenExecution</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MilestoneMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>CheckAll</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllDone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Finish</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AssessFork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectionValid</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Employee" name="Сотрудники БЕ">
        <bpmn:flowNodeRef>CollectPulse</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>PulseEnd</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Corp" name="Корпоративный ПБиОТ">
        <bpmn:flowNodeRef>PublishOfficial</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_ZGD" name="ЗГД ПБиОТ подразделения">
        <bpmn:flowNodeRef>SelectProjects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubmitRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ImplementReport</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Rework</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Admin" name="Администратор программы">
        <bpmn:flowNodeRef>ReviewRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReqDecision</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ReviewMilestone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MilestoneDecision</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:callActivity id="CollectPulse" name="Собрать пульс культуры сотрудников" calledElement="Proc_kgmk-culture-pulse-assessment-v083">
      <bpmn:multiInstanceLoopCharacteristics />
    </bpmn:callActivity>
    <bpmn:callActivity id="PublishOfficial" name="Опубликовать официальный годовой замер" calledElement="Proc_kgmk-official-culture-assessment-v083" />
    <bpmn:intermediateCatchEvent id="OpenStore" name="Наступил этап «Магазин проектов»">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="SelectionMerge" />
    <bpmn:userTask id="SelectProjects" name="Выбрать проекты своего подразделения" />
    <bpmn:businessRuleTask id="ValidateSelection" name="Проверить права и допустимость выбранных проектов" />
    <bpmn:userTask id="SubmitRequest" name="Отправить заявку на одобрение" />
    <bpmn:userTask id="ReviewRequest" name="Рассмотреть заявку" />
    <bpmn:exclusiveGateway id="ReqDecision" name="Заявка одобрена?" />
    <bpmn:endEvent id="RejectedEnd" name="Заявка отклонена; проекты не переданы в реализацию" />
    <bpmn:serviceTask id="ApproveProjects" name="Зафиксировать одобрение и передать проекты в реализацию" />
    <bpmn:intermediateCatchEvent id="OpenExecution" name="Наступил этап «Реализация»">
      <bpmn:timerEventDefinition />
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="MilestoneMerge" />
    <bpmn:userTask id="ImplementReport" name="Выполнить очередную веху и отправить отчёт" />
    <bpmn:userTask id="ReviewMilestone" name="Проверить отчёт по вехе" />
    <bpmn:exclusiveGateway id="MilestoneDecision" name="Веха подтверждена?" />
    <bpmn:userTask id="Rework" name="Доработать отклонённую веху" />
    <bpmn:businessRuleTask id="CheckAll" name="Проверить, подтверждены ли все вехи проекта" />
    <bpmn:exclusiveGateway id="AllDone" name="Все вехи подтверждены?" />
    <bpmn:endEvent id="Finish" name="Проект реализован по подтверждённым вехам" />
    <bpmn:endEvent id="PulseEnd" name="Сбор пульса сотрудников завершён" />
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="AssessFork" />
    <bpmn:sequenceFlow id="F2" name="Пульс сотрудников" sourceRef="AssessFork" targetRef="CollectPulse" />
    <bpmn:sequenceFlow id="F3" name="Официальный замер" sourceRef="AssessFork" targetRef="PublishOfficial" />
    <bpmn:sequenceFlow id="F4" sourceRef="CollectPulse" targetRef="PulseEnd" />
    <bpmn:sequenceFlow id="F5" name="Официальный уровень БЕ зафиксирован?" sourceRef="PublishOfficial" targetRef="OpenStore" />
    <bpmn:sequenceFlow id="F7" sourceRef="OpenStore" targetRef="SelectionMerge" />
    <bpmn:sequenceFlow id="F8" sourceRef="SelectionMerge" targetRef="SelectProjects" />
    <bpmn:sequenceFlow id="F9" sourceRef="SelectProjects" targetRef="ValidateSelection" />
    <bpmn:sequenceFlow id="F10" sourceRef="ValidateSelection" targetRef="SelectionValid" />
    <bpmn:sequenceFlow id="F11" name="Да" sourceRef="SelectionValid" targetRef="SubmitRequest" />
    <bpmn:sequenceFlow id="F12" name="Нет — скорректировать выбор" sourceRef="SelectionValid" targetRef="SelectionMerge" />
    <bpmn:sequenceFlow id="F13" sourceRef="SubmitRequest" targetRef="ReviewRequest" />
    <bpmn:sequenceFlow id="F14" sourceRef="ReviewRequest" targetRef="ReqDecision" />
    <bpmn:sequenceFlow id="F15" name="Да" sourceRef="ReqDecision" targetRef="ApproveProjects" />
    <bpmn:sequenceFlow id="F16" name="Нет" sourceRef="ReqDecision" targetRef="RejectedEnd" />
    <bpmn:sequenceFlow id="F17" sourceRef="ApproveProjects" targetRef="OpenExecution" />
    <bpmn:sequenceFlow id="F18" sourceRef="OpenExecution" targetRef="MilestoneMerge" />
    <bpmn:sequenceFlow id="F19" sourceRef="MilestoneMerge" targetRef="ImplementReport" />
    <bpmn:sequenceFlow id="F20" sourceRef="ImplementReport" targetRef="ReviewMilestone" />
    <bpmn:sequenceFlow id="F21" sourceRef="ReviewMilestone" targetRef="MilestoneDecision" />
    <bpmn:sequenceFlow id="F22" name="Да" sourceRef="MilestoneDecision" targetRef="CheckAll" />
    <bpmn:sequenceFlow id="F23" name="Нет" sourceRef="MilestoneDecision" targetRef="Rework" />
    <bpmn:sequenceFlow id="F24" name="Повторный отчёт" sourceRef="Rework" targetRef="MilestoneMerge" />
    <bpmn:sequenceFlow id="F25" sourceRef="CheckAll" targetRef="AllDone" />
    <bpmn:sequenceFlow id="F26" name="Да" sourceRef="AllDone" targetRef="Finish" />
    <bpmn:sequenceFlow id="F27" name="Нет — следующая веха" sourceRef="AllDone" targetRef="MilestoneMerge" />
    <bpmn:startEvent id="Start" name="Наступил новый цикл программы">
      <bpmn:timerEventDefinition />
    </bpmn:startEvent>
    <bpmn:parallelGateway id="AssessFork" name="Запустить этап оценки" />
    <bpmn:exclusiveGateway id="SelectionValid" name="Заявка допустима?" />
  </bpmn:process>
