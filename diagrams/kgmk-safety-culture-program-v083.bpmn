<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-safety-culture-program-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-safety-culture-program-v083">
  <bpmn:collaboration id="Collab_kgmk-safety-culture-program-v083"><bpmn:participant id="Part_kgmk-safety-culture-program-v083" name="Культура безопасности — полный бизнес-цикл 0.8.3" processRef="Proc_kgmk-safety-culture-program-v083"/></bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-safety-culture-program-v083" name="Культура безопасности — полный бизнес-цикл 0.8.3" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-safety-culture-program-v083">
      <bpmn:lane id="L_Employee" name="Сотрудник / участник оценки"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>TakeSurvey</bpmn:flowNodeRef><bpmn:flowNodeRef>SurveyValid</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Corp" name="Корпоративный ПБиОТ"><bpmn:flowNodeRef>PublishOfficial</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_ZGD" name="ЗГД ПБиОТ подразделения"><bpmn:flowNodeRef>SelectProjects</bpmn:flowNodeRef><bpmn:flowNodeRef>SubmitRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>Implement</bpmn:flowNodeRef><bpmn:flowNodeRef>ReportMilestone</bpmn:flowNodeRef><bpmn:flowNodeRef>Rework</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Admin" name="Администратор программы"><bpmn:flowNodeRef>ReviewRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>ReqApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>ReviewMilestone</bpmn:flowNodeRef><bpmn:flowNodeRef>MilestoneApproved</bpmn:flowNodeRef><bpmn:flowNodeRef>AllDone</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_System" name="Программа «Культура безопасности» / Магазин проектов"><bpmn:flowNodeRef>ShowLevel</bpmn:flowNodeRef><bpmn:flowNodeRef>OpenStore</bpmn:flowNodeRef><bpmn:flowNodeRef>OpenExecution</bpmn:flowNodeRef><bpmn:flowNodeRef>Finish</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Открыт цикл программы"/>
    <bpmn:userTask id="TakeSurvey" name="Пройти оценку культуры"/>
    <bpmn:exclusiveGateway id="SurveyValid" name="Бланк учитывается в пульсе?"/>
    <bpmn:userTask id="PublishOfficial" name="Зафиксировать официальный годовой замер по БЕ"/>
    <bpmn:serviceTask id="ShowLevel" name="Показать официальный уровень и допустимые инициативы"/>
    <bpmn:intermediateCatchEvent id="OpenStore" name="Наступил этап магазина"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="SelectProjects" name="Выбрать проекты своего подразделения"/>
    <bpmn:userTask id="SubmitRequest" name="Отправить заявку администратору"/>
    <bpmn:userTask id="ReviewRequest" name="Рассмотреть заявку"/>
    <bpmn:exclusiveGateway id="ReqApproved" name="Заявка одобрена?"/>
    <bpmn:intermediateCatchEvent id="OpenExecution" name="Наступил этап реализации"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Implement" name="Выполнить очередную веху проекта"/>
    <bpmn:userTask id="ReportMilestone" name="Отчитаться по вехе с подтверждением"/>
    <bpmn:userTask id="ReviewMilestone" name="Проверить отчёт по вехе"/>
    <bpmn:exclusiveGateway id="MilestoneApproved" name="Веха подтверждена?"/>
    <bpmn:userTask id="Rework" name="Доработать отклонённую веху"/>
    <bpmn:exclusiveGateway id="AllDone" name="Все вехи проекта подтверждены?"/>
    <bpmn:endEvent id="Finish" name="Реализация подтверждена"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="TakeSurvey"/>
    <bpmn:sequenceFlow id="F2" sourceRef="TakeSurvey" targetRef="SurveyValid"/>
    <bpmn:sequenceFlow id="F3" sourceRef="SurveyValid" targetRef="PublishOfficial" name="Пульс используется как дополнительный результат"/>
    <bpmn:sequenceFlow id="F4" sourceRef="PublishOfficial" targetRef="ShowLevel"/>
    <bpmn:sequenceFlow id="F5" sourceRef="ShowLevel" targetRef="OpenStore"/>
    <bpmn:sequenceFlow id="F6" sourceRef="OpenStore" targetRef="SelectProjects"/>
    <bpmn:sequenceFlow id="F7" sourceRef="SelectProjects" targetRef="SubmitRequest"/>
    <bpmn:sequenceFlow id="F8" sourceRef="SubmitRequest" targetRef="ReviewRequest"/>
    <bpmn:sequenceFlow id="F9" sourceRef="ReviewRequest" targetRef="ReqApproved"/>
    <bpmn:sequenceFlow id="F10" sourceRef="ReqApproved" targetRef="OpenExecution" name="Да"/>
    <bpmn:sequenceFlow id="F11" sourceRef="ReqApproved" targetRef="SelectProjects" name="Нет / заявка отклонена"/>
    <bpmn:sequenceFlow id="F12" sourceRef="OpenExecution" targetRef="Implement"/>
    <bpmn:sequenceFlow id="F13" sourceRef="Implement" targetRef="ReportMilestone"/>
    <bpmn:sequenceFlow id="F14" sourceRef="ReportMilestone" targetRef="ReviewMilestone"/>
    <bpmn:sequenceFlow id="F15" sourceRef="ReviewMilestone" targetRef="MilestoneApproved"/>
    <bpmn:sequenceFlow id="F16" sourceRef="MilestoneApproved" targetRef="AllDone" name="Да"/>
    <bpmn:sequenceFlow id="F17" sourceRef="MilestoneApproved" targetRef="Rework" name="Нет"/>
    <bpmn:sequenceFlow id="F18" sourceRef="Rework" targetRef="ReportMilestone" name="Повторный отчёт"/>
    <bpmn:sequenceFlow id="F19" sourceRef="AllDone" targetRef="Finish" name="Да"/>
    <bpmn:sequenceFlow id="F20" sourceRef="AllDone" targetRef="Implement" name="Нет — следующая веха"/>
    <bpmn:textAnnotation id="AnnL1"><bpmn:text>Официальный уровень, используемый магазином, задаётся годовым замером. Пульс сотрудников отображается рядом, но не заменяет официальный уровень в текущем прототипе.</bpmn:text></bpmn:textAnnotation>
    <bpmn:association id="Assoc_AnnL1" sourceRef="SurveyValid" targetRef="AnnL1"/>
  </bpmn:process>
