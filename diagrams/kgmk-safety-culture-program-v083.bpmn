<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-safety-culture-program-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-safety-culture-program-v083">
  <bpmn:collaboration id="Collab_kgmk-safety-culture-program-v083">
    <bpmn:participant id="Part_kgmk-safety-culture-program-v083" name="Культура безопасности — сквозной бизнес-процесс" processRef="Proc_kgmk-safety-culture-program-v083"/>
  </bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-safety-culture-program-v083" name="Культура безопасности — сквозной бизнес-процесс" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-safety-culture-program-v083">
      <bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>Start</bpmn:flowNodeRef><bpmn:flowNodeRef>AssessFork</bpmn:flowNodeRef><bpmn:flowNodeRef>OpenStore</bpmn:flowNodeRef><bpmn:flowNodeRef>SelectionMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>ValidateSelection</bpmn:flowNodeRef><bpmn:flowNodeRef>SelectionValid</bpmn:flowNodeRef><bpmn:flowNodeRef>Pending</bpmn:flowNodeRef><bpmn:flowNodeRef>ApproveProjects</bpmn:flowNodeRef><bpmn:flowNodeRef>SetRework</bpmn:flowNodeRef><bpmn:flowNodeRef>ReworkTimeout</bpmn:flowNodeRef><bpmn:flowNodeRef>CloseRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>ClosedEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>TimeoutRecord</bpmn:flowNodeRef><bpmn:flowNodeRef>TimeoutEnd</bpmn:flowNodeRef><bpmn:flowNodeRef>OpenExecution</bpmn:flowNodeRef><bpmn:flowNodeRef>Finish</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Employee" name="Сотрудники БЕ"><bpmn:flowNodeRef>CollectPulse</bpmn:flowNodeRef><bpmn:flowNodeRef>PulseEnd</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Customer" name="Заказчик БЕ (Заказчик подразделения)"><bpmn:flowNodeRef>SelectProjects</bpmn:flowNodeRef><bpmn:flowNodeRef>SubmitRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>InitiatorDecisionTask</bpmn:flowNodeRef><bpmn:flowNodeRef>InitiatorDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>ReviseRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>Implement</bpmn:flowNodeRef></bpmn:lane>
      <bpmn:lane id="L_Admin" name="Администратор программы (ГО)"><bpmn:flowNodeRef>PublishOfficial</bpmn:flowNodeRef><bpmn:flowNodeRef>ReviewRequest</bpmn:flowNodeRef><bpmn:flowNodeRef>ReqDecision</bpmn:flowNodeRef><bpmn:flowNodeRef>RejectComment</bpmn:flowNodeRef></bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Наступил новый цикл программы"><bpmn:timerEventDefinition/></bpmn:startEvent>
    <bpmn:parallelGateway id="AssessFork" name="Запустить этап оценки"/>
    <bpmn:callActivity id="CollectPulse" name="Провести массовую оценку культуры сотрудников" calledElement="Proc_kgmk-culture-pulse-assessment-v083"><bpmn:multiInstanceLoopCharacteristics/></bpmn:callActivity>
    <bpmn:endEvent id="PulseEnd" name="Пульс БЕ сформирован"/>
    <bpmn:callActivity id="PublishOfficial" name="Опубликовать официальный годовой замер" calledElement="Proc_kgmk-official-culture-assessment-v083"/>
    <bpmn:intermediateCatchEvent id="OpenStore" name="Наступил этап «Магазин проектов»"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="SelectionMerge" name="Перейти к формированию заявки"/>
    <bpmn:userTask id="SelectProjects" name="Сформировать набор проектов подразделения"/>
    <bpmn:businessRuleTask id="ValidateSelection" name="Проверить права и допустимость выбранных проектов"/>
    <bpmn:exclusiveGateway id="SelectionValid" name="Заявка допустима?"/>
    <bpmn:userTask id="SubmitRequest" name="Отправить заявку на согласование"/>
    <bpmn:serviceTask id="Pending" name="Зафиксировать статус «На одобрении»"/>
    <bpmn:userTask id="ReviewRequest" name="Рассмотреть заявку"/>
    <bpmn:exclusiveGateway id="ReqDecision" name="Заявка одобрена?"/>
    <bpmn:serviceTask id="ApproveProjects" name="Зафиксировать одобрение"/>
    <bpmn:userTask id="RejectComment" name="Отклонить заявку и указать обязательный комментарий"/>
    <bpmn:serviceTask id="SetRework" name="Перевести заявку в «На доработке», запустить тайм-аут и открыть чат/комментарии"/>
    <bpmn:userTask id="InitiatorDecisionTask" name="Обсудить замечания и решить: доработать или закрыть заявку"/>
    <bpmn:boundaryEvent id="ReworkTimeout" name="Истёк тайм-аут доработки" attachedToRef="InitiatorDecisionTask"><bpmn:timerEventDefinition/></bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="InitiatorDecision" name="Решение Заказчика БЕ?"/>
    <bpmn:userTask id="ReviseRequest" name="Доработать заявку с учётом комментариев"/>
    <bpmn:serviceTask id="CloseRequest" name="Закрыть заявку по решению Заказчика БЕ"/>
    <bpmn:endEvent id="ClosedEnd" name="Заявка закрыта инициатором"/>
    <bpmn:serviceTask id="TimeoutRecord" name="Зафиксировать истечение тайм-аута доработки"/>
    <bpmn:endEvent id="TimeoutEnd" name="Действие по истечении тайм-аута — определить"/>
    <bpmn:intermediateCatchEvent id="OpenExecution" name="Наступил этап «Реализация»"><bpmn:timerEventDefinition/></bpmn:intermediateCatchEvent>
    <bpmn:callActivity id="Implement" name="Реализовать одобренные проекты по вехам" calledElement="Proc_kgmk-project-implementation-milestones-v083"/>
    <bpmn:endEvent id="Finish" name="Проекты реализованы по подтверждённым вехам"/>
    <bpmn:sequenceFlow id="F1" sourceRef="Start" targetRef="AssessFork"/><bpmn:sequenceFlow id="F2" sourceRef="AssessFork" targetRef="CollectPulse" name="Пульс сотрудников"/><bpmn:sequenceFlow id="F3" sourceRef="AssessFork" targetRef="PublishOfficial" name="Официальный замер"/><bpmn:sequenceFlow id="F4" sourceRef="CollectPulse" targetRef="PulseEnd"/><bpmn:sequenceFlow id="F5" sourceRef="PublishOfficial" targetRef="OpenStore"/><bpmn:sequenceFlow id="F6" sourceRef="OpenStore" targetRef="SelectionMerge"/><bpmn:sequenceFlow id="F7" sourceRef="SelectionMerge" targetRef="SelectProjects"/><bpmn:sequenceFlow id="F8" sourceRef="SelectProjects" targetRef="ValidateSelection"/><bpmn:sequenceFlow id="F9" sourceRef="ValidateSelection" targetRef="SelectionValid"/><bpmn:sequenceFlow id="F10" sourceRef="SelectionValid" targetRef="SubmitRequest" name="Да"/><bpmn:sequenceFlow id="F11" sourceRef="SelectionValid" targetRef="SelectionMerge" name="Нет — скорректировать"/><bpmn:sequenceFlow id="F12" sourceRef="SubmitRequest" targetRef="Pending"/><bpmn:sequenceFlow id="F13" sourceRef="Pending" targetRef="ReviewRequest"/><bpmn:sequenceFlow id="F14" sourceRef="ReviewRequest" targetRef="ReqDecision"/><bpmn:sequenceFlow id="F15" sourceRef="ReqDecision" targetRef="ApproveProjects" name="Да"/><bpmn:sequenceFlow id="F16" sourceRef="ReqDecision" targetRef="RejectComment" name="Нет"/><bpmn:sequenceFlow id="F17" sourceRef="ApproveProjects" targetRef="OpenExecution"/><bpmn:sequenceFlow id="F18" sourceRef="OpenExecution" targetRef="Implement"/><bpmn:sequenceFlow id="F19" sourceRef="Implement" targetRef="Finish"/><bpmn:sequenceFlow id="F20" sourceRef="RejectComment" targetRef="SetRework"/><bpmn:sequenceFlow id="F21" sourceRef="SetRework" targetRef="InitiatorDecisionTask"/><bpmn:sequenceFlow id="F22" sourceRef="InitiatorDecisionTask" targetRef="InitiatorDecision"/><bpmn:sequenceFlow id="F23" sourceRef="InitiatorDecision" targetRef="ReviseRequest" name="Доработать"/><bpmn:sequenceFlow id="F24" sourceRef="InitiatorDecision" targetRef="CloseRequest" name="Закрыть"/><bpmn:sequenceFlow id="F25" sourceRef="ReviseRequest" targetRef="SelectionMerge" name="Повторная подача"/><bpmn:sequenceFlow id="F26" sourceRef="CloseRequest" targetRef="ClosedEnd"/><bpmn:sequenceFlow id="F27" sourceRef="ReworkTimeout" targetRef="TimeoutRecord"/><bpmn:sequenceFlow id="F28" sourceRef="TimeoutRecord" targetRef="TimeoutEnd"/>
    <bpmn:textAnnotation id="AnnTop"><bpmn:text>Подтверждено заказчиком: функции «Корпоративного ПБиОТ» выполняет Администратор программы (ГО); инициатором заявки является Заказчик БЕ. При отклонении администратор обязан оставить комментарий, а решение о доработке или закрытии принимает Заказчик БЕ через чат/комментарии. Значение тайм-аута и действие после его истечения не определены.</bpmn:text></bpmn:textAnnotation><bpmn:association id="AssocTop" sourceRef="RejectComment" targetRef="AnnTop"/>
  </bpmn:process>
