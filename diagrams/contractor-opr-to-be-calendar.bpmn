<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-to-be-calendar" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be-calendar">
<bpmn:collaboration id="Collaboration_contractor-opr-to-be-calendar">
<bpmn:participant id="Participant_Window" name="Единое окно" processRef="Process_Window"/>
<bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker"/>
<bpmn:participant id="Participant_App" name="Суперника" processRef="Process_App"/>
<bpmn:participant id="Participant_Octant" name="Октант" processRef="Process_Octant"/>
<bpmn:messageFlow id="Message_2" name="Организация проверки (порядок уточняется)" sourceRef="WindowOrganize" targetRef="OctStart"/>
<bpmn:messageFlow id="Message_1" name="Календарь и назначения (изучить)" sourceRef="SendInfo" targetRef="Receive"/>
<bpmn:messageFlow id="Message_3" name="Назначенная проверка" sourceRef="List" targetRef="CheckerStart"/>
<bpmn:messageFlow id="Message_4" name="Выбранная проверка" sourceRef="Open" targetRef="AppWaitOpen"/>
<bpmn:messageFlow id="Message_5" name="Контрольный лист" sourceRef="Form" targetRef="Fill"/>
<bpmn:messageFlow id="Message_6" name="Заполненный контрольный лист" sourceRef="Record" targetRef="AppWaitResult"/>
<bpmn:messageFlow id="Message_7" name="Форма из «Октанта» (концепция)" sourceRef="SendForm" targetRef="Form"/>
</bpmn:collaboration>
<bpmn:process id="Process_Window" name="Единое окно" isExecutable="false">
<bpmn:startEvent id="WindowStart" name="Нужно провести проверку"/>
<bpmn:userTask id="WindowOrganize" name="Организовать проверку вне «Суперники»"/>
<bpmn:endEvent id="WindowEnd" name="Проверка организована"/>
<bpmn:sequenceFlow id="Flow_Window_1" sourceRef="WindowStart" targetRef="WindowOrganize"/>
<bpmn:sequenceFlow id="Flow_Window_2" sourceRef="WindowOrganize" targetRef="WindowEnd"/>
</bpmn:process>
<bpmn:process id="Process_Checker" name="Проверяющий" isExecutable="false">
<bpmn:startEvent id="CheckerStart" name="Есть назначенная проверка"/>
<bpmn:userTask id="Open" name="Открыть назначенную проверку"/>
<bpmn:userTask id="Fill" name="Заполнить контрольный лист"/>
<bpmn:userTask id="Record" name="Зафиксировать результат"/>
<bpmn:endEvent id="CheckerEnd" name="Проверка завершена"/>
<bpmn:sequenceFlow id="Flow_Checker_1" sourceRef="CheckerStart" targetRef="Open"/>
<bpmn:sequenceFlow id="Flow_5" sourceRef="Open" targetRef="Fill"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Fill" targetRef="Record"/>
<bpmn:sequenceFlow id="Flow_Checker_2" sourceRef="Record" targetRef="CheckerEnd"/>
</bpmn:process>
<bpmn:process id="Process_App" name="Суперника" isExecutable="false">
<bpmn:startEvent id="Start" name="Доступны запланированные проверки"/>
<bpmn:receiveTask id="Receive" name="Получить календарь и назначения (изучить)"/>
<bpmn:task id="List" name="Показать назначенные проверки"/>
<bpmn:receiveTask id="AppWaitOpen" name="Получить выбор проверки"/>
<bpmn:task id="Form" name="Предоставить соответствующий лист"/>
<bpmn:receiveTask id="AppWaitResult" name="Получить заполненный лист"/>
<bpmn:task id="Save" name="Сохранить результат"/>
<bpmn:endEvent id="End" name="Результат зафиксирован"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Receive"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Receive" targetRef="List"/>
<bpmn:sequenceFlow id="Flow_App_Choice" sourceRef="List" targetRef="AppWaitOpen"/>
<bpmn:sequenceFlow id="Flow_App_Form" sourceRef="AppWaitOpen" targetRef="Form"/>
<bpmn:sequenceFlow id="Flow_App_Result" sourceRef="Form" targetRef="AppWaitResult"/>
<bpmn:sequenceFlow id="Flow_App_Save" sourceRef="AppWaitResult" targetRef="Save"/>
<bpmn:sequenceFlow id="Flow_8" sourceRef="Save" targetRef="End"/>
</bpmn:process>
<bpmn:process id="Process_Octant" name="Октант" isExecutable="false">
<bpmn:startEvent id="OctStart" name="Нужно запланировать проверку"/>
<bpmn:userTask id="Assign" name="Запланировать и назначить проверяющего"/>
<bpmn:sendTask id="SendInfo" name="Предоставить календарь и назначения"/>
<bpmn:sendTask id="SendForm" name="Предоставить форму (концепция)"/>
<bpmn:endEvent id="OctEnd" name="Сведения предоставлены"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="OctStart" targetRef="Assign"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="Assign" targetRef="SendInfo"/>
<bpmn:sequenceFlow id="Flow_Oct_Form" sourceRef="SendInfo" targetRef="SendForm"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="SendForm" targetRef="OctEnd"/>
</bpmn:process>
