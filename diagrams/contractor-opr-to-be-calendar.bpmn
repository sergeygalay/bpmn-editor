<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_contractor-opr-to-be-calendar" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be-calendar">
<bpmn:collaboration id="Collaboration_contractor-opr-to-be-calendar">
<bpmn:participant id="Participant_Company" name="Предприятие / проведение проверки" processRef="Process_Company"/>
<bpmn:participant id="Participant_Octant" name="Октант" processRef="Process_Octant"/>
<bpmn:messageFlow id="Message_1" name="Календарь и назначения — возможность требует изучения" sourceRef="SendInfo" targetRef="Receive"/>
</bpmn:collaboration>
<bpmn:process id="Process_Company" name="Рейтинг подрядчиков — TO-BE развитие: работа по календарю Октанта" isExecutable="false">
<bpmn:laneSet id="LaneSet_Company">
<bpmn:lane id="Lane_Checker" name="Проверяющий">
<bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Fill</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Record</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_App" name="Суперника">
<bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Receive</bpmn:flowNodeRef>
<bpmn:flowNodeRef>List</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Form</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
<bpmn:flowNodeRef>End</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Проверка запланирована" />
<bpmn:receiveTask id="Receive" name="Получить календарь и сведения о назначениях (требует изучения)" />
<bpmn:task id="List" name="Предоставить список назначенных проверок" />
<bpmn:userTask id="Open" name="Открыть назначенную проверку" />
<bpmn:task id="Form" name="Предоставить соответствующий контрольный лист" />
<bpmn:userTask id="Fill" name="Заполнить контрольный лист" />
<bpmn:userTask id="Record" name="Зафиксировать результат" />
<bpmn:task id="Save" name="Сохранить результат проверки" />
<bpmn:endEvent id="End" name="Результат зафиксирован" />
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Receive" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Receive" targetRef="List" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="List" targetRef="Open" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Open" targetRef="Form" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Form" targetRef="Fill" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Fill" targetRef="Record" />
<bpmn:sequenceFlow id="Flow_7" sourceRef="Record" targetRef="Save" />
<bpmn:sequenceFlow id="Flow_8" sourceRef="Save" targetRef="End" />
</bpmn:process>
<bpmn:process id="Process_Octant" name="Организация проверок и назначений в Октант (требует изучения)" isExecutable="false">
<bpmn:startEvent id="OctStart" name="Планирование проверки" />
<bpmn:userTask id="Assign" name="Запланировать проверку и назначить сотрудника" />
<bpmn:sendTask id="SendInfo" name="Предоставить сведения о проверках и сотрудниках" />
<bpmn:endEvent id="OctEnd" name="Сведения предоставлены" />
<bpmn:sequenceFlow id="Flow_9" sourceRef="OctStart" targetRef="Assign" />
<bpmn:sequenceFlow id="Flow_10" sourceRef="Assign" targetRef="SendInfo" />
<bpmn:sequenceFlow id="Flow_11" sourceRef="SendInfo" targetRef="OctEnd" />
</bpmn:process>
