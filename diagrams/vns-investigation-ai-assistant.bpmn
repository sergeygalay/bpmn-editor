<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AIAssistant" targetNamespace="https://sergeygalay.github.io/bpmn-editor/vns-investigation-ai-assistant">
  <bpmn:collaboration id="Collaboration_AIAssistant"><bpmn:participant id="Participant_AIAssistant" name="Процесс ИИ-помощника" processRef="Process_AIAssistant"/></bpmn:collaboration>
  <bpmn:process id="Process_AIAssistant" isExecutable="false">
    <bpmn:laneSet id="LaneSet_AI"><bpmn:lane id="Lane_AI" name="ИИ-помощник">
      <bpmn:flowNodeRef>StartEvent_AI</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Process</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Facts</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Timeline</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_WaitInitial</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProposeHyp</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeAnalysis</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Match</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Gaps</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Enough</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Missing</bpmn:flowNodeRef><bpmn:flowNodeRef>Event_WaitMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ProcessMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RCA</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Actions</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_AI</bpmn:flowNodeRef>
    </bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_AI" name="Материалы дела загружены"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:serviceTask id="Task_Process" name="Обработать загруженные материалы"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Facts" name="Извлечь кандидатные факты и связать с источниками"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Timeline" name="Построить временную шкалу"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_WaitInitial" name="Первоначальные гипотезы комиссии зафиксированы"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing><bpmn:messageEventDefinition id="MessageEventDefinition_Initial"/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ProposeHyp" name="Предложить дополнительные гипотезы"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_MergeAnalysis" gatewayDirection="Converging"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:incoming>Flow_13</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Match" name="Сопоставить гипотезы с фактами"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Gaps" name="Выявить противоречия и недостающие доказательства"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_Enough" name="Данных достаточно?" gatewayDirection="Diverging"><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_10</bpmn:outgoing><bpmn:outgoing>Flow_14</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_Missing" name="Сформировать перечень недостающих доказательств"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_WaitMore" name="Новые материалы загружены"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing><bpmn:messageEventDefinition id="MessageEventDefinition_More"/></bpmn:intermediateCatchEvent>
    <bpmn:serviceTask id="Task_ProcessMore" name="Обработать новые материалы и обновить факты / шкалу"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RCA" name="Поддержать RCA и варианты причинной цепочки"><bpmn:incoming>Flow_14</bpmn:incoming><bpmn:outgoing>Flow_15</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Actions" name="Предложить корректирующие мероприятия"><bpmn:incoming>Flow_15</bpmn:incoming><bpmn:outgoing>Flow_16</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="Task_Report" name="Сформировать проект итогового отчета"><bpmn:incoming>Flow_16</bpmn:incoming><bpmn:outgoing>Flow_17</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_AI" name="Проект отчета сформирован"><bpmn:incoming>Flow_17</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_AI" targetRef="Task_Process"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Process" targetRef="Task_Facts"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Task_Facts" targetRef="Task_Timeline"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Task_Timeline" targetRef="Event_WaitInitial"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Event_WaitInitial" targetRef="Task_ProposeHyp"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Task_ProposeHyp" targetRef="Gateway_MergeAnalysis"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Gateway_MergeAnalysis" targetRef="Task_Match"/><bpmn:sequenceFlow id="Flow_8" sourceRef="Task_Match" targetRef="Task_Gaps"/><bpmn:sequenceFlow id="Flow_9" sourceRef="Task_Gaps" targetRef="Gateway_Enough"/><bpmn:sequenceFlow id="Flow_10" name="Нет" sourceRef="Gateway_Enough" targetRef="Task_Missing"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Task_Missing" targetRef="Event_WaitMore"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Event_WaitMore" targetRef="Task_ProcessMore"/><bpmn:sequenceFlow id="Flow_13" name="Повторный анализ" sourceRef="Task_ProcessMore" targetRef="Gateway_MergeAnalysis"/><bpmn:sequenceFlow id="Flow_14" name="Да" sourceRef="Gateway_Enough" targetRef="Task_RCA"/><bpmn:sequenceFlow id="Flow_15" sourceRef="Task_RCA" targetRef="Task_Actions"/><bpmn:sequenceFlow id="Flow_16" sourceRef="Task_Actions" targetRef="Task_Report"/><bpmn:sequenceFlow id="Flow_17" sourceRef="Task_Report" targetRef="EndEvent_AI"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_AI"><bpmndi:BPMNPlane id="BPMNPlane_AI" bpmnElement="Collaboration_AIAssistant">
    <bpmndi:BPMNShape id="Shape_Participant_AI" bpmnElement="Participant_AIAssistant" isHorizontal="true"><dc:Bounds x="40" y="70" width="2750" height="400"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_AI" bpmnElement="Lane_AI" isHorizontal="true"><dc:Bounds x="70" y="70" width="2720" height="400"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Start_AI" bpmnElement="StartEvent_AI"><dc:Bounds x="100" y="190" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Process" bpmnElement="Task_Process"><dc:Bounds x="165" y="160" width="155" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Facts" bpmnElement="Task_Facts"><dc:Bounds x="350" y="155" width="180" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Timeline" bpmnElement="Task_Timeline"><dc:Bounds x="560" y="160" width="150" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_WaitInitial" bpmnElement="Event_WaitInitial"><dc:Bounds x="745" y="182" width="45" height="45"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ProposeHyp" bpmnElement="Task_ProposeHyp"><dc:Bounds x="825" y="160" width="165" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_MergeAnalysis" bpmnElement="Gateway_MergeAnalysis" isMarkerVisible="true"><dc:Bounds x="1025" y="180" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Match" bpmnElement="Task_Match"><dc:Bounds x="1110" y="160" width="160" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Gaps" bpmnElement="Task_Gaps"><dc:Bounds x="1305" y="155" width="190" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Enough" bpmnElement="Gateway_Enough" isMarkerVisible="true"><dc:Bounds x="1530" y="175" width="60" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Missing" bpmnElement="Task_Missing"><dc:Bounds x="1470" y="315" width="200" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_WaitMore" bpmnElement="Event_WaitMore"><dc:Bounds x="1360" y="330" width="45" height="45"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ProcessMore" bpmnElement="Task_ProcessMore"><dc:Bounds x="1120" y="315" width="205" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_RCA" bpmnElement="Task_RCA"><dc:Bounds x="1630" y="160" width="180" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Actions" bpmnElement="Task_Actions"><dc:Bounds x="1840" y="160" width="180" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Report" bpmnElement="Task_Report"><dc:Bounds x="2050" y="160" width="180" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_AI" bpmnElement="EndEvent_AI"><dc:Bounds x="2280" y="190" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="136" y="208"/><di:waypoint x="165" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="320" y="205"/><di:waypoint x="350" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="530" y="205"/><di:waypoint x="560" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="710" y="205"/><di:waypoint x="745" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="790" y="205"/><di:waypoint x="825" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="990" y="205"/><di:waypoint x="1025" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7"><di:waypoint x="1075" y="205"/><di:waypoint x="1110" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8"><di:waypoint x="1270" y="205"/><di:waypoint x="1305" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9"><di:waypoint x="1495" y="205"/><di:waypoint x="1530" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10"><di:waypoint x="1560" y="235"/><di:waypoint x="1560" y="315"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11"><di:waypoint x="1470" y="352"/><di:waypoint x="1405" y="352"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_12" bpmnElement="Flow_12"><di:waypoint x="1360" y="352"/><di:waypoint x="1325" y="352"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_13" bpmnElement="Flow_13"><di:waypoint x="1120" y="352"/><di:waypoint x="1050" y="352"/><di:waypoint x="1050" y="230"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_14" bpmnElement="Flow_14"><di:waypoint x="1590" y="205"/><di:waypoint x="1630" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_15" bpmnElement="Flow_15"><di:waypoint x="1810" y="205"/><di:waypoint x="1840" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_16" bpmnElement="Flow_16"><di:waypoint x="2020" y="205"/><di:waypoint x="2050" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_17" bpmnElement="Flow_17"><di:waypoint x="2230" y="205"/><di:waypoint x="2280" y="205"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
