<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BIO_TOBE_MVP" targetNamespace="https://sergeygalay.github.io/bpmn-editor/bio-antimotivation-to-be-c">
  <bpmn:collaboration id="Collaboration_BIO_TOBE_MVP">
    <bpmn:participant id="Participant_BIO_TOBE_MVP" name="БИО — MVP: сезонная модель и общий Топ" processRef="Process_BIO_TOBE_MVP" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BIO_TOBE_MVP" name="TO-BE MVP — сезонная геймификация с единым корпоративным рейтингом" isExecutable="false">
    <bpmn:laneSet id="LaneSet_TOBE_MVP">
      <bpmn:lane id="Lane_User_TOBE_MVP" name="Пользователь">
        <bpmn:flowNodeRef>Task_ViewSeasonResult_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NewSeason_TOBE</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System_TOBE_MVP" name="Система БИО / сезонная геймификация">
        <bpmn:flowNodeRef>Task_NotifySeason_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_StartNewSeason_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ResetSeason_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ArchiveSeason_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SaveAchievement_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixTop_TOBE</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_SeasonEnd_TOBE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:sequenceFlow id="F_TOBE_26" sourceRef="Task_NotifySeason_TOBE" targetRef="Task_ViewSeasonResult_TOBE" />
    <bpmn:sequenceFlow id="F_TOBE_27" sourceRef="Task_ViewSeasonResult_TOBE" targetRef="End_NewSeason_TOBE" />
    <bpmn:sendTask id="Task_NotifySeason_TOBE" name="Показать итоги прошлого сезона и старт нового" />
    <bpmn:serviceTask id="Task_StartNewSeason_TOBE" name="Создать новый сезон и пустой общий Топ" />
    <bpmn:serviceTask id="Task_ResetSeason_TOBE" name="Обнулить сезонные баллы и сезонный рейтинг" />
    <bpmn:serviceTask id="Task_ArchiveSeason_TOBE" name="Сохранить историю завершенного сезона" />
    <bpmn:serviceTask id="Task_SaveAchievement_TOBE" name="Сохранить итог / цифровое достижение пользователя" />
    <bpmn:serviceTask id="Task_FixTop_TOBE" name="Зафиксировать итоговый единый Топ пользователей сезона" />
    <bpmn:startEvent id="Start_SeasonEnd_TOBE" name="Наступило завершение сезона">
      <bpmn:timerEventDefinition id="Timer_SeasonEnd_TOBE" />
    </bpmn:startEvent>
    <bpmn:sequenceFlow id="F_TOBE_25" sourceRef="Task_StartNewSeason_TOBE" targetRef="Task_NotifySeason_TOBE" />
    <bpmn:sequenceFlow id="F_TOBE_24" sourceRef="Task_ResetSeason_TOBE" targetRef="Task_StartNewSeason_TOBE" />
    <bpmn:sequenceFlow id="F_TOBE_23" sourceRef="Task_ArchiveSeason_TOBE" targetRef="Task_ResetSeason_TOBE" />
    <bpmn:sequenceFlow id="F_TOBE_22" sourceRef="Task_SaveAchievement_TOBE" targetRef="Task_ArchiveSeason_TOBE" />
    <bpmn:sequenceFlow id="F_TOBE_21" sourceRef="Task_FixTop_TOBE" targetRef="Task_SaveAchievement_TOBE" />
    <bpmn:sequenceFlow id="F_TOBE_20" sourceRef="Start_SeasonEnd_TOBE" targetRef="Task_FixTop_TOBE" />
    <bpmn:userTask id="Task_ViewSeasonResult_TOBE" name="Ознакомиться с итогом сезона и сохраненным достижением" />
    <bpmn:endEvent id="End_NewSeason_TOBE" name="Новый сезон начат" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_TOBE_MVP">
    <bpmndi:BPMNPlane id="Plane_TOBE_MVP" bpmnElement="Collaboration_BIO_TOBE_MVP">
      <bpmndi:BPMNShape id="Participant_BIO_TOBE_MVP_di" bpmnElement="Participant_BIO_TOBE_MVP" isHorizontal="true">
        <dc:Bounds x="40" y="150" width="2156" height="380" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_TOBE_MVP_di" bpmnElement="Lane_System_TOBE_MVP" isHorizontal="true">
        <dc:Bounds x="70" y="345" width="2126" height="185" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_TOBE_MVP_di" bpmnElement="Lane_User_TOBE_MVP" isHorizontal="true">
        <dc:Bounds x="70" y="150" width="2126" height="195" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifySeason_TOBE_di" bpmnElement="Task_NotifySeason_TOBE">
        <dc:Bounds x="1550" y="400" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_StartNewSeason_TOBE_di" bpmnElement="Task_StartNewSeason_TOBE">
        <dc:Bounds x="1280" y="400" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ResetSeason_TOBE_di" bpmnElement="Task_ResetSeason_TOBE">
        <dc:Bounds x="1010" y="400" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ArchiveSeason_TOBE_di" bpmnElement="Task_ArchiveSeason_TOBE">
        <dc:Bounds x="760" y="400" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_SaveAchievement_TOBE_di" bpmnElement="Task_SaveAchievement_TOBE">
        <dc:Bounds x="480" y="400" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FixTop_TOBE_di" bpmnElement="Task_FixTop_TOBE">
        <dc:Bounds x="210" y="400" width="210" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_SeasonEnd_TOBE_di" bpmnElement="Start_SeasonEnd_TOBE">
        <dc:Bounds x="120" y="425" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="107" y="461" width="63" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ViewSeasonResult_TOBE_di" bpmnElement="Task_ViewSeasonResult_TOBE">
        <dc:Bounds x="1830" y="205" width="240" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NewSeason_TOBE_di" bpmnElement="End_NewSeason_TOBE">
        <dc:Bounds x="2140" y="222" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2125" y="258" width="66" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_TOBE_26_di" bpmnElement="F_TOBE_26">
        <di:waypoint x="1655" y="400" />
        <di:waypoint x="1655" y="240" />
        <di:waypoint x="1830" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TOBE_27_di" bpmnElement="F_TOBE_27">
        <di:waypoint x="2070" y="240" />
        <di:waypoint x="2140" y="240" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TOBE_25_di" bpmnElement="F_TOBE_25">
        <di:waypoint x="1490" y="440" />
        <di:waypoint x="1550" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TOBE_24_di" bpmnElement="F_TOBE_24">
        <di:waypoint x="1220" y="440" />
        <di:waypoint x="1280" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TOBE_23_di" bpmnElement="F_TOBE_23">
        <di:waypoint x="950" y="440" />
        <di:waypoint x="1010" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TOBE_22_di" bpmnElement="F_TOBE_22">
        <di:waypoint x="700" y="440" />
        <di:waypoint x="760" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TOBE_21_di" bpmnElement="F_TOBE_21">
        <di:waypoint x="420" y="440" />
        <di:waypoint x="480" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_TOBE_20_di" bpmnElement="F_TOBE_20">
        <di:waypoint x="156" y="443" />
        <di:waypoint x="210" y="440" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
