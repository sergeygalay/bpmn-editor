<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-mvp-project-approval-v1" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-mvp-project-approval-v1">
  <bpmn:collaboration id="Collab_kgmk-mvp-project-approval-v1">
    <bpmn:participant id="Part_kgmk-mvp-project-approval-v1" name="MVP — Выбор и согласование проекта" processRef="Proc_kgmk-mvp-project-approval-v1" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-mvp-project-approval-v1" name="MVP — Выбор и согласование проекта" isExecutable="false">
    <bpmn:laneSet id="LaneSet_approval">
      <bpmn:lane id="L_Customer" name="Заказчик БЕ">
        <bpmn:flowNodeRef>OpenStore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SelectProject</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Submit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Head" name="Руководитель ПМКБ">
        <bpmn:flowNodeRef>Review</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Decision</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_System" name="Система">
        <bpmn:flowNodeRef>ResolveUser</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ShowProjects</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RouteToHead</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SetToDo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>ApprovedEnd</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RejectedEnd</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:userTask id="OpenStore" name="Открыть Магазин проектов" />
    <bpmn:serviceTask id="ResolveUser" name="Определить роль пользователя и его БЕ" />
    <bpmn:serviceTask id="ShowProjects" name="Определить уровень культуры БЕ и показать допустимые проекты" />
    <bpmn:userTask id="SelectProject" name="Выбрать проект" />
    <bpmn:userTask id="Submit" name="Направить проект на согласование" />
    <bpmn:serviceTask id="RouteToHead" name="Передать проект Руководителю ПМКБ" />
    <bpmn:userTask id="Review" name="Рассмотреть проект целиком" />
    <bpmn:exclusiveGateway id="Decision" name="Проект согласован?" />
    <bpmn:serviceTask id="SetToDo" name="Перевести проект в статус To Do" />
    <bpmn:endEvent id="ApprovedEnd" name="Проект допущен к реализации" />
    <bpmn:endEvent id="RejectedEnd" name="Проект не переходит в реализацию" />
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="OpenStore" />
    <bpmn:sequenceFlow id="F2" sourceRef="OpenStore" targetRef="ResolveUser" />
    <bpmn:sequenceFlow id="F3" sourceRef="ResolveUser" targetRef="ShowProjects" />
    <bpmn:sequenceFlow id="F4" sourceRef="ShowProjects" targetRef="SelectProject" />
    <bpmn:sequenceFlow id="F5" sourceRef="SelectProject" targetRef="Submit" />
    <bpmn:sequenceFlow id="F6" sourceRef="Submit" targetRef="RouteToHead" />
    <bpmn:sequenceFlow id="F7" sourceRef="RouteToHead" targetRef="Review" />
    <bpmn:sequenceFlow id="F8" sourceRef="Review" targetRef="Decision" />
    <bpmn:sequenceFlow id="F9" name="Да" sourceRef="Decision" targetRef="SetToDo" />
    <bpmn:sequenceFlow id="F10" sourceRef="SetToDo" targetRef="ApprovedEnd" />
    <bpmn:sequenceFlow id="F11" name="Нет" sourceRef="Decision" targetRef="RejectedEnd" />
    <bpmn:startEvent id="S" name="Заказчик БЕ начинает выбор проекта" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_approval">
    <bpmndi:BPMNPlane id="Plane_approval" bpmnElement="Collab_kgmk-mvp-project-approval-v1">
      <bpmndi:BPMNShape id="Part_di" bpmnElement="Part_kgmk-mvp-project-approval-v1" isHorizontal="true">
        <dc:Bounds x="10" y="40" width="3320" height="720" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_System_di" bpmnElement="L_System" isHorizontal="true">
        <dc:Bounds x="40" y="480" width="3230" height="280" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Head_di" bpmnElement="L_Head" isHorizontal="true">
        <dc:Bounds x="40" y="260" width="3230" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="L_Customer_di" bpmnElement="L_Customer" isHorizontal="true">
        <dc:Bounds x="40" y="40" width="3230" height="220" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="OpenStore_di" bpmnElement="OpenStore">
        <dc:Bounds x="190" y="105" width="240" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ResolveUser_di" bpmnElement="ResolveUser">
        <dc:Bounds x="500" y="555" width="280" height="80" />
