        <di:waypoint x="1205" y="145" />
        <di:waypoint x="1240" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F5_di" bpmnElement="F5">
        <di:waypoint x="1460" y="145" />
        <di:waypoint x="1520" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F6_di" bpmnElement="F6">
        <di:waypoint x="1790" y="145" />
        <di:waypoint x="1820" y="145" />
        <di:waypoint x="1820" y="595" />
        <di:waypoint x="1850" y="595" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F7_di" bpmnElement="F7">
        <di:waypoint x="2130" y="595" />
        <di:waypoint x="2165" y="595" />
        <di:waypoint x="2165" y="365" />
        <di:waypoint x="2200" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F8_di" bpmnElement="F8">
        <di:waypoint x="2450" y="365" />
        <di:waypoint x="2510" y="365" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F9_di" bpmnElement="F9">
        <di:waypoint x="2560" y="365" />
