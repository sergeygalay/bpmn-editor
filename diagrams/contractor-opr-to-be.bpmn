<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_contractor-opr-to-be" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be">
<bpmn:collaboration id="Collaboration_contractor-opr-to-be">
<bpmn:participant id="Participant_Company" name="Предприятие / проведение проверки" processRef="Process_Company"/>
<bpmn:participant id="Participant_Octant" name="Октант" processRef="Process_Octant"/>
<bpmn:messageFlow id="Message_1" name="Готовые контрольные листы — целевая концепция" sourceRef="Provide" targetRef="Available"/>
</bpmn:collaboration>
<bpmn:process id="Process_Company" name="Рейтинг подрядчиков — TO-BE MVP: выбор и заполнение готового контрольного листа" isExecutable="false">
<bpmn:laneSet id="LaneSet_Company">
<bpmn:lane id="Lane_Window" name="Единое окно">
<bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Organize</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Inform</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_Checker" name="Проверяющий">
<bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Select</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Fill</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Record</bpmn:flowNodeRef>
</bpmn:lane>
<bpmn:lane id="Lane_App" name="Суперника">
<bpmn:flowNodeRef>Available</bpmn:flowNodeRef>
<bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
<bpmn:flowNodeRef>End</bpmn:flowNodeRef>
</bpmn:lane>
</bpmn:laneSet>
<bpmn:startEvent id="Start" name="Потребность в проверке" />
<bpmn:userTask id="Organize" name="Организовать проверку вне приложения" />
<bpmn:userTask id="Inform" name="Сообщить проверяющему, какую форму использовать" />
<bpmn:userTask id="Open" name="Открыть «Супернику»" />
<bpmn:task id="Available" name="Предоставить доступные готовые контрольные листы" />
<bpmn:userTask id="Select" name="Выбрать нужный контрольный лист" />
<bpmn:userTask id="Fill" name="Заполнить контрольный лист" />
<bpmn:userTask id="Record" name="Зафиксировать результат проверки" />
<bpmn:task id="Save" name="Сохранить результат проверки" />
<bpmn:endEvent id="End" name="Результат зафиксирован" />
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Organize" />
<bpmn:sequenceFlow id="Flow_2" sourceRef="Organize" targetRef="Inform" />
<bpmn:sequenceFlow id="Flow_3" sourceRef="Inform" targetRef="Open" />
<bpmn:sequenceFlow id="Flow_4" sourceRef="Open" targetRef="Available" />
<bpmn:sequenceFlow id="Flow_5" sourceRef="Available" targetRef="Select" />
<bpmn:sequenceFlow id="Flow_6" sourceRef="Select" targetRef="Fill" />
<bpmn:sequenceFlow id="Flow_7" sourceRef="Fill" targetRef="Record" />
<bpmn:sequenceFlow id="Flow_8" sourceRef="Record" targetRef="Save" />
<bpmn:sequenceFlow id="Flow_9" sourceRef="Save" targetRef="End" />
</bpmn:process>
<bpmn:process id="Process_Octant" name="Управление формами в Октант (целевая концепция, требует проверки)" isExecutable="false">
<bpmn:startEvent id="OctStart" name="Потребность в актуальной форме" />
<bpmn:userTask id="Manage" name="Создать / актуализировать форму (концепция)" />
<bpmn:sendTask id="Provide" name="Предоставить актуальные готовые формы (способ уточняется)" />
<bpmn:endEvent id="OctEnd" name="Форма предоставлена" />
<bpmn:sequenceFlow id="Flow_10" sourceRef="OctStart" targetRef="Manage" />
<bpmn:sequenceFlow id="Flow_11" sourceRef="Manage" targetRef="Provide" />
<bpmn:sequenceFlow id="Flow_12" sourceRef="Provide" targetRef="OctEnd" />
</bpmn:process>
<bpmndi:BPMNDiagram id="Diagram_contractor-opr-to-be"><bpmndi:BPMNPlane id="Plane_contractor-opr-to-be" bpmnElement="Collaboration_contractor-opr-to-be">
