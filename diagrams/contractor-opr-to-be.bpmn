<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-to-be" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be">
<bpmn:collaboration id="Collaboration_contractor-opr-to-be">
<bpmn:participant id="Participant_Window" name="Единое окно" processRef="Process_Window"/>
<bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker"/>
<bpmn:participant id="Participant_App" name="Суперника" processRef="Process_App"/>
<bpmn:participant id="Participant_Octant" name="Октант" processRef="Process_Octant"/>
<bpmn:messageFlow id="Message_2" name="Какую форму использовать" sourceRef="Inform" targetRef="CheckerStart"/>
<bpmn:messageFlow id="Message_3" name="Открытие приложения" sourceRef="Open" targetRef="AppStart"/>
<bpmn:messageFlow id="Message_4" name="Готовые контрольные листы" sourceRef="Available" targetRef="Select"/>
<bpmn:messageFlow id="Message_5" name="Заполненный лист и результат" sourceRef="Record" targetRef="AppWait"/>
<bpmn:messageFlow id="Message_1" name="Готовые формы — целевая концепция" sourceRef="Provide" targetRef="Available"/>
</bpmn:collaboration>
<bpmn:process id="Process_Window" name="Единое окно" isExecutable="false">
<bpmn:startEvent id="Start" name="Нужно провести проверку"/>
<bpmn:userTask id="Organize" name="Организовать проверку вне приложения"/>
<bpmn:userTask id="Inform" name="Сообщить, какой лист использовать"/>
<bpmn:endEvent id="WindowEnd" name="Проверяющий уведомлён"/>
<bpmn:sequenceFlow id="Flow_1" sourceRef="Start" targetRef="Organize"/>
<bpmn:sequenceFlow id="Flow_2" sourceRef="Organize" targetRef="Inform"/>
<bpmn:sequenceFlow id="Flow_Window_End" sourceRef="Inform" targetRef="WindowEnd"/>
</bpmn:process>
<bpmn:process id="Process_Checker" name="Проверяющий" isExecutable="false">
<bpmn:startEvent id="CheckerStart" name="Получено поручение"/>
<bpmn:userTask id="Open" name="Открыть «Супернику»"/>
<bpmn:userTask id="Select" name="Выбрать контрольный лист"/>
<bpmn:userTask id="Fill" name="Заполнить контрольный лист"/>
<bpmn:userTask id="Record" name="Зафиксировать результат"/>
<bpmn:endEvent id="CheckerEnd" name="Проверка завершена"/>
<bpmn:sequenceFlow id="Flow_Checker_Start" sourceRef="CheckerStart" targetRef="Open"/>
<bpmn:sequenceFlow id="Flow_4" sourceRef="Open" targetRef="Select"/>
<bpmn:sequenceFlow id="Flow_6" sourceRef="Select" targetRef="Fill"/>
<bpmn:sequenceFlow id="Flow_7" sourceRef="Fill" targetRef="Record"/>
<bpmn:sequenceFlow id="Flow_Checker_End" sourceRef="Record" targetRef="CheckerEnd"/>
</bpmn:process>
<bpmn:process id="Process_App" name="Суперника" isExecutable="false">
<bpmn:startEvent id="AppStart" name="Открыта форма"/>
<bpmn:task id="Available" name="Предоставить готовые контрольные листы"/>
<bpmn:receiveTask id="AppWait" name="Получить заполненный контрольный лист"/>
<bpmn:task id="Save" name="Сохранить результат проверки"/>
<bpmn:endEvent id="End" name="Результат зафиксирован"/>
<bpmn:sequenceFlow id="Flow_App_Available" sourceRef="AppStart" targetRef="Available"/>
<bpmn:sequenceFlow id="Flow_App_Wait" sourceRef="Available" targetRef="AppWait"/>
<bpmn:sequenceFlow id="Flow_App_Save" sourceRef="AppWait" targetRef="Save"/>
<bpmn:sequenceFlow id="Flow_9" sourceRef="Save" targetRef="End"/>
</bpmn:process>
<bpmn:process id="Process_Octant" name="Октант" isExecutable="false">
<bpmn:startEvent id="OctStart" name="Нужна актуальная форма"/>
<bpmn:userTask id="Manage" name="Вести актуальные формы (концепция)"/>
<bpmn:sendTask id="Provide" name="Предоставить готовые формы (способ уточняется)"/>
<bpmn:endEvent id="OctEnd" name="Формы предоставлены"/>
<bpmn:sequenceFlow id="Flow_10" sourceRef="OctStart" targetRef="Manage"/>
<bpmn:sequenceFlow id="Flow_11" sourceRef="Manage" targetRef="Provide"/>
<bpmn:sequenceFlow id="Flow_12" sourceRef="Provide" targetRef="OctEnd"/>
</bpmn:process>
