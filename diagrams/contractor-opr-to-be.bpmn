<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_contractor-opr-to-be" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be">
  <bpmn:collaboration id="Collaboration_contractor-opr-to-be">
    <bpmn:participant id="Participant_Window" name="Аналитик «Октанта»" processRef="Process_Window" />
    <bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker" />
    <bpmn:participant id="Participant_App" name="МП «Суперника»" processRef="Process_App" />
    <bpmn:participant id="Participant_Octant" name="Система «Октант»" processRef="Process_Octant" />
    <bpmn:messageFlow id="Message_Assignment" name="Формы, график и назначения" sourceRef="Assign" targetRef="OctStart" />
    <bpmn:messageFlow id="Message_ReferenceData" name="Справочники, назначения и конфигурации форм (раз в сутки)" sourceRef="Provide" targetRef="SyncData" />
    <bpmn:messageFlow id="Message_OpenApp" name="Открытие МП (учётная запись)" sourceRef="Open" targetRef="AppOpenStart" />
    <bpmn:messageFlow id="Message_List" name="Доступные виды проверок и список назначений" sourceRef="Available" targetRef="Open" />
    <bpmn:messageFlow id="Message_ChooseAssigned" name="Выбрана назначенная проверка" sourceRef="Select" targetRef="Form" />
    <bpmn:messageFlow id="Message_ChooseManual" name="Создана проверка без назначения (выбран вид)" sourceRef="Manual" targetRef="Form" />
    <bpmn:messageFlow id="Message_ReadyForm" name="Отображаемая форма (ОПР / аудит)" sourceRef="Form" targetRef="Fill" />
    <bpmn:messageFlow id="Message_ReadyFormKpr" name="Форма КПР" sourceRef="Form" targetRef="FillKpr" />
    <bpmn:messageFlow id="Message_CheckFilled" name="Заполненный контрольный лист" sourceRef="Fill" targetRef="AppWaitResult" />
    <bpmn:messageFlow id="Message_ActViolations" name="Нарушения, отобранные в Акт" sourceRef="SelectViolationsForAct" targetRef="AppWaitResult" />
    <bpmn:messageFlow id="Message_KprFilled" name="Заполненная форма КПР и нарушения" sourceRef="FillKpr" targetRef="AppWaitResult" />
    <bpmn:messageFlow id="Message_NotPerformed" name="Отметка «Работа не проводится» и комментарий" sourceRef="NotWork" targetRef="AppWaitResult" />
    <bpmn:messageFlow id="Message_Outcome" name="Расчётный итог и предпросмотр PDF" sourceRef="Calculate" targetRef="Record" />
    <bpmn:messageFlow id="Message_Confirm" name="Нажатие «Отправить»" sourceRef="Record" targetRef="AppWaitConfirm" />
    <bpmn:messageFlow id="Message_ExportPdf" name="Файлы PDF (контрольный лист и/или Акт)" sourceRef="Save" targetRef="ExportAndSignAct" />
    <bpmn:messageFlow id="Message_Result" name="Результаты проверки (печатные формы, вложения)" sourceRef="Send" targetRef="OctResultStart" />
    <bpmn:messageFlow id="Message_BellNotify" name="Уведомление «колокольчик»" sourceRef="OctNotifyBell" targetRef="AnalystNotifyStart" />
    <bpmn:messageFlow id="Message_TransferAll" name="Привязка к графику и «Перенести всё»" sourceRef="AnalystTransferAll" targetRef="OctWaitTransfer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Window" name="Аналитик «Октанта» — TO-BE" isExecutable="false">
    <bpmn:startEvent id="Start" name="Необходима настройка форм или планирование проверок" />
    <bpmn:userTask id="ConfigureForms" name="Настроить / отредактировать контрольные листы (ОПР, аудит) и формы КПР в «Октанте»" />
    <bpmn:userTask id="Organize" name="Запланировать график проверок (ОПР, аудит) в «Октанте»" />
    <bpmn:userTask id="Assign" name="Назначить ответственных проверяющих" />
    <bpmn:endEvent id="WindowEnd" name="Формы и назначения сохранены в «Октанте»" />
    <bpmn:startEvent id="AnalystNotifyStart" name="Уведомление («колокольчик») о новых проверках">
      <bpmn:messageEventDefinition id="MED_AnalystNotifyStart" />
    </bpmn:startEvent>
    <bpmn:userTask id="AnalystReview" name="Просмотреть входящие и при необходимости привязать проверки без назначения к графику" />
    <bpmn:userTask id="AnalystTransferAll" name="Нажать «Перенести всё» для сохранения в журнал" />
    <bpmn:endEvent id="AnalystEnd" name="Результаты перенесены в журнал" />
    <bpmn:sequenceFlow id="Flow_Window_0" sourceRef="Start" targetRef="ConfigureForms" />
    <bpmn:sequenceFlow id="Flow_Window_1" sourceRef="ConfigureForms" targetRef="Organize" />
    <bpmn:sequenceFlow id="Flow_Window_2" sourceRef="Organize" targetRef="Assign" />
    <bpmn:sequenceFlow id="Flow_Window_3" sourceRef="Assign" targetRef="WindowEnd" />
    <bpmn:sequenceFlow id="Flow_Analyst_1" sourceRef="AnalystNotifyStart" targetRef="AnalystReview" />
    <bpmn:sequenceFlow id="Flow_Analyst_2" sourceRef="AnalystReview" targetRef="AnalystTransferAll" />
    <bpmn:sequenceFlow id="Flow_Analyst_3" sourceRef="AnalystTransferAll" targetRef="AnalystEnd" />
  </bpmn:process>
  <bpmn:process id="Process_Checker" name="Проверяющий — TO-BE" isExecutable="false">
    <bpmn:startEvent id="CheckerStart" name="Необходима проверка (ОПР, аудит или КПР)" />
    <bpmn:userTask id="Open" name="Открыть МП в «Супернике»" />
    <bpmn:exclusiveGateway id="HasAssignment" name="Проверка из календаря назначений?" />
    <bpmn:userTask id="Select" name="Выбрать назначенную проверку (ОПР / аудит)" />
    <bpmn:exclusiveGateway id="CanCheck" name="Работы на объекте ведутся?" />
    <bpmn:userTask id="NotWork" name="Отметить «Работа не проводится» и заполнить обязательный комментарий" />
    <bpmn:userTask id="Manual" name="Создать проверку без назначения, выбрать вид и заполнить реквизиты шапки (вкл. ФИО проверяемого)" />
    <bpmn:exclusiveGateway id="IsKprGateway" name="Вид проверки — КПР?" />
    <bpmn:exclusiveGateway id="MergeBeforeFill" />
    <bpmn:userTask id="Fill" name="Заполнить контрольный лист (ОПР / аудит), примечания и вложения (доступен офлайн-черновик)" />
    <bpmn:userTask id="FillKpr" name="Внести нарушения КПР, состав комиссии и вложения" />
    <bpmn:exclusiveGateway id="HasViolations" name="Выявлены нарушения?" />
    <bpmn:userTask id="SelectViolationsForAct" name="Отобрать нарушения из контрольного листа в Акт проверки и детализировать описание" />
    <bpmn:exclusiveGateway id="MergeOutcome" />
    <bpmn:userTask id="Record" name="Просмотреть итог / предпросмотр PDF (при проведении) и нажать «Отправить»" />
    <bpmn:exclusiveGateway id="NeedPaperSign" name="Требуется выгрузка PDF / подписание на бумаге?" />
    <bpmn:userTask id="ExportAndSignAct" name="Выгрузить PDF (контрольный лист и/или Акт проверки) и при необходимости подписать на бумаге" />
    <bpmn:exclusiveGateway id="MergeCheckerEnd" />
    <bpmn:endEvent id="CheckerEnd" name="Проверка завершена" />
    <bpmn:sequenceFlow id="Flow_Checker_1" sourceRef="CheckerStart" targetRef="Open" />
    <bpmn:sequenceFlow id="Flow_Checker_2" sourceRef="Open" targetRef="HasAssignment" />
    <bpmn:sequenceFlow id="Flow_Checker_3" name="Да" sourceRef="HasAssignment" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_Checker_4" name="Нет (КПР или внеплановая)" sourceRef="HasAssignment" targetRef="Manual" />
    <bpmn:sequenceFlow id="Flow_Checker_5" sourceRef="Select" targetRef="CanCheck" />
    <bpmn:sequenceFlow id="Flow_Checker_6" name="Да" sourceRef="CanCheck" targetRef="MergeBeforeFill" />
    <bpmn:sequenceFlow id="Flow_Checker_7" name="Нет" sourceRef="CanCheck" targetRef="NotWork" />
    <bpmn:sequenceFlow id="Flow_Checker_ManualFlow" sourceRef="Manual" targetRef="IsKprGateway" />
    <bpmn:sequenceFlow id="Flow_Checker_8" name="Нет (ОПР / аудит)" sourceRef="IsKprGateway" targetRef="MergeBeforeFill" />
    <bpmn:sequenceFlow id="Flow_Checker_ManualKpr" name="Да (КПР)" sourceRef="IsKprGateway" targetRef="FillKpr" />
    <bpmn:sequenceFlow id="Flow_Checker_ToFill" sourceRef="MergeBeforeFill" targetRef="Fill" />
    <bpmn:sequenceFlow id="Flow_Fill_Violations" sourceRef="Fill" targetRef="HasViolations" />
    <bpmn:sequenceFlow id="Flow_Violations_Yes" name="Да" sourceRef="HasViolations" targetRef="SelectViolationsForAct" />
    <bpmn:sequenceFlow id="Flow_Violations_No" name="Нет" sourceRef="HasViolations" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Checker_9" sourceRef="SelectViolationsForAct" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Checker_10" sourceRef="NotWork" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Kpr_Merge" sourceRef="FillKpr" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Checker_12" sourceRef="MergeOutcome" targetRef="Record" />
    <bpmn:sequenceFlow id="Flow_To_PaperSign" sourceRef="Record" targetRef="NeedPaperSign" />
    <bpmn:sequenceFlow id="Flow_PaperSign_Yes" name="Да" sourceRef="NeedPaperSign" targetRef="ExportAndSignAct" />
    <bpmn:sequenceFlow id="Flow_PaperSign_No" name="Нет" sourceRef="NeedPaperSign" targetRef="MergeCheckerEnd" />
    <bpmn:sequenceFlow id="Flow_Export_Merge" sourceRef="ExportAndSignAct" targetRef="MergeCheckerEnd" />
    <bpmn:sequenceFlow id="Flow_Checker_11" sourceRef="MergeCheckerEnd" targetRef="CheckerEnd" />
  </bpmn:process>
  <bpmn:process id="Process_App" name="Суперника — TO-BE" isExecutable="false">
    <bpmn:startEvent id="AppStart" name="Ночная синхронизация (раз в сутки)">
      <bpmn:timerEventDefinition id="TimerEventDefinition_05gyqv1" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="SyncData" name="Ежесуточно (в ночное время) загрузить справочники, назначения и конфигурации форм" />
    <bpmn:endEvent id="AppSyncEnd" name="Данные синхронизированы" />
    <bpmn:startEvent id="AppOpenStart" name="Открытие МП пользователем">
      <bpmn:messageEventDefinition id="MED_AppOpenStart" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Available" name="Идентифицировать проверяющего (БЕ, таб. №) и показать назначения" />
    <bpmn:serviceTask id="Form" name="Динамически отобразить форму (ОПР, аудит, КПР)" />
    <bpmn:receiveTask id="AppWaitResult" name="Получить заполненную форму, отобранные для Акта нарушения или отметку «Работа не проводится»" />
    <bpmn:exclusiveGateway id="AppIsNotWork" name="Отметка «Работа не проводится»?" />
    <bpmn:serviceTask id="Calculate" name="Рассчитать результат проверки и сформировать PDF контрольного листа и/или единого Акта проверки" />
    <bpmn:exclusiveGateway id="MergeAppBeforeConfirm" />
    <bpmn:receiveTask id="AppWaitConfirm" name="Получить подтверждение («Отправить») и заблокировать редактирование" />
    <bpmn:serviceTask id="Save" name="Сохранить проверку и сформировать файлы PDF (контрольный лист и/или Акт проверки) для выгрузки" />
    <bpmn:exclusiveGateway id="Network" name="Есть связь?" />
    <bpmn:task id="OfflineWait" name="Сохранить в очереди отправки" />
    <bpmn:intermediateCatchEvent id="WaitConnection" name="Связь восстановлена и МП открыто">
      <bpmn:conditionalEventDefinition id="CED_WaitConnection">
        <bpmn:condition xsi:type="bpmn:tFormalExpression" />
      </bpmn:conditionalEventDefinition>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="MergeNetwork" />
    <bpmn:sendTask id="Send" name="Выгрузить результаты проверки (печатные формы, вложения) в сетевую папку «Октанта»" />
    <bpmn:endEvent id="AppEnd" name="Результат передан в сетевую папку" />
    <bpmn:sequenceFlow id="Flow_App_0" sourceRef="AppStart" targetRef="SyncData" />
    <bpmn:sequenceFlow id="Flow_App_SyncEnd" sourceRef="SyncData" targetRef="AppSyncEnd" />
    <bpmn:sequenceFlow id="Flow_App_Open" sourceRef="AppOpenStart" targetRef="Available" />
    <bpmn:sequenceFlow id="Flow_App_2" sourceRef="Available" targetRef="Form" />
    <bpmn:sequenceFlow id="Flow_App_3" sourceRef="Form" targetRef="AppWaitResult" />
    <bpmn:sequenceFlow id="Flow_App_Result" sourceRef="AppWaitResult" targetRef="AppIsNotWork" />
    <bpmn:sequenceFlow id="Flow_App_IsNotWork_No" name="Нет" sourceRef="AppIsNotWork" targetRef="Calculate" />
    <bpmn:sequenceFlow id="Flow_App_IsNotWork_Yes" name="Да" sourceRef="AppIsNotWork" targetRef="MergeAppBeforeConfirm" />
    <bpmn:sequenceFlow id="Flow_App_Calc_Merge" sourceRef="Calculate" targetRef="MergeAppBeforeConfirm" />
    <bpmn:sequenceFlow id="Flow_App_4" sourceRef="MergeAppBeforeConfirm" targetRef="AppWaitConfirm" />
    <bpmn:sequenceFlow id="Flow_App_5" sourceRef="AppWaitConfirm" targetRef="Save" />
    <bpmn:sequenceFlow id="Flow_App_6" sourceRef="Save" targetRef="Network" />
    <bpmn:sequenceFlow id="Flow_App_7" name="Да" sourceRef="Network" targetRef="MergeNetwork" />
    <bpmn:sequenceFlow id="Flow_App_8" name="Нет" sourceRef="Network" targetRef="OfflineWait" />
    <bpmn:sequenceFlow id="Flow_App_Offline_Wait" sourceRef="OfflineWait" targetRef="WaitConnection" />
    <bpmn:sequenceFlow id="Flow_App_9" sourceRef="WaitConnection" targetRef="MergeNetwork" />
    <bpmn:sequenceFlow id="Flow_App_Send" sourceRef="MergeNetwork" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_App_10" sourceRef="Send" targetRef="AppEnd" />
  </bpmn:process>
  <bpmn:process id="Process_Octant" name="Октант — TO-BE" isExecutable="false">
    <bpmn:startEvent id="OctStart" name="Сохранены формы и назначения">
      <bpmn:messageEventDefinition id="MED_OctStart" />
    </bpmn:startEvent>
    <bpmn:task id="OctSaveAssignment" name="Сохранить конфигурации контрольных листов (ОПР, аудит), форм КПР и график проверок" />
    <bpmn:sendTask id="Provide" name="Предоставить в сетевой папке справочники, формы и назначения" />
    <bpmn:endEvent id="OctAppointmentEnd" name="Данные выгружены для синхронизации" />
    <bpmn:startEvent id="OctResultStart" name="Получены результаты проверки в сетевой папке">
      <bpmn:messageEventDefinition id="MED_OctResultStart" />
    </bpmn:startEvent>
    <bpmn:sendTask id="OctNotifyBell" name="Показать уведомление («колокольчик») о поступивших проверках подразделения" />
    <bpmn:receiveTask id="OctWaitTransfer" name="Получить подтверждение разбора («Перенести всё»)" />
    <bpmn:task id="OctStore" name="Внести результаты, печатные формы и вложения в журнал проверок «Октанта»" />
    <bpmn:endEvent id="OctEnd" name="Результат учтён в журнале «Октанта»" />
    <bpmn:sequenceFlow id="Flow_Octant_1" sourceRef="OctStart" targetRef="OctSaveAssignment" />
    <bpmn:sequenceFlow id="Flow_Octant_2" sourceRef="OctSaveAssignment" targetRef="Provide" />
    <bpmn:sequenceFlow id="Flow_Octant_3" sourceRef="Provide" targetRef="OctAppointmentEnd" />
    <bpmn:sequenceFlow id="Flow_Octant_Bell" sourceRef="OctResultStart" targetRef="OctNotifyBell" />
    <bpmn:sequenceFlow id="Flow_Octant_Wait" sourceRef="OctNotifyBell" targetRef="OctWaitTransfer" />
    <bpmn:sequenceFlow id="Flow_Octant_4" sourceRef="OctWaitTransfer" targetRef="OctStore" />
    <bpmn:sequenceFlow id="Flow_Octant_5" sourceRef="OctStore" targetRef="OctEnd" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_contractor-opr-to-be">
    <bpmndi:BPMNPlane id="Plane_contractor-opr-to-be" bpmnElement="Collaboration_contractor-opr-to-be">
      <!-- Pool 1: Window y=50..240 -->
      <bpmndi:BPMNShape id="Participant_Window_di" bpmnElement="Participant_Window" isHorizontal="true">
        <dc:Bounds x="40" y="50" width="6540" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start">
        <dc:Bounds x="132" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="75" y="168" width="150" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ConfigureForms_di" bpmnElement="ConfigureForms">
        <dc:Bounds x="225" y="101" width="225" height="88" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Organize_di" bpmnElement="Organize">
        <dc:Bounds x="495" y="102" width="210" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Assign_di" bpmnElement="Assign">
        <dc:Bounds x="745" y="102" width="210" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="WindowEnd_di" bpmnElement="WindowEnd">
        <dc:Bounds x="1022" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="965" y="168" width="150" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnalystNotifyStart_di" bpmnElement="AnalystNotifyStart">
        <dc:Bounds x="5504" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="5442" y="74" width="160" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnalystReview_di" bpmnElement="AnalystReview">
        <dc:Bounds x="5625" y="101" width="225" height="88" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnalystTransferAll_di" bpmnElement="AnalystTransferAll">
        <dc:Bounds x="5900" y="102" width="210" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AnalystEnd_di" bpmnElement="AnalystEnd">
        <dc:Bounds x="6182" y="127" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="6130" y="168" width="140" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Window_0_di" bpmnElement="Flow_Window_0">
        <di:waypoint x="168" y="145" />
        <di:waypoint x="225" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Window_1_di" bpmnElement="Flow_Window_1">
        <di:waypoint x="450" y="145" />
        <di:waypoint x="495" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Window_2_di" bpmnElement="Flow_Window_2">
        <di:waypoint x="705" y="145" />
        <di:waypoint x="745" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Window_3_di" bpmnElement="Flow_Window_3">
        <di:waypoint x="955" y="145" />
        <di:waypoint x="1022" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Analyst_1_di" bpmnElement="Flow_Analyst_1">
        <di:waypoint x="5540" y="145" />
        <di:waypoint x="5625" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Analyst_2_di" bpmnElement="Flow_Analyst_2">
        <di:waypoint x="5850" y="145" />
        <di:waypoint x="5900" y="145" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Analyst_3_di" bpmnElement="Flow_Analyst_3">
        <di:waypoint x="6110" y="145" />
        <di:waypoint x="6182" y="145" />
      </bpmndi:BPMNEdge>

      <!-- Pool 2: Checker y=310..810 -->
      <bpmndi:BPMNShape id="Participant_Checker_di" bpmnElement="Participant_Checker" isHorizontal="true">
        <dc:Bounds x="40" y="310" width="6540" height="500" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckerStart_di" bpmnElement="CheckerStart">
        <dc:Bounds x="1632" y="577" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1575" y="620" width="150" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Open_di" bpmnElement="Open">
        <dc:Bounds x="1760" y="551" width="210" height="88" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="HasAssignment_di" bpmnElement="HasAssignment" isMarkerVisible="true">
        <dc:Bounds x="2045" y="570" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1975" y="512" width="95" height="42" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Select_di" bpmnElement="Select">
        <dc:Bounds x="2170" y="462" width="210" height="86" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CanCheck_di" bpmnElement="CanCheck" isMarkerVisible="true">
        <dc:Bounds x="2455" y="480" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="2380" y="422" width="95" height="42" />
        </bpmndi:BPMNLabel>
