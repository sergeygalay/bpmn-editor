<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-to-be" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be">
  <bpmn:collaboration id="Collaboration_contractor-opr-to-be">
    <bpmn:participant id="Participant_Window" name="Аналитик «Октанта»" processRef="Process_Window" />
    <bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker" />
    <bpmn:participant id="Participant_App" name="МП «Суперника» (и платформенный конструктор форм)" processRef="Process_App" />
    <bpmn:participant id="Participant_Octant" name="Система «Октант» (и сетевая папка обмена)" processRef="Process_Octant" />
    <bpmn:messageFlow id="Message_Assignment" name="Формы, график и назначения" sourceRef="Assign" targetRef="OctStart" />
    <bpmn:messageFlow id="Message_ReferenceData" name="Справочники, роли, назначения и конфигурации форм (раз в сутки)" sourceRef="Provide" targetRef="SyncData" />
    <bpmn:messageFlow id="Message_OpenApp" name="Открытие МП (учётная запись)" sourceRef="Open" targetRef="Available" />
    <bpmn:messageFlow id="Message_List" name="Доступные виды проверок и список назначений" sourceRef="Available" targetRef="Open" />
    <bpmn:messageFlow id="Message_ChooseAssigned" name="Выбрана назначенная проверка" sourceRef="Select" targetRef="Form" />
    <bpmn:messageFlow id="Message_ChooseManual" name="Создана проверка без назначения / КПР" sourceRef="Manual" targetRef="Form" />
    <bpmn:messageFlow id="Message_ReadyForm" name="Динамическая форма (конструктор)" sourceRef="Form" targetRef="Fill" />
    <bpmn:messageFlow id="Message_NotPerformed" name="Отметка «Работа не проводится» и комментарий" sourceRef="NotWork" targetRef="AppWaitResult" />
    <bpmn:messageFlow id="Message_CheckFilled" name="Заполненный чек-лист и отобранные нарушения" sourceRef="SelectViolationsForAct" targetRef="AppWaitResult" />
    <bpmn:messageFlow id="Message_KprFilled" name="Заполненная форма КПР и нарушения" sourceRef="FillKpr" targetRef="AppWaitResult" />
    <bpmn:messageFlow id="Message_Outcome" name="Расчётный итог и предпросмотр PDF" sourceRef="Calculate" targetRef="Record" />
    <bpmn:messageFlow id="Message_Confirm" name="Нажатие «Отправить»" sourceRef="Record" targetRef="AppWaitConfirm" />
    <bpmn:messageFlow id="Message_ExportPdf" name="PDF контрольного листа и единого Акта" sourceRef="Save" targetRef="ExportAndSignAct" />
    <bpmn:messageFlow id="Message_Result" name="Каталог проверки (result.json, PDF, вложения)" sourceRef="Send" targetRef="OctResultStart" />
    <bpmn:messageFlow id="Message_BellNotify" name="Уведомление «колокольчик»" sourceRef="OctNotifyBell" targetRef="AnalystNotifyStart" />
    <bpmn:messageFlow id="Message_TransferAll" name="Привязка к графику и «Перенести всё»" sourceRef="AnalystTransferAll" targetRef="OctWaitTransfer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Window" name="Аналитик «Октанта» — TO-BE" isExecutable="false">
    <bpmn:startEvent id="Start" name="Необходима настройка форм или планирование проверок" />
    <bpmn:userTask id="ConfigureForms" name="Настроить / отредактировать опросники, чек-листы (ОПР, аудит) и формы КПР в «Октанте»" />
    <bpmn:userTask id="Organize" name="Запланировать график проверок (ОПР, аудит) в «Октанте»" />
    <bpmn:userTask id="Assign" name="Назначить ответственных проверяющих" />
    <bpmn:endEvent id="WindowEnd" name="Формы и назначения сохранены в «Октанте»" />
    <bpmn:sequenceFlow id="Flow_Window_0" sourceRef="Start" targetRef="ConfigureForms" />
    <bpmn:sequenceFlow id="Flow_Window_1" sourceRef="ConfigureForms" targetRef="Organize" />
    <bpmn:sequenceFlow id="Flow_Window_2" sourceRef="Organize" targetRef="Assign" />
    <bpmn:sequenceFlow id="Flow_Window_3" sourceRef="Assign" targetRef="WindowEnd" />
    <bpmn:startEvent id="AnalystNotifyStart" name="Уведомление («колокольчик») о новых проверках" />
    <bpmn:userTask id="AnalystReview" name="Просмотреть входящие и при необходимости привязать проверки без назначения к графику" />
    <bpmn:userTask id="AnalystTransferAll" name="Нажать «Перенести всё» для сохранения в журнал" />
    <bpmn:endEvent id="AnalystEnd" name="Результаты перенесены в журнал" />
    <bpmn:sequenceFlow id="Flow_Analyst_1" sourceRef="AnalystNotifyStart" targetRef="AnalystReview" />
    <bpmn:sequenceFlow id="Flow_Analyst_2" sourceRef="AnalystReview" targetRef="AnalystTransferAll" />
    <bpmn:sequenceFlow id="Flow_Analyst_3" sourceRef="AnalystTransferAll" targetRef="AnalystEnd" />
  </bpmn:process>
  <bpmn:process id="Process_Checker" name="Проверяющий — TO-BE" isExecutable="false">
    <bpmn:startEvent id="CheckerStart" name="Необходима проверка (ОПР, аудит или КПР)" />
    <bpmn:userTask id="Open" name="Открыть МП в «Супернике»" />
    <bpmn:exclusiveGateway id="HasAssignment" name="Проверка из календаря назначений?" />
    <bpmn:userTask id="Select" name="Выбрать назначенную проверку (ОПР / аудит)" />
    <bpmn:exclusiveGateway id="CanCheck" name="Работы на объекте ведутся?" />
    <bpmn:userTask id="NotWork" name="Отметить «Работа не проводится» и заполнить обязательный комментарий" />
    <bpmn:userTask id="Manual" name="Создать проверку без назначения и заполнить реквизиты шапки" />
    <bpmn:exclusiveGateway id="IsKprGateway" name="Вид проверки — КПР?" />
    <bpmn:userTask id="Fill" name="Заполнить чек-лист (ОПР / аудит), примечания и вложения (доступен офлайн-черновик)" />
    <bpmn:userTask id="FillKpr" name="Внести нарушения КПР, вложения и ФИО проверяемого представителя подрядчика" />
    <bpmn:exclusiveGateway id="HasViolations" name="Выявлены нарушения?" />
    <bpmn:userTask id="SelectViolationsForAct" name="Отобрать нарушения из чек-листа в Акт проверки и детализировать описание" />
    <bpmn:exclusiveGateway id="MergeOutcome" />
    <bpmn:userTask id="Record" name="Просмотреть итог / печатные формы и нажать «Отправить»" />
    <bpmn:exclusiveGateway id="NeedPaperSign" name="Сформирован Акт проверки?" />
    <bpmn:userTask id="ExportAndSignAct" name="Выгрузить PDF (на телефон или ПК через веб), распечатать и подписать Акт на бумаге" />
    <bpmn:exclusiveGateway id="MergeCheckerEnd" />
    <bpmn:endEvent id="CheckerEnd" name="Проверка завершена" />
    <bpmn:sequenceFlow id="Flow_Checker_1" sourceRef="CheckerStart" targetRef="Open" />
    <bpmn:sequenceFlow id="Flow_Checker_2" sourceRef="Open" targetRef="HasAssignment" />
    <bpmn:sequenceFlow id="Flow_Checker_3" name="Да" sourceRef="HasAssignment" targetRef="Select" />
    <bpmn:sequenceFlow id="Flow_Checker_4" name="Нет (КПР или внеплановая)" sourceRef="HasAssignment" targetRef="Manual" />
    <bpmn:sequenceFlow id="Flow_Checker_5" sourceRef="Select" targetRef="CanCheck" />
    <bpmn:sequenceFlow id="Flow_Checker_6" name="Да" sourceRef="CanCheck" targetRef="Fill" />
    <bpmn:sequenceFlow id="Flow_Checker_7" name="Нет" sourceRef="CanCheck" targetRef="NotWork" />
    <bpmn:sequenceFlow id="Flow_Checker_ManualFlow" sourceRef="Manual" targetRef="IsKprGateway" />
    <bpmn:sequenceFlow id="Flow_Checker_8" name="Нет (ОПР / аудит)" sourceRef="IsKprGateway" targetRef="Fill" />
    <bpmn:sequenceFlow id="Flow_Checker_ManualKpr" name="Да (КПР)" sourceRef="IsKprGateway" targetRef="FillKpr" />
    <bpmn:sequenceFlow id="Flow_Fill_Violations" sourceRef="Fill" targetRef="HasViolations" />
    <bpmn:sequenceFlow id="Flow_Violations_Yes" name="Да" sourceRef="HasViolations" targetRef="SelectViolationsForAct" />
    <bpmn:sequenceFlow id="Flow_Violations_No" name="Нет" sourceRef="HasViolations" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Checker_9" sourceRef="SelectViolationsForAct" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Checker_10" sourceRef="NotWork" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Kpr_Merge" sourceRef="FillKpr" targetRef="MergeOutcome" />
    <bpmn:sequenceFlow id="Flow_Checker_12" sourceRef="MergeOutcome" targetRef="Record" />
    <bpmn:sequenceFlow id="Flow_To_PaperSign" sourceRef="Record" targetRef="NeedPaperSign" />
    <bpmn:sequenceFlow id="Flow_PaperSign_Yes" name="Да" sourceRef="NeedPaperSign" targetRef="ExportAndSignAct" />
    <bpmn:sequenceFlow id="Flow_PaperSign_No" name="Нет" sourceRef="NeedPaperSign" targetRef="MergeCheckerEnd" />
    <bpmn:sequenceFlow id="Flow_Export_Merge" sourceRef="ExportAndSignAct" targetRef="MergeCheckerEnd" />
    <bpmn:sequenceFlow id="Flow_Checker_11" sourceRef="MergeCheckerEnd" targetRef="CheckerEnd" />
  </bpmn:process>
  <bpmn:process id="Process_App" name="Суперника — TO-BE" isExecutable="false">
    <bpmn:serviceTask id="SyncData" name="Ежесуточно (после 18:00 МСК) загрузить справочники, роли, назначения и конфигурации форм" />
    <bpmn:serviceTask id="Available" name="Идентифицировать проверяющего (БЕ, таб. №), проверить роли и показать назначения" />
    <bpmn:serviceTask id="Form" name="Динамически отобразить форму (ОПР, аудит, КПР) через платформенный конструктор" />
    <bpmn:receiveTask id="AppWaitResult" name="Получить заполненную форму, отобранные для Акта нарушения или отметку" />
    <bpmn:serviceTask id="Calculate" name="Рассчитать результат проверки и сформировать PDF чек-листа и единого Акта проверки" />
    <bpmn:receiveTask id="AppWaitConfirm" name="Получить подтверждение («Отправить») и заблокировать редактирование" />
    <bpmn:serviceTask id="Save" name="Сохранить пакет проверки и предоставить выгрузку PDF (в МП и веб-версии)" />
    <bpmn:exclusiveGateway id="Network" name="Есть связь?" />
    <bpmn:task id="OfflineWait" name="Сохранить в очереди до восстановления связи" />
    <bpmn:sendTask id="Send" name="Выгрузить каталог проверки (result.json, PDF, вложения) в сетевую папку «Октанта»" />
    <bpmn:endEvent id="AppEnd" name="Результат передан в папку обмена" />
    <bpmn:sequenceFlow id="Flow_App_0" sourceRef="AppStart" targetRef="SyncData" />
    <bpmn:sequenceFlow id="Flow_App_1" sourceRef="SyncData" targetRef="Available" />
    <bpmn:sequenceFlow id="Flow_App_2" sourceRef="Available" targetRef="Form" />
    <bpmn:sequenceFlow id="Flow_App_3" sourceRef="Form" targetRef="AppWaitResult" />
    <bpmn:sequenceFlow id="Flow_App_Result" sourceRef="AppWaitResult" targetRef="Calculate" />
    <bpmn:sequenceFlow id="Flow_App_4" sourceRef="Calculate" targetRef="AppWaitConfirm" />
    <bpmn:sequenceFlow id="Flow_App_5" sourceRef="AppWaitConfirm" targetRef="Save" />
    <bpmn:sequenceFlow id="Flow_App_6" sourceRef="Save" targetRef="Network" />
    <bpmn:sequenceFlow id="Flow_App_7" name="Да" sourceRef="Network" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_App_8" name="Нет" sourceRef="Network" targetRef="OfflineWait" />
    <bpmn:sequenceFlow id="Flow_App_9" sourceRef="OfflineWait" targetRef="Send" />
    <bpmn:sequenceFlow id="Flow_App_10" sourceRef="Send" targetRef="AppEnd" />
    <bpmn:startEvent id="AppStart" name="Синхронизация и запуск МП">
      <bpmn:outgoing>Flow_App_0</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerEventDefinition_05gyqv1" />
    </bpmn:startEvent>
  </bpmn:process>
  <bpmn:process id="Process_Octant" name="Октант — TO-BE" isExecutable="false">
    <bpmn:startEvent id="OctStart" name="Сохранены формы и назначения" />
    <bpmn:task id="OctSaveAssignment" name="Сохранить конфигурации опросников / чек-листов / КПР, роли и график проверок" />
    <bpmn:sendTask id="Provide" name="Предоставить в сетевой папке справочники, роли, формы и назначения" />
    <bpmn:endEvent id="OctAppointmentEnd" name="Данные выгружены для синхронизации" />
    <bpmn:sequenceFlow id="Flow_Octant_1" sourceRef="OctStart" targetRef="OctSaveAssignment" />
    <bpmn:sequenceFlow id="Flow_Octant_2" sourceRef="OctSaveAssignment" targetRef="Provide" />
    <bpmn:sequenceFlow id="Flow_Octant_3" sourceRef="Provide" targetRef="OctAppointmentEnd" />
    <bpmn:startEvent id="OctResultStart" name="Получен каталог результата в сетевой папке" />
    <bpmn:sendTask id="OctNotifyBell" name="Показать уведомление («колокольчик») о поступивших проверках подразделения" />
    <bpmn:receiveTask id="OctWaitTransfer" name="Получить подтверждение разбора («Перенести всё»)" />
    <bpmn:task id="OctStore" name="Внести результаты, печатные формы и вложения в журнал проверок «Октанта»" />
    <bpmn:endEvent id="OctEnd" name="Результат учтён в журнале «Октанта»" />
    <bpmn:sequenceFlow id="Flow_Octant_Bell" sourceRef="OctResultStart" targetRef="OctNotifyBell" />
    <bpmn:sequenceFlow id="Flow_Octant_Wait" sourceRef="OctNotifyBell" targetRef="OctWaitTransfer" />
    <bpmn:sequenceFlow id="Flow_Octant_4" sourceRef="OctWaitTransfer" targetRef="OctStore" />
    <bpmn:sequenceFlow id="Flow_Octant_5" sourceRef="OctStore" targetRef="OctEnd" />
  </bpmn:process>
