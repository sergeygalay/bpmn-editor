<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-to-be" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be">
<bpmn:collaboration id="Collaboration_contractor-opr-to-be">
<bpmn:participant id="Participant_Window" name="Единое окно" processRef="Process_Window"/>
<bpmn:participant id="Participant_Checker" name="Проверяющий" processRef="Process_Checker"/>
<bpmn:participant id="Participant_App" name="Суперника" processRef="Process_App"/>
<bpmn:participant id="Participant_Octant" name="Октант" processRef="Process_Octant"/>
<bpmn:messageFlow id="Message_Assignment" name="Назначение проверяющего" sourceRef="Assign" targetRef="OctStart"/>
<bpmn:messageFlow id="Message_ReferenceData" name="Назначения и контрольные листы" sourceRef="Provide" targetRef="Available"/>
<bpmn:messageFlow id="Message_OpenApp" name="Открытие приложения" sourceRef="Open" targetRef="AppStart"/>
<bpmn:messageFlow id="Message_List" name="Список назначений" sourceRef="Available" targetRef="Open"/>
<bpmn:messageFlow id="Message_ChooseAssigned" name="Выбрана назначенная проверка" sourceRef="Select" targetRef="Form"/>
<bpmn:messageFlow id="Message_ChooseManual" name="Новая проверка без назначения" sourceRef="Manual" targetRef="Form"/>
<bpmn:messageFlow id="Message_ReadyForm" name="Контрольный лист / акт" sourceRef="Form" targetRef="Fill"/>
<bpmn:messageFlow id="Message_CheckFilled" name="Заполненная форма и нарушения" sourceRef="Fill" targetRef="Calculate"/>
<bpmn:messageFlow id="Message_NotPerformed" name="Работа не проводится" sourceRef="NotWork" targetRef="Calculate"/>
<bpmn:messageFlow id="Message_Outcome" name="Расчётный итог / отметка" sourceRef="Calculate" targetRef="Record"/>
<bpmn:messageFlow id="Message_Confirm" name="Подтверждение отправки" sourceRef="Record" targetRef="AppWaitConfirm"/>
<bpmn:messageFlow id="Message_Result" name="Результат и приложения" sourceRef="Send" targetRef="OctResultStart"/>
</bpmn:collaboration>
<bpmn:process id="Process_Window" name="Единое окно — TO-BE" isExecutable="false">
<bpmn:startEvent id="Start" name="Необходима проверка"/>
<bpmn:userTask id="Organize" name="Запланировать проверку в «Октанте»"/>
<bpmn:userTask id="Assign" name="Назначить проверяющего"/>
<bpmn:endEvent id="WindowEnd" name="Проверка назначена"/>
<bpmn:sequenceFlow id="Flow_Window_1" sourceRef="Start" targetRef="Organize"/>
<bpmn:sequenceFlow id="Flow_Window_2" sourceRef="Organize" targetRef="Assign"/>
<bpmn:sequenceFlow id="Flow_Window_3" sourceRef="Assign" targetRef="WindowEnd"/>
</bpmn:process>
<bpmn:process id="Process_Checker" name="Проверяющий — TO-BE" isExecutable="false">
<bpmn:startEvent id="CheckerStart" name="Необходима проверка"/>
<bpmn:userTask id="Open" name="Открыть «Супернику»"/>
<bpmn:exclusiveGateway id="HasAssignment" name="Есть назначение?"/>
<bpmn:userTask id="Select" name="Выбрать назначенную проверку"/>
<bpmn:userTask id="Manual" name="Создать проверку без назначения"/>
<bpmn:exclusiveGateway id="CanCheck" name="Проверку можно провести?"/>
<bpmn:userTask id="Fill" name="Провести ОПР, аудит или КПР"/>
<bpmn:userTask id="NotWork" name="Отметить «Работа не проводится»"/>
<bpmn:userTask id="Record" name="Просмотреть итог и подтвердить отправку"/>
<bpmn:endEvent id="CheckerEnd" name="Результат подтверждён"/>
<bpmn:sequenceFlow id="Flow_Checker_1" sourceRef="CheckerStart" targetRef="Open"/>
<bpmn:sequenceFlow id="Flow_Checker_2" sourceRef="Open" targetRef="HasAssignment"/>
<bpmn:sequenceFlow id="Flow_Checker_3" sourceRef="HasAssignment" targetRef="Select" name="Да"/>
<bpmn:sequenceFlow id="Flow_Checker_4" sourceRef="HasAssignment" targetRef="Manual" name="Нет"/>
<bpmn:sequenceFlow id="Flow_Checker_5" sourceRef="Select" targetRef="CanCheck"/>
<bpmn:sequenceFlow id="Flow_Checker_6" sourceRef="CanCheck" targetRef="Fill" name="Да"/>
<bpmn:sequenceFlow id="Flow_Checker_7" sourceRef="CanCheck" targetRef="NotWork" name="Нет"/>
<bpmn:sequenceFlow id="Flow_Checker_8" sourceRef="Manual" targetRef="Fill"/>
<bpmn:sequenceFlow id="Flow_Checker_9" sourceRef="Fill" targetRef="Record"/>
<bpmn:sequenceFlow id="Flow_Checker_10" sourceRef="NotWork" targetRef="Record"/>
<bpmn:sequenceFlow id="Flow_Checker_11" sourceRef="Record" targetRef="CheckerEnd"/>
</bpmn:process>
<bpmn:process id="Process_App" name="Суперника — TO-BE" isExecutable="false">
<bpmn:startEvent id="AppStart" name="Открыто приложение"/>
<bpmn:task id="Available" name="Определить проверяющего и показать назначения"/>
<bpmn:task id="Form" name="Предоставить соответствующую форму"/>
<bpmn:task id="Calculate" name="Рассчитать результат или зафиксировать отметку"/>
<bpmn:receiveTask id="AppWaitConfirm" name="Получить подтверждение результата"/>
<bpmn:task id="Save" name="Сохранить результат проверки"/>
<bpmn:exclusiveGateway id="Network" name="Есть связь?"/>
<bpmn:task id="OfflineWait" name="Сохранить до восстановления связи"/>
<bpmn:sendTask id="Send" name="Передать результат для учёта в «Октанте»"/>
<bpmn:endEvent id="AppEnd" name="Результат передан"/>
<bpmn:sequenceFlow id="Flow_App_1" sourceRef="AppStart" targetRef="Available"/>
<bpmn:sequenceFlow id="Flow_App_2" sourceRef="Available" targetRef="Form"/>
<bpmn:sequenceFlow id="Flow_App_3" sourceRef="Form" targetRef="Calculate"/>
<bpmn:sequenceFlow id="Flow_App_4" sourceRef="Calculate" targetRef="AppWaitConfirm"/>
<bpmn:sequenceFlow id="Flow_App_5" sourceRef="AppWaitConfirm" targetRef="Save"/>
<bpmn:sequenceFlow id="Flow_App_6" sourceRef="Save" targetRef="Network"/>
<bpmn:sequenceFlow id="Flow_App_7" sourceRef="Network" targetRef="Send" name="Да"/>
<bpmn:sequenceFlow id="Flow_App_8" sourceRef="Network" targetRef="OfflineWait" name="Нет"/>
<bpmn:sequenceFlow id="Flow_App_9" sourceRef="OfflineWait" targetRef="Send"/>
<bpmn:sequenceFlow id="Flow_App_10" sourceRef="Send" targetRef="AppEnd"/>
</bpmn:process>
<bpmn:process id="Process_Octant" name="Октант — TO-BE" isExecutable="false">
<bpmn:startEvent id="OctStart" name="Создано назначение"/>
<bpmn:task id="OctSaveAssignment" name="Сохранить план и назначение"/>
<bpmn:sendTask id="Provide" name="Предоставить назначения, формы и справочники"/>
<bpmn:endEvent id="OctAppointmentEnd" name="Назначение доступно"/>
<bpmn:startEvent id="OctResultStart" name="Получен результат"/>
<bpmn:task id="OctStore" name="Внести результат в журнал проверок"/>
<bpmn:endEvent id="OctEnd" name="Результат учтён"/>
<bpmn:sequenceFlow id="Flow_Octant_1" sourceRef="OctStart" targetRef="OctSaveAssignment"/>
<bpmn:sequenceFlow id="Flow_Octant_2" sourceRef="OctSaveAssignment" targetRef="Provide"/>
<bpmn:sequenceFlow id="Flow_Octant_3" sourceRef="Provide" targetRef="OctAppointmentEnd"/>
<bpmn:sequenceFlow id="Flow_Octant_4" sourceRef="OctResultStart" targetRef="OctStore"/>
<bpmn:sequenceFlow id="Flow_Octant_5" sourceRef="OctStore" targetRef="OctEnd"/>
</bpmn:process>
