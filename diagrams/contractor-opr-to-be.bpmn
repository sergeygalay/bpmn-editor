<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_contractor-opr-to-be" targetNamespace="https://sergeygalay.github.io/bpmn-editor/contractor-opr-to-be">
  <bpmn:collaboration id="Collaboration_contractor-opr-to-be">
    <bpmn:participant id="Participant_Company" name="Предприятие / оценка производителя работ" processRef="Process_Company" />
    <bpmn:participant id="Participant_Octant" name="Система «Октант» (способ обмена не определён)" processRef="Process_Octant" />
    <bpmn:messageFlow id="Message_1" name="Результат ОПР (канал уточняется)" sourceRef="Sync" targetRef="OctStart" />
  </bpmn:collaboration>
  <bpmn:process id="Process_Company" name="Оценка производителя работ — целевой процесс MVP" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Company">
      <bpmn:lane id="Lane_Checker" name="Уполномоченный проверяющий">
        <bpmn:flowNodeRef>Open</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Fill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Network</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Reopen</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Online</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeNet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Photo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Choice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Finish</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_App" name="«Суперника» / цифровой чек-лист">
        <bpmn:flowNodeRef>Auth</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Critical</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Unsat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>MergeGrade</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Sync</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Denied</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Window" name="Единое окно ПБиОТ">
        <bpmn:flowNodeRef>Start</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Schedule</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start" name="Плановая ОПР" />
    <bpmn:userTask id="Open" name="Открыть и заранее загрузить чек-лист" />
    <bpmn:exclusiveGateway id="Auth" name="Полномочия по ОРД подтверждены?" />
    <bpmn:userTask id="Fill" name="Заполнить реквизиты, пункты и примечания (офлайн допустим)" />
    <bpmn:exclusiveGateway id="Network" name="Есть сеть для загрузки фото?" />
    <bpmn:userTask id="Reopen" name="Вернуться онлайн и повторно открыть приложение" />
    <bpmn:task id="Online" name="Связь доступна" />
    <bpmn:exclusiveGateway id="MergeNet" />
    <bpmn:userTask id="Photo" name="Добавить фото к конкретным пунктам (при наличии)" />
    <bpmn:exclusiveGateway id="Critical" name="Нарушен блокирующий критерий?" />
    <bpmn:businessRuleTask id="Unsat" name="Автоматически установить «неуд»" />
    <bpmn:userTask id="Choice" name="Выбрать итог «уд» / «неуд»" />
    <bpmn:exclusiveGateway id="MergeGrade" />
    <bpmn:userTask id="Finish" name="Завершить ОПР; при необходимости получить печатную форму" />
    <bpmn:serviceTask id="Sync" name="Сохранить и передать результат для учёта в «Октанте» (способ уточняется)" />
    <bpmn:endEvent id="End" name="ОПР завершена" />
    <bpmn:sequenceFlow id="Sequence_01" sourceRef="Start" targetRef="Schedule" />
    <bpmn:sequenceFlow id="Sequence_02" sourceRef="Schedule" targetRef="Open" />
    <bpmn:sequenceFlow id="Sequence_03" sourceRef="Open" targetRef="Auth" />
    <bpmn:sequenceFlow id="Sequence_04" name="Нет" sourceRef="Auth" targetRef="Denied" />
    <bpmn:sequenceFlow id="Sequence_05" name="Да" sourceRef="Auth" targetRef="Fill" />
    <bpmn:sequenceFlow id="Sequence_06" sourceRef="Fill" targetRef="Network" />
    <bpmn:sequenceFlow id="Sequence_07" name="Нет" sourceRef="Network" targetRef="Reopen" />
    <bpmn:sequenceFlow id="Sequence_08" name="Да" sourceRef="Network" targetRef="Online" />
    <bpmn:sequenceFlow id="Sequence_09" sourceRef="Reopen" targetRef="MergeNet" />
    <bpmn:sequenceFlow id="Sequence_10" sourceRef="Online" targetRef="MergeNet" />
    <bpmn:sequenceFlow id="Sequence_11" sourceRef="MergeNet" targetRef="Photo" />
    <bpmn:sequenceFlow id="Sequence_12" sourceRef="Photo" targetRef="Critical" />
    <bpmn:sequenceFlow id="Sequence_13" name="Да" sourceRef="Critical" targetRef="Unsat" />
    <bpmn:sequenceFlow id="Sequence_14" name="Нет" sourceRef="Critical" targetRef="Choice" />
    <bpmn:sequenceFlow id="Sequence_15" sourceRef="Unsat" targetRef="MergeGrade" />
    <bpmn:sequenceFlow id="Sequence_16" sourceRef="Choice" targetRef="MergeGrade" />
    <bpmn:sequenceFlow id="Sequence_17" sourceRef="MergeGrade" targetRef="Finish" />
    <bpmn:sequenceFlow id="Sequence_18" sourceRef="Finish" targetRef="Sync" />
    <bpmn:sequenceFlow id="Sequence_19" sourceRef="Sync" targetRef="End" />
    <bpmn:userTask id="Schedule" name="Организовать проверку по графику" />
    <bpmn:endEvent id="Denied" name="Нет допуска к ОПР" />
  </bpmn:process>
  <bpmn:process id="Process_Octant" name="Регистрация результата в Октант" isExecutable="false">
    <bpmn:startEvent id="OctStart" name="Результат поступил" />
    <bpmn:task id="OctStore" name="Учесть результат ОПР" />
    <bpmn:endEvent id="OctEnd" name="Результат учтён" />
    <bpmn:sequenceFlow id="Sequence_20" sourceRef="OctStart" targetRef="OctStore" />
    <bpmn:sequenceFlow id="Sequence_21" sourceRef="OctStore" targetRef="OctEnd" />
  </bpmn:process>
