<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_BIO_ASIS_V2" targetNamespace="https://sergeygalay.github.io/bpmn-editor/bio-antimotivation-as-is">
  <bpmn:collaboration id="Collaboration_BIO_ASIS_V2">
    <bpmn:participant id="Participant_BIO_ASIS_V2" name="БИО — текущий процесс" processRef="Process_BIO_ASIS_V2" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BIO_ASIS_V2" name="AS-IS — регистрация, модерация, устранение и начисление баллов" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ASIS_V2">
      <bpmn:lane id="Lane_User_ASIS_V2" name="Пользователь">
        <bpmn:flowNodeRef>Start_Danger_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Register_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UserDetails_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_UserResult_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ViewResult_ASIS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Admin_ASIS_V2" name="Администратор / модератор">
        <bpmn:flowNodeRef>Task_InitialModeration_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Confirmed_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkRejected_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_MarkConfirmed_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Catch_Eliminated_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FinalModeration_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SetFlags_ASIS</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System_ASIS_V2" name="Система БИО">
        <bpmn:flowNodeRef>Task_NotifyRejected_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Rejected_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalcPoints_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AwardPoints_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Start_Inactivity_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_KeepProgress_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_NoImpact_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecalcStatus_ASIS</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyPoints_ASIS</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Danger_ASIS" name="Опасность выявлена" />
    <bpmn:userTask id="Task_Register_ASIS" name="Зарегистрировать опасность и заполнить заявку" />
    <bpmn:userTask id="Task_UserDetails_ASIS" name="Указать сведения об участии / рекомендации (если есть)" />
    <bpmn:userTask id="Task_InitialModeration_ASIS" name="Проверить заявку и достоверность опасности" />
    <bpmn:exclusiveGateway id="Gateway_Confirmed_ASIS" name="Опасность подтверждена?" />
    <bpmn:userTask id="Task_MarkRejected_ASIS" name="Проставить признак «Опасность отклонена»" />
    <bpmn:sendTask id="Task_NotifyRejected_ASIS" name="Уведомить пользователя об отклонении" />
    <bpmn:endEvent id="End_Rejected_ASIS" name="Заявка закрыта без баллов" />
    <bpmn:userTask id="Task_MarkConfirmed_ASIS" name="Проставить признак «Опасность подтверждена»" />
    <bpmn:intermediateCatchEvent id="Catch_Eliminated_ASIS" name="Получен факт устранения опасности">
      <bpmn:messageEventDefinition id="MessageDef_Eliminated_ASIS" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_FinalModeration_ASIS" name="Проверить карточку после устранения" />
    <bpmn:userTask id="Task_SetFlags_ASIS" name="Проставить / скорректировать признаки в карточке: устранено; участие; рекомендация; рекомендация применена; доп. баллы">
      <bpmn:documentation>Администратор вручную подтверждает или снимает признаки, указанные пользователем, и может добавить подтвержденные признаки, даже если пользователь их не указал.</bpmn:documentation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CalcPoints_ASIS" name="Рассчитать баллы: базовые за устранение + подтвержденные дополнительные">
      <bpmn:documentation>Дополнительные баллы за подтвержденное участие пользователя в устранении и за подтвержденные рекомендации могут суммироваться. Конкретные числовые значения в процессе не фиксируются.</bpmn:documentation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_AwardPoints_ASIS" name="Начислить баллы после устранения опасности" />
    <bpmn:startEvent id="Start_Inactivity_ASIS" name="Пользователь длительно неактивен">
      <bpmn:timerEventDefinition id="Timer_Inactivity_ASIS" />
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_KeepProgress_ASIS" name="Оставить накопленные баллы и статус без изменений" />
    <bpmn:endEvent id="End_NoImpact_ASIS" name="Неактивность не влияет на прогресс" />
    <bpmn:sequenceFlow id="F_ASIS_1" sourceRef="Start_Danger_ASIS" targetRef="Task_Register_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_2" sourceRef="Task_Register_ASIS" targetRef="Task_UserDetails_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_3" sourceRef="Task_UserDetails_ASIS" targetRef="Task_InitialModeration_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_4" sourceRef="Task_InitialModeration_ASIS" targetRef="Gateway_Confirmed_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_5N" name="Нет" sourceRef="Gateway_Confirmed_ASIS" targetRef="Task_MarkRejected_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_6N" sourceRef="Task_MarkRejected_ASIS" targetRef="Task_NotifyRejected_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_7N" sourceRef="Task_NotifyRejected_ASIS" targetRef="End_Rejected_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_5Y" name="Да" sourceRef="Gateway_Confirmed_ASIS" targetRef="Task_MarkConfirmed_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_6Y" sourceRef="Task_MarkConfirmed_ASIS" targetRef="Catch_Eliminated_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_7Y" sourceRef="Catch_Eliminated_ASIS" targetRef="Task_FinalModeration_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_8Y" sourceRef="Task_FinalModeration_ASIS" targetRef="Task_SetFlags_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_9Y" sourceRef="Task_SetFlags_ASIS" targetRef="Task_CalcPoints_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_10Y" sourceRef="Task_CalcPoints_ASIS" targetRef="Task_AwardPoints_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_11Y" sourceRef="Task_AwardPoints_ASIS" targetRef="Task_RecalcStatus_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_12Y" sourceRef="Task_RecalcStatus_ASIS" targetRef="Task_NotifyPoints_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_13Y" sourceRef="Task_NotifyPoints_ASIS" targetRef="Task_ViewResult_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_15" sourceRef="Start_Inactivity_ASIS" targetRef="Task_KeepProgress_ASIS" />
    <bpmn:sequenceFlow id="F_ASIS_16" sourceRef="Task_KeepProgress_ASIS" targetRef="End_NoImpact_ASIS" />
    <bpmn:serviceTask id="Task_RecalcStatus_ASIS" name="Пересчитать игровой статус и текущий рейтинг" />
    <bpmn:sendTask id="Task_NotifyPoints_ASIS" name="Показать начисленные баллы и обновленный статус" />
    <bpmn:endEvent id="End_UserResult_ASIS" name="Прогресс пользователя обновлен" />
    <bpmn:userTask id="Task_ViewResult_ASIS" name="Ознакомиться с результатом начисления" />
    <bpmn:sequenceFlow id="F_ASIS_14Y" sourceRef="Task_ViewResult_ASIS" targetRef="End_UserResult_ASIS" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_ASIS_V2">
    <bpmndi:BPMNPlane id="Plane_ASIS_V2" bpmnElement="Collaboration_BIO_ASIS_V2">
      <bpmndi:BPMNShape id="Participant_BIO_ASIS_V2_di" bpmnElement="Participant_BIO_ASIS_V2" isHorizontal="true">
        <dc:Bounds x="40" y="30" width="3640" height="690" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_System_ASIS_V2_di" bpmnElement="Lane_System_ASIS_V2" isHorizontal="true">
        <dc:Bounds x="70" y="470" width="3610" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Admin_ASIS_V2_di" bpmnElement="Lane_Admin_ASIS_V2" isHorizontal="true">
        <dc:Bounds x="70" y="220" width="3610" height="250" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_User_ASIS_V2_di" bpmnElement="Lane_User_ASIS_V2" isHorizontal="true">
        <dc:Bounds x="70" y="30" width="3610" height="190" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Danger_ASIS_di" bpmnElement="Start_Danger_ASIS">
