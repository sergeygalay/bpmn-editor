      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_CalcPoints_ASIS_di" bpmnElement="Task_CalcPoints_ASIS">
        <dc:Bounds x="2115" y="500" width="220" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_AwardPoints_ASIS_di" bpmnElement="Task_AwardPoints_ASIS">
        <dc:Bounds x="2395" y="500" width="190" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_Inactivity_ASIS_di" bpmnElement="Start_Inactivity_ASIS">
        <dc:Bounds x="120" y="610" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_KeepProgress_ASIS_di" bpmnElement="Task_KeepProgress_ASIS">
        <dc:Bounds x="210" y="590" width="230" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_NoImpact_ASIS_di" bpmnElement="End_NoImpact_ASIS">
        <dc:Bounds x="510" y="612" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_RecalcStatus_ASIS_di" bpmnElement="Task_RecalcStatus_ASIS">
        <dc:Bounds x="2680" y="505" width="220" height="70" />
        <bpmndi:BPMNLabel />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_NotifyPoints_ASIS_di" bpmnElement="Task_NotifyPoints_ASIS">
        <dc:Bounds x="2995" y="505" width="190" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_UserResult_ASIS_di" bpmnElement="End_UserResult_ASIS">
        <dc:Bounds x="3490" y="112" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="3473" y="148" width="70" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_ViewResult_ASIS_di" bpmnElement="Task_ViewResult_ASIS">
        <dc:Bounds x="3210" y="95" width="200" height="70" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F_ASIS_1_di" bpmnElement="F_ASIS_1">
        <di:waypoint x="156" y="123" />
        <di:waypoint x="210" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ASIS_2_di" bpmnElement="F_ASIS_2">
        <di:waypoint x="390" y="120" />
        <di:waypoint x="450" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ASIS_3_di" bpmnElement="F_ASIS_3">
        <di:waypoint x="680" y="120" />
        <di:waypoint x="715" y="120" />
        <di:waypoint x="715" y="310" />
        <di:waypoint x="750" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ASIS_4_di" bpmnElement="F_ASIS_4">
        <di:waypoint x="940" y="310" />
        <di:waypoint x="1010" y="310" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="F_ASIS_5N_di" bpmnElement="F_ASIS_5N">
        <di:waypoint x="1035" y="285" />
