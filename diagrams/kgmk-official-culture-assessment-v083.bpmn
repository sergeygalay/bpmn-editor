<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-official-culture-assessment-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-official-culture-assessment-v083">
  <bpmn:collaboration id="Collab_kgmk-official-culture-assessment-v083"><bpmn:participant id="Part_kgmk-official-culture-assessment-v083" name="Публикация официального годового замера культуры" processRef="Proc_kgmk-official-culture-assessment-v083"/></bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-official-culture-assessment-v083" name="Публикация официального годового замера культуры" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-official-culture-assessment-v083"><bpmn:lane id="L_Admin" name="Администратор программы (ГО)"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef><bpmn:flowNodeRef>ConfirmGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Cancel</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>Parse</bpmn:flowNodeRef><bpmn:flowNodeRef>Parsed</bpmn:flowNodeRef><bpmn:flowNodeRef>ParseError</bpmn:flowNodeRef><bpmn:flowNodeRef>Coverage</bpmn:flowNodeRef><bpmn:flowNodeRef>CoverageGate</bpmn:flowNodeRef><bpmn:flowNodeRef>CoverageError</bpmn:flowNodeRef><bpmn:flowNodeRef>YearCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>YearGate</bpmn:flowNodeRef><bpmn:flowNodeRef>YearError</bpmn:flowNodeRef><bpmn:flowNodeRef>SameCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>SameGate</bpmn:flowNodeRef><bpmn:flowNodeRef>ConfirmMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>Fix</bpmn:flowNodeRef><bpmn:flowNodeRef>PreviousGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Archive</bpmn:flowNodeRef><bpmn:flowNodeRef>ArchiveMerge</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="S" name="Получены результаты годового замера"/><bpmn:userTask id="Prepare" name="Указать год и загрузить данные по всем БЕ"/><bpmn:serviceTask id="Parse" name="Разобрать и сопоставить данные"/><bpmn:exclusiveGateway id="Parsed" name="Данные разобраны?"/><bpmn:endEvent id="ParseError" name="Замер не зафиксирован: ошибка данных"/><bpmn:businessRuleTask id="Coverage" name="Проверить полноту и известность БЕ"/><bpmn:exclusiveGateway id="CoverageGate" name="Состав БЕ корректен?"/><bpmn:endEvent id="CoverageError" name="Замер не зафиксирован: состав БЕ некорректен"/><bpmn:businessRuleTask id="YearCheck" name="Проверить допустимость года"/><bpmn:exclusiveGateway id="YearGate" name="Год допустим?"/><bpmn:endEvent id="YearError" name="Замер не зафиксирован: год недопустим"/><bpmn:serviceTask id="SameCheck" name="Проверить наличие замера за этот год"/><bpmn:exclusiveGateway id="SameGate" name="Замер этого года уже существует?"/><bpmn:userTask id="Confirm" name="Подтвердить перезапись замера за этот год"/><bpmn:exclusiveGateway id="ConfirmGate" name="Перезапись подтверждена?"/><bpmn:endEvent id="Cancel" name="Замер не изменён"/><bpmn:exclusiveGateway id="ConfirmMerge" name="Перейти к фиксации замера"/><bpmn:serviceTask id="Fix" name="Зафиксировать официальный замер и уровни БЕ"/><bpmn:exclusiveGateway id="PreviousGate" name="Есть предыдущий замер другого года?"/><bpmn:serviceTask id="Archive" name="Перенести предыдущий замер в архив"/><bpmn:exclusiveGateway id="ArchiveMerge" name="Завершить публикацию"/><bpmn:endEvent id="E" name="Официальные уровни БЕ доступны магазину"/>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Prepare"/><bpmn:sequenceFlow id="F2" sourceRef="Prepare" targetRef="Parse"/><bpmn:sequenceFlow id="F3" sourceRef="Parse" targetRef="Parsed"/><bpmn:sequenceFlow id="F4" sourceRef="Parsed" targetRef="Coverage" name="Да"/><bpmn:sequenceFlow id="F5" sourceRef="Parsed" targetRef="ParseError" name="Нет"/><bpmn:sequenceFlow id="F6" sourceRef="Coverage" targetRef="CoverageGate"/><bpmn:sequenceFlow id="F7" sourceRef="CoverageGate" targetRef="YearCheck" name="Да"/><bpmn:sequenceFlow id="F8" sourceRef="CoverageGate" targetRef="CoverageError" name="Нет"/><bpmn:sequenceFlow id="F9" sourceRef="YearCheck" targetRef="YearGate"/><bpmn:sequenceFlow id="F10" sourceRef="YearGate" targetRef="SameCheck" name="Да"/><bpmn:sequenceFlow id="F11" sourceRef="YearGate" targetRef="YearError" name="Нет"/><bpmn:sequenceFlow id="F12" sourceRef="SameCheck" targetRef="SameGate"/><bpmn:sequenceFlow id="F13" sourceRef="SameGate" targetRef="ConfirmMerge" name="Нет"/><bpmn:sequenceFlow id="F14" sourceRef="SameGate" targetRef="Confirm" name="Да"/><bpmn:sequenceFlow id="F15" sourceRef="Confirm" targetRef="ConfirmGate"/><bpmn:sequenceFlow id="F16" sourceRef="ConfirmGate" targetRef="ConfirmMerge" name="Да"/><bpmn:sequenceFlow id="F17" sourceRef="ConfirmGate" targetRef="Cancel" name="Нет"/><bpmn:sequenceFlow id="F18" sourceRef="ConfirmMerge" targetRef="Fix"/><bpmn:sequenceFlow id="F19" sourceRef="Fix" targetRef="PreviousGate"/><bpmn:sequenceFlow id="F20" sourceRef="PreviousGate" targetRef="Archive" name="Да"/><bpmn:sequenceFlow id="F21" sourceRef="PreviousGate" targetRef="ArchiveMerge" name="Нет"/><bpmn:sequenceFlow id="F22" sourceRef="Archive" targetRef="ArchiveMerge"/><bpmn:sequenceFlow id="F23" sourceRef="ArchiveMerge" targetRef="E"/>
    <bpmn:textAnnotation id="AnnRole"><bpmn:text>По результатам встречи с заказчиком функция публикации официального годового замера закреплена за ролью «Администратор программы (ГО)». Роль «Корпоративный ПБиОТ» исключена.</bpmn:text></bpmn:textAnnotation><bpmn:association id="AssocRole" sourceRef="Prepare" targetRef="AnnRole"/>
  </bpmn:process>
