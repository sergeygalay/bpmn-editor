<bpmn:collaboration id="Collab_measure083"><bpmn:participant id="Part_measure083" name="Публикация официального годового замера культуры 0.8.3" processRef="Proc_measure083"/></bpmn:collaboration>
<bpmn:process id="Proc_measure083" name="Публикация официального годового замера культуры 0.8.3" isExecutable="false">
<bpmn:laneSet id="LS"><bpmn:lane id="L_Corp" name="Корпоративный ПБиОТ"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>Prepare</bpmn:flowNodeRef><bpmn:flowNodeRef>Confirm</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>Parse</bpmn:flowNodeRef><bpmn:flowNodeRef>Parsed</bpmn:flowNodeRef><bpmn:flowNodeRef>Coverage</bpmn:flowNodeRef><bpmn:flowNodeRef>CoverageGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Year</bpmn:flowNodeRef><bpmn:flowNodeRef>Same</bpmn:flowNodeRef><bpmn:flowNodeRef>Fix</bpmn:flowNodeRef><bpmn:flowNodeRef>Archive</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S" name="Получены результаты годового замера"/><bpmn:userTask id="Prepare" name="Загрузить CSV / JSON или вставить таблицу по всем БЕ"/><bpmn:serviceTask id="Parse" name="Разобрать и сопоставить данные"/><bpmn:exclusiveGateway id="Parsed" name="Данные разобраны?"/><bpmn:businessRuleTask id="Coverage" name="Проверить полный перечень и известность БЕ"/><bpmn:exclusiveGateway id="CoverageGate" name="Состав БЕ корректен?"/><bpmn:exclusiveGateway id="Year" name="Год допустим и не старше действующего?"/><bpmn:exclusiveGateway id="Same" name="Замер этого года уже есть?"/><bpmn:userTask id="Confirm" name="Подтвердить перезапись текущего года"/><bpmn:serviceTask id="Fix" name="Зафиксировать официальный замер и уровни БЕ"/><bpmn:serviceTask id="Archive" name="Перенести предыдущий год в архив"/><bpmn:endEvent id="E" name="Официальные уровни доступны магазину"/>
<bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Prepare"/><bpmn:sequenceFlow id="F2" sourceRef="Prepare" targetRef="Parse"/><bpmn:sequenceFlow id="F3" sourceRef="Parse" targetRef="Parsed"/><bpmn:sequenceFlow id="F4" sourceRef="Parsed" targetRef="Prepare" name="Нет"/><bpmn:sequenceFlow id="F5" sourceRef="Parsed" targetRef="Coverage" name="Да"/><bpmn:sequenceFlow id="F6" sourceRef="Coverage" targetRef="CoverageGate"/><bpmn:sequenceFlow id="F7" sourceRef="CoverageGate" targetRef="Prepare" name="Нет"/><bpmn:sequenceFlow id="F8" sourceRef="CoverageGate" targetRef="Year" name="Да"/><bpmn:sequenceFlow id="F9" sourceRef="Year" targetRef="Prepare" name="Нет"/><bpmn:sequenceFlow id="F10" sourceRef="Year" targetRef="Same" name="Да"/><bpmn:sequenceFlow id="F11" sourceRef="Same" targetRef="Confirm" name="Да"/><bpmn:sequenceFlow id="F12" sourceRef="Same" targetRef="Fix" name="Нет"/><bpmn:sequenceFlow id="F13" sourceRef="Confirm" targetRef="Fix" name="Подтверждено"/><bpmn:sequenceFlow id="F14" sourceRef="Fix" targetRef="Archive"/><bpmn:sequenceFlow id="F15" sourceRef="Archive" targetRef="E"/>
<bpmn:textAnnotation id="Ann"><bpmn:text>Интерфейс говорит о перезаписи «один раз в год», но ограничение количества перезаписей в логике 0.8.3 не реализовано. Требуется бизнес-решение.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc" sourceRef="Same" targetRef="Ann"/>
</bpmn:process>
