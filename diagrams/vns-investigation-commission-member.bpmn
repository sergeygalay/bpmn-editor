<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_CommissionMember" targetNamespace="https://sergeygalay.github.io/bpmn-editor/vns-investigation-commission-member">
  <bpmn:collaboration id="Collaboration_CommissionMember">
    <bpmn:participant id="Participant_CommissionMember" name="Процесс члена комиссии" processRef="Process_CommissionMember"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CommissionMember" isExecutable="false">
    <bpmn:laneSet id="LaneSet_CommissionMember"><bpmn:lane id="Lane_CommissionMember" name="Член комиссии">
      <bpmn:flowNodeRef>StartEvent_Member</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Upload</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ValidateFacts</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_InitialHypotheses</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_ReviewAI</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_MergeCheck</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CheckHypotheses</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_EnoughData</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_CollectMore</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_RCA</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Actions</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Report</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_Member</bpmn:flowNodeRef>
    </bpmn:lane></bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Member" name="Назначен членом комиссии"><bpmn:outgoing>Flow_1</bpmn:outgoing></bpmn:startEvent>
    <bpmn:userTask id="Task_Upload" name="Загрузить материалы"><bpmn:incoming>Flow_1</bpmn:incoming><bpmn:outgoing>Flow_2</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ValidateFacts" name="Подтвердить / отклонить / уточнить факты"><bpmn:incoming>Flow_2</bpmn:incoming><bpmn:outgoing>Flow_3</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_InitialHypotheses" name="Зафиксировать первоначальные гипотезы"><bpmn:incoming>Flow_3</bpmn:incoming><bpmn:outgoing>Flow_4</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_ReviewAI" name="Рассмотреть дополнительные гипотезы ИИ"><bpmn:incoming>Flow_4</bpmn:incoming><bpmn:outgoing>Flow_5</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_MergeCheck" gatewayDirection="Converging"><bpmn:incoming>Flow_5</bpmn:incoming><bpmn:incoming>Flow_9</bpmn:incoming><bpmn:outgoing>Flow_6</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CheckHypotheses" name="Проверить гипотезы по фактам"><bpmn:incoming>Flow_6</bpmn:incoming><bpmn:outgoing>Flow_7</bpmn:outgoing></bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_EnoughData" name="Данных достаточно?" gatewayDirection="Diverging"><bpmn:incoming>Flow_7</bpmn:incoming><bpmn:outgoing>Flow_8</bpmn:outgoing><bpmn:outgoing>Flow_10</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_CollectMore" name="Дособрать материалы и подтвердить новые факты"><bpmn:incoming>Flow_8</bpmn:incoming><bpmn:outgoing>Flow_9</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_RCA" name="Участвовать в RCA"><bpmn:incoming>Flow_10</bpmn:incoming><bpmn:outgoing>Flow_11</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_Actions" name="Проверить / уточнить мероприятия"><bpmn:incoming>Flow_11</bpmn:incoming><bpmn:outgoing>Flow_12</bpmn:outgoing></bpmn:userTask>
    <bpmn:userTask id="Task_Report" name="Проверить итоговый отчет"><bpmn:incoming>Flow_12</bpmn:incoming><bpmn:outgoing>Flow_13</bpmn:outgoing></bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Member" name="Проверка завершена"><bpmn:incoming>Flow_13</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Member" targetRef="Task_Upload"/><bpmn:sequenceFlow id="Flow_2" sourceRef="Task_Upload" targetRef="Task_ValidateFacts"/><bpmn:sequenceFlow id="Flow_3" sourceRef="Task_ValidateFacts" targetRef="Task_InitialHypotheses"/><bpmn:sequenceFlow id="Flow_4" sourceRef="Task_InitialHypotheses" targetRef="Task_ReviewAI"/><bpmn:sequenceFlow id="Flow_5" sourceRef="Task_ReviewAI" targetRef="Gateway_MergeCheck"/><bpmn:sequenceFlow id="Flow_6" sourceRef="Gateway_MergeCheck" targetRef="Task_CheckHypotheses"/><bpmn:sequenceFlow id="Flow_7" sourceRef="Task_CheckHypotheses" targetRef="Gateway_EnoughData"/><bpmn:sequenceFlow id="Flow_8" name="Нет" sourceRef="Gateway_EnoughData" targetRef="Task_CollectMore"/><bpmn:sequenceFlow id="Flow_9" name="Повторная проверка" sourceRef="Task_CollectMore" targetRef="Gateway_MergeCheck"/><bpmn:sequenceFlow id="Flow_10" name="Да" sourceRef="Gateway_EnoughData" targetRef="Task_RCA"/><bpmn:sequenceFlow id="Flow_11" sourceRef="Task_RCA" targetRef="Task_Actions"/><bpmn:sequenceFlow id="Flow_12" sourceRef="Task_Actions" targetRef="Task_Report"/><bpmn:sequenceFlow id="Flow_13" sourceRef="Task_Report" targetRef="EndEvent_Member"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_CommissionMember"><bpmndi:BPMNPlane id="BPMNPlane_CommissionMember" bpmnElement="Collaboration_CommissionMember">
    <bpmndi:BPMNShape id="Shape_Participant_Member" bpmnElement="Participant_CommissionMember" isHorizontal="true"><dc:Bounds x="40" y="70" width="2380" height="350"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Lane_Member" bpmnElement="Lane_CommissionMember" isHorizontal="true"><dc:Bounds x="70" y="70" width="2350" height="350"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Start_Member" bpmnElement="StartEvent_Member"><dc:Bounds x="105" y="190" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Upload" bpmnElement="Task_Upload"><dc:Bounds x="175" y="160" width="140" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ValidateFacts" bpmnElement="Task_ValidateFacts"><dc:Bounds x="350" y="155" width="190" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_InitialHyp" bpmnElement="Task_InitialHypotheses"><dc:Bounds x="575" y="155" width="190" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_ReviewAI" bpmnElement="Task_ReviewAI"><dc:Bounds x="800" y="155" width="190" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_MergeCheck" bpmnElement="Gateway_MergeCheck" isMarkerVisible="true"><dc:Bounds x="1025" y="180" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_CheckHyp" bpmnElement="Task_CheckHypotheses"><dc:Bounds x="1110" y="160" width="175" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_EnoughData" bpmnElement="Gateway_EnoughData" isMarkerVisible="true"><dc:Bounds x="1320" y="175" width="60" height="60"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_CollectMore" bpmnElement="Task_CollectMore"><dc:Bounds x="1235" y="295" width="230" height="75"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_RCA" bpmnElement="Task_RCA"><dc:Bounds x="1420" y="160" width="145" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Actions" bpmnElement="Task_Actions"><dc:Bounds x="1600" y="160" width="180" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_Report" bpmnElement="Task_Report"><dc:Bounds x="1815" y="160" width="170" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="Shape_End_Member" bpmnElement="EndEvent_Member"><dc:Bounds x="2040" y="190" width="36" height="36"/></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="Edge_1" bpmnElement="Flow_1"><di:waypoint x="141" y="208"/><di:waypoint x="175" y="208"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_2" bpmnElement="Flow_2"><di:waypoint x="315" y="205"/><di:waypoint x="350" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_3" bpmnElement="Flow_3"><di:waypoint x="540" y="205"/><di:waypoint x="575" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_4" bpmnElement="Flow_4"><di:waypoint x="765" y="205"/><di:waypoint x="800" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_5" bpmnElement="Flow_5"><di:waypoint x="990" y="205"/><di:waypoint x="1025" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_6" bpmnElement="Flow_6"><di:waypoint x="1075" y="205"/><di:waypoint x="1110" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_7" bpmnElement="Flow_7"><di:waypoint x="1285" y="205"/><di:waypoint x="1320" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_8" bpmnElement="Flow_8"><di:waypoint x="1350" y="235"/><di:waypoint x="1350" y="295"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_9" bpmnElement="Flow_9"><di:waypoint x="1235" y="332"/><di:waypoint x="1050" y="332"/><di:waypoint x="1050" y="230"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_10" bpmnElement="Flow_10"><di:waypoint x="1380" y="205"/><di:waypoint x="1420" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_11" bpmnElement="Flow_11"><di:waypoint x="1565" y="205"/><di:waypoint x="1600" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_12" bpmnElement="Flow_12"><di:waypoint x="1780" y="205"/><di:waypoint x="1815" y="205"/></bpmndi:BPMNEdge><bpmndi:BPMNEdge id="Edge_13" bpmnElement="Flow_13"><di:waypoint x="1985" y="205"/><di:waypoint x="2040" y="205"/></bpmndi:BPMNEdge>
  </bpmndi:BPMNPlane></bpmndi:BPMNDiagram>
</bpmn:definitions>
