<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Incident_ASIS" targetNamespace="https://sergeygalay.github.io/bpmn-editor/incident-investigation-as-is"><bpmn:collaboration id="Collaboration_Incident_ASIS"><bpmn:participant id="Participant_Company_ASIS" name="Компания" processRef="Process_Incident_ASIS"/><bpmn:participant id="Participant_Med_ASIS" name="Медицинская организация"/><bpmn:participant id="Participant_Gov_ASIS" name="Государственные / надзорные органы"/><bpmn:messageFlow id="Message_ASIS_MedHelp" sourceRef="Task_Report_ASIS" targetRef="Participant_Med_ASIS" name="Медицинская помощь / первичные данные"/><bpmn:messageFlow id="Message_ASIS_315U" sourceRef="Participant_Med_ASIS" targetRef="Task_Classify_ASIS" name="315У / уточнение категории"/><bpmn:messageFlow id="Message_ASIS_NotifyGov" sourceRef="Task_Notify_ASIS" targetRef="Participant_Gov_ASIS" name="Первичное уведомление"/><bpmn:messageFlow id="Message_ASIS_DocsGov" sourceRef="Task_SendDocs_ASIS" targetRef="Participant_Gov_ASIS" name="Комплект документов"/></bpmn:collaboration><bpmn:process id="Process_Incident_ASIS" name="Расследование происшествия — AS IS" isExecutable="false"><bpmn:laneSet id="LaneSet_Incident_ASIS"><bpmn:lane id="Lane_Employee_ASIS" name="Сотрудник / мастер / диспетчер"><bpmn:flowNodeRef>StartEvent_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Report_ASIS</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_PBIOT_ASIS" name="ПБиОТ / расследователь"><bpmn:flowNodeRef>Task_Classify_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_Notify_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Notify_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Gateway_NotifyMerge_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Commission_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Collect_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Approve_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_SendDocs_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Control_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>EndEvent_ASIS</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Commission_ASIS" name="Комиссия / профильные эксперты"><bpmn:flowNodeRef>Task_Investigate_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Docs_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Sign_ASIS</bpmn:flowNodeRef><bpmn:flowNodeRef>Task_Actions_ASIS</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="Lane_Leadership_ASIS" name="Руководство / ответственные за КД"><bpmn:flowNodeRef>Task_Execute_ASIS</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet><bpmn:startEvent id="StartEvent_ASIS" name="Происшествие"/><bpmn:userTask id="Task_Report_ASIS" name="Сообщить мастеру / диспетчеру и организовать первичное реагирование"/><bpmn:userTask id="Task_Classify_ASIS" name="Уточнить факты и классифицировать; при поступлении 315У пересмотреть при необходимости"/><bpmn:exclusiveGateway id="Gateway_Notify_ASIS" name="Нужно уведомить внешние органы?"/><bpmn:sendTask id="Task_Notify_ASIS" name="Уведомить предусмотренные государственные органы"/><bpmn:exclusiveGateway id="Gateway_NotifyMerge_ASIS" name="XOR merge"/><bpmn:userTask id="Task_Commission_ASIS" name="Сформировать комиссию"/><bpmn:manualTask id="Task_Collect_ASIS" name="Собрать первичные материалы на месте"/><bpmn:userTask id="Task_Investigate_ASIS" name="Провести расследование: осмотр, опросы, документы; цикл «сбор — анализ»"/><bpmn:manualTask id="Task_Docs_ASIS" name="Вручную подготовить Форму 5 / Н-1 / внутренний акт"/><bpmn:manualTask id="Task_Sign_ASIS" name="Предварительно согласовать, собрать подписи и комплекты документов"/><bpmn:userTask id="Task_Approve_ASIS" name="Утвердить акт и ознакомить пострадавшего"/><bpmn:sendTask id="Task_SendDocs_ASIS" name="Направить документы в органы / архив"/><bpmn:userTask id="Task_Actions_ASIS" name="Сформировать корректирующие мероприятия"/><bpmn:userTask id="Task_Execute_ASIS" name="Исполнить корректирующие мероприятия"/><bpmn:userTask id="Task_Control_ASIS" name="Контролировать выполнение КД"/><bpmn:endEvent id="EndEvent_ASIS" name="Завершено"/><bpmn:sequenceFlow id="Flow_ASIS_F01" sourceRef="StartEvent_ASIS" targetRef="Task_Report_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F02" sourceRef="Task_Report_ASIS" targetRef="Task_Classify_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F03" sourceRef="Task_Classify_ASIS" targetRef="Gateway_Notify_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F04" sourceRef="Gateway_Notify_ASIS" targetRef="Task_Notify_ASIS" name="Да"/><bpmn:sequenceFlow id="Flow_ASIS_F05" sourceRef="Task_Notify_ASIS" targetRef="Gateway_NotifyMerge_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F06" sourceRef="Gateway_Notify_ASIS" targetRef="Gateway_NotifyMerge_ASIS" name="Нет"/><bpmn:sequenceFlow id="Flow_ASIS_F07" sourceRef="Gateway_NotifyMerge_ASIS" targetRef="Task_Commission_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F08" sourceRef="Task_Commission_ASIS" targetRef="Task_Collect_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F09" sourceRef="Task_Collect_ASIS" targetRef="Task_Investigate_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F10" sourceRef="Task_Investigate_ASIS" targetRef="Task_Docs_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F11" sourceRef="Task_Docs_ASIS" targetRef="Task_Sign_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F12" sourceRef="Task_Sign_ASIS" targetRef="Task_Approve_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F13" sourceRef="Task_Approve_ASIS" targetRef="Task_SendDocs_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F14" sourceRef="Task_SendDocs_ASIS" targetRef="Task_Actions_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F15" sourceRef="Task_Actions_ASIS" targetRef="Task_Execute_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F16" sourceRef="Task_Execute_ASIS" targetRef="Task_Control_ASIS"/><bpmn:sequenceFlow id="Flow_ASIS_F17" sourceRef="Task_Control_ASIS" targetRef="EndEvent_ASIS"/></bpmn:process><bpmndi:BPMNDiagram 