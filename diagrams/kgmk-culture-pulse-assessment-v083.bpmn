<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_pulse083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-culture-pulse-assessment-v083">
<bpmn:collaboration id="Collab_pulse083"><bpmn:participant id="Part_pulse083" name="Оценка культуры сотрудником — пульс площадки 0.8.3" processRef="Proc_pulse083"/></bpmn:collaboration>
<bpmn:process id="Proc_pulse083" name="Оценка культуры сотрудником — пульс площадки 0.8.3" isExecutable="false">
<bpmn:laneSet id="LS"><bpmn:lane id="L_User" name="Сотрудник"><bpmn:flowNodeRef>S</bpmn:flowNodeRef><bpmn:flowNodeRef>Audience</bpmn:flowNodeRef><bpmn:flowNodeRef>Answer</bpmn:flowNodeRef><bpmn:flowNodeRef>AllAnswered</bpmn:flowNodeRef><bpmn:flowNodeRef>FormalMsg</bpmn:flowNodeRef><bpmn:flowNodeRef>Result</bpmn:flowNodeRef><bpmn:flowNodeRef>Retake</bpmn:flowNodeRef></bpmn:lane><bpmn:lane id="L_System" name="Программа «Культура безопасности»"><bpmn:flowNodeRef>Resolve</bpmn:flowNodeRef><bpmn:flowNodeRef>Lock</bpmn:flowNodeRef><bpmn:flowNodeRef>Calc</bpmn:flowNodeRef><bpmn:flowNodeRef>FormalGate</bpmn:flowNodeRef><bpmn:flowNodeRef>Exclude</bpmn:flowNodeRef><bpmn:flowNodeRef>Save</bpmn:flowNodeRef><bpmn:flowNodeRef>E</bpmn:flowNodeRef></bpmn:lane></bpmn:laneSet>
<bpmn:startEvent id="S" name="Открыта оценка культуры"/><bpmn:serviceTask id="Resolve" name="Определить предприятие пользователя"/><bpmn:serviceTask id="Lock" name="Зафиксировать предприятие для анкеты"/><bpmn:userTask id="Audience" name="Выбрать: рабочий / руководитель"/><bpmn:userTask id="Answer" name="Ответить на вопросы анкеты"/><bpmn:exclusiveGateway id="AllAnswered" name="Все вопросы заполнены?"/><bpmn:businessRuleTask id="Calc" name="Рассчитать итоговую оценку"/><bpmn:exclusiveGateway id="FormalGate" name="Все ответы одинаковые?"/><bpmn:serviceTask id="Exclude" name="Сохранить бланк без учёта в пульсе"/><bpmn:userTask id="FormalMsg" name="Показать сообщение о формальном заполнении"/><bpmn:serviceTask id="Save" name="Сохранить результат и учесть в пульсе площадки"/><bpmn:userTask id="Result" name="Показать личную оценку и пульс площадки"/><bpmn:exclusiveGateway id="Retake" name="Пройти ещё раз?"/><bpmn:endEvent id="E" name="Оценка завершена"/>
<bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Resolve"/><bpmn:sequenceFlow id="F2" sourceRef="Resolve" targetRef="Lock"/><bpmn:sequenceFlow id="F3" sourceRef="Lock" targetRef="Audience"/><bpmn:sequenceFlow id="F4" sourceRef="Audience" targetRef="Answer"/><bpmn:sequenceFlow id="F5" sourceRef="Answer" targetRef="AllAnswered"/><bpmn:sequenceFlow id="F6" sourceRef="AllAnswered" targetRef="Answer" name="Нет"/><bpmn:sequenceFlow id="F7" sourceRef="AllAnswered" targetRef="Calc" name="Да"/><bpmn:sequenceFlow id="F8" sourceRef="Calc" targetRef="FormalGate"/><bpmn:sequenceFlow id="F9" sourceRef="FormalGate" targetRef="Exclude" name="Да"/><bpmn:sequenceFlow id="F10" sourceRef="Exclude" targetRef="FormalMsg"/><bpmn:sequenceFlow id="F11" sourceRef="FormalMsg" targetRef="Retake"/><bpmn:sequenceFlow id="F12" sourceRef="FormalGate" targetRef="Save" name="Нет"/><bpmn:sequenceFlow id="F13" sourceRef="Save" targetRef="Result"/><bpmn:sequenceFlow id="F14" sourceRef="Result" targetRef="Retake"/><bpmn:sequenceFlow id="F15" sourceRef="Retake" targetRef="Audience" name="Да"/><bpmn:sequenceFlow id="F16" sourceRef="Retake" targetRef="E" name="Нет"/>
<bpmn:textAnnotation id="Ann"><bpmn:text>Если предприятие пользователя не определено, целевое бизнес-поведение не зафиксировано. В прототипе чужое предприятие для анкеты выбирать нельзя.</bpmn:text></bpmn:textAnnotation><bpmn:association id="Assoc" sourceRef="Lock" targetRef="Ann"/>
</bpmn:process>
<bpmndi:BPMNDiagram id="D"><bpmndi:BPMNPlane id="P" bpmnElement="Collab_pulse083"><bpmndi:BPMNShape id="Part_di" bpmnElement="Part_pulse083" isHorizontal="true"><dc:Bounds x="30" y="40" width="2600" height="360"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LU_di" bpmnElement="L_User" isHorizontal="true"><dc:Bounds x="60" y="40" width="2480" height="180"/></bpmndi:BPMNShape><bpmndi:BPMNShape id="LS_di" bpmnElement="L_System" isHorizontal="true"><dc:Bounds x="60" y="220" width="2480" height="180"/></bpmndi:BPMNShape>
