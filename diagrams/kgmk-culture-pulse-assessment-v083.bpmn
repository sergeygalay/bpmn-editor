<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Defs_kgmk-culture-pulse-assessment-v083" targetNamespace="https://sergeygalay.github.io/bpmn-editor/kgmk-culture-pulse-assessment-v083">
  <bpmn:collaboration id="Collab_kgmk-culture-pulse-assessment-v083">
    <bpmn:participant id="Part_kgmk-culture-pulse-assessment-v083" name="Оценка культуры сотрудником" processRef="Proc_kgmk-culture-pulse-assessment-v083" />
    <bpmn:textAnnotation id="AnnP">
      <bpmn:text>Если предприятие пользователя не определено автоматически, дальнейшее целевое бизнес-поведение в прототипе не задано. В BRD оставлена заглушка.</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="AssocP" sourceRef="BEGate" targetRef="AnnP" />
  </bpmn:collaboration>
  <bpmn:process id="Proc_kgmk-culture-pulse-assessment-v083" name="Оценка культуры сотрудником — пульс БЕ 0.8.3" isExecutable="false">
    <bpmn:laneSet id="LaneSet_kgmk-culture-pulse-assessment-v083">
      <bpmn:lane id="L_User" name="Сотрудник">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Audience</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Answer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FormalMsg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Result</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_System" name="Программа «Культура безопасности»">
        <bpmn:flowNodeRef>Resolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>BEGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Lock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AudienceMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AnswerMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>AllAnswered</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Calc</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>FormalGate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Exclude</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>RetryMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Retake</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>NoBE</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="Сотрудник открыл этап «Оценка»" />
    <bpmn:serviceTask id="Resolve" name="Определить предприятие пользователя" />
    <bpmn:exclusiveGateway id="BEGate" name="Предприятие определено?" />
    <bpmn:serviceTask id="Lock" name="Зафиксировать предприятие для анкеты" />
    <bpmn:exclusiveGateway id="AudienceMerge" />
    <bpmn:userTask id="Audience" name="Выбрать категорию: рабочий / руководитель" />
    <bpmn:exclusiveGateway id="AnswerMerge" name="Продолжить заполнение анкеты" />
    <bpmn:userTask id="Answer" name="Ответить на вопросы анкеты" />
    <bpmn:exclusiveGateway id="AllAnswered" name="Все вопросы заполнены?" />
    <bpmn:businessRuleTask id="Calc" name="Рассчитать итоговую оценку и уровень" />
    <bpmn:exclusiveGateway id="FormalGate" name="Все ответы одинаковые?" />
    <bpmn:serviceTask id="Exclude" name="Сохранить бланк без учёта в пульсе" />
    <bpmn:userTask id="FormalMsg" name="Сообщить о формальном заполнении" />
    <bpmn:serviceTask id="Save" name="Сохранить результат и учесть в пульсе БЕ" />
    <bpmn:userTask id="Result" name="Показать личную оценку, пульс БЕ и официальный замер" />
    <bpmn:exclusiveGateway id="RetryMerge" name="Завершить показ результата" />
    <bpmn:exclusiveGateway id="Retake" name="Пройти оценку ещё раз?" />
    <bpmn:endEvent id="E" name="Оценка завершена" />
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="Resolve" />
    <bpmn:sequenceFlow id="F2" sourceRef="Resolve" targetRef="BEGate" />
    <bpmn:sequenceFlow id="F3" name="Да" sourceRef="BEGate" targetRef="Lock" />
    <bpmn:sequenceFlow id="F4" name="Нет" sourceRef="BEGate" targetRef="NoBE" />
    <bpmn:sequenceFlow id="F5" sourceRef="Lock" targetRef="AudienceMerge" />
    <bpmn:sequenceFlow id="F6" sourceRef="AudienceMerge" targetRef="Audience" />
    <bpmn:sequenceFlow id="F7" sourceRef="Audience" targetRef="AnswerMerge" />
    <bpmn:sequenceFlow id="F8" sourceRef="AnswerMerge" targetRef="Answer" />
    <bpmn:sequenceFlow id="F9" sourceRef="Answer" targetRef="AllAnswered" />
    <bpmn:sequenceFlow id="F10" name="Да" sourceRef="AllAnswered" targetRef="Calc" />
    <bpmn:sequenceFlow id="F11" name="Нет" sourceRef="AllAnswered" targetRef="AnswerMerge" />
    <bpmn:sequenceFlow id="F12" sourceRef="Calc" targetRef="FormalGate" />
    <bpmn:sequenceFlow id="F13" name="Да" sourceRef="FormalGate" targetRef="Exclude" />
    <bpmn:sequenceFlow id="F14" name="Нет" sourceRef="FormalGate" targetRef="Save" />
    <bpmn:sequenceFlow id="F15" sourceRef="Exclude" targetRef="FormalMsg" />
    <bpmn:sequenceFlow id="F16" sourceRef="FormalMsg" targetRef="RetryMerge" />
    <bpmn:sequenceFlow id="F17" sourceRef="Save" targetRef="Result" />
    <bpmn:sequenceFlow id="F18" sourceRef="Result" targetRef="RetryMerge" />
    <bpmn:sequenceFlow id="F19" sourceRef="RetryMerge" targetRef="Retake" />
    <bpmn:sequenceFlow id="F20" name="Да" sourceRef="Retake" targetRef="AudienceMerge" />
    <bpmn:sequenceFlow id="F21" name="Нет" sourceRef="Retake" targetRef="E" />
    <bpmn:endEvent id="NoBE" name="Оценка не начата: предприятие не определено" />
  </bpmn:process>
